src/mikemol/audiostruct/records.py|text-not-required|if not isinstance\(value, str\):|if False:|def=_text

# records.py: words are optional, a malformed one names its position, and a segment is well-formed
# only when it ends no earlier than it starts.
src/mikemol/audiostruct/records.py|unaligned-segment-needs-words|body\.get\("words", \[\]\)|body.get("words", None)|def=_words
src/mikemol/audiostruct/records.py|word-position-unnamed|msg = f"word \{n\}: \{exc\}"|msg = f"{exc}"|def=_words
src/mikemol/audiostruct/records.py|end-before-start-accepted|if end < start:|if False:|def=_segment
src/mikemol/audiostruct/records.py|zero-length-segment-refused|if end < start:|if end <= start:|def=_segment

# records.py: every segment lands in exactly one record, with its position, and the raw JSON sorted.
src/mikemol/audiostruct/records.py|unplaced-raw-unsorted|sort_keys=True|sort_keys=False|def=normalize
src/mikemol/audiostruct/records.py|unplaced-index-off-by-one|Unplaced\(source, index, raw, str\(exc\)\)|Unplaced(source, index + 1, raw, str(exc))|def=normalize

# render.py: no stand-in speaker, truncation to the second, hours only past one, no time for a gap.
