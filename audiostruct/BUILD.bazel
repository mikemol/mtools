# ⚑ MIRRORS //icsstruct:BUILD.bazel AT ITS BIRTH (afdc10f), which mirrors //transcriptstruct. The
# rationale for each shape lives there; this file says only where it differs.
# `@audiostruct_dev` is declared in MODULE.bazel beside this distribution's birth (W262).
load("@audiostruct_dev//:requirements.bzl", dev_all_requirements = "all_requirements", dev_requirement = "requirement")
load("@audiostruct_gpu//:requirements.bzl", gpu_all_requirements = "all_requirements")
load("@mikemol_rules_py//:dist.bzl", "dist_checks")
load("@mikemol_rules_py//:venv.bzl", "venv_from_hub")
load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

exports_files([
    # ⚑ EXPORTED FOR `//hooks:test_bar_fires`, which globs `*/pyproject.toml` for the population.
    "pyproject.toml",
    "requirements.txt",
    "requirements-dev.txt",
    "uv.lock",
])

py_library(
    name = "audiostruct",
    srcs = glob(["src/mikemol/audiostruct/**/*.py"]),
    data = glob(["src/mikemol/audiostruct/py.typed"], allow_empty = True),
    imports = ["src"],
    visibility = ["//visibility:public"],
)

# ⚑⚑⚑ ONE TARGET PER TEST MODULE, AND EACH IS A WITNESS.
# ⚑ DIFFERS FROM icsstruct: NO FIXTURE FILES. Every WhisperX-shaped input is synthetic and inline
# in its test, so no audio and no transcript is ever declared data.
[
    py_test(
        name = src.removeprefix("tests/").removesuffix(".py"),
        srcs = [src, "@mikemol_rules_py//:pytest_main.py"] + glob(["tests/conftest.py"], allow_empty = True),
        main = "@mikemol_rules_py//:pytest_main.py",
        args = [
            "$(location " + src + ")",
            "-q",
            "--strict-markers",
            "--strict-config",
            "-o",
            "faulthandler_timeout=60",
            "-c",
            "$(location pyproject.toml)",
        ],
        data = ["pyproject.toml"],
        size = "small",
        deps = [
            ":audiostruct",
            dev_requirement("pytest"),
        ],
        imports = ["src"],
    )
    for src in glob(
        ["tests/test_*.py"],
        exclude = [
            "tests/test_main.py",
            "tests/test_stub_authority.py",
            "tests/test_whisperx_site.py",
        ],
    )
]

# ⚑⚑ THE ONE TEST THAT STAGES THE GPU HUB (W274). stubtest imports whisperx's submodules, which
# import torch, so this target alone depends on `@audiostruct_gpu` (about 8G, operator-approved
# under luthen's reaper, 2026-09-28). Every other target stays light. A missing whisperx is a red,
# never a skip.
py_test(
    name = "test_stub_authority",
    srcs = ["tests/test_stub_authority.py", "@mikemol_rules_py//:pytest_main.py"],
    main = "@mikemol_rules_py//:pytest_main.py",
    args = [
        "$(location tests/test_stub_authority.py)",
        "-q",
        "--strict-markers",
        "--strict-config",
        "-o",
        "faulthandler_timeout=60",
        "-c",
        "$(location pyproject.toml)",
    ],
    data = ["pyproject.toml"] + glob(["stubs/**"]),
    size = "medium",
    deps = [
        "@audiostruct_gpu//whisperx",
        dev_requirement("mypy"),
        dev_requirement("pytest"),
    ],
)

# ⚑ The entry point's witness (W286) imports main, which imports whisperx_site: the gpu hub too.
py_test(
    name = "test_main",
    srcs = ["tests/test_main.py", "@mikemol_rules_py//:pytest_main.py"],
    main = "@mikemol_rules_py//:pytest_main.py",
    args = [
        "$(location tests/test_main.py)",
        "-q",
        "--strict-markers",
        "--strict-config",
        "-o",
        "faulthandler_timeout=120",
        "-c",
        "$(location pyproject.toml)",
    ],
    data = ["pyproject.toml"],
    size = "medium",
    deps = [
        ":audiostruct",
        "@audiostruct_gpu//whisperx",
        dev_requirement("pytest"),
    ],
    imports = ["src"],
)

# ⚑ The one import site's witness (W284) imports whisperx and torch, so it too takes the gpu hub.
py_test(
    name = "test_whisperx_site",
    srcs = ["tests/test_whisperx_site.py", "@mikemol_rules_py//:pytest_main.py"],
    main = "@mikemol_rules_py//:pytest_main.py",
    args = [
        "$(location tests/test_whisperx_site.py)",
        "-q",
        "--strict-markers",
        "--strict-config",
        "-o",
        "faulthandler_timeout=120",
        "-c",
        "$(location pyproject.toml)",
    ],
    data = ["pyproject.toml"],
    size = "medium",
    deps = [
        ":audiostruct",
        "@audiostruct_gpu//whisperx",
        dev_requirement("pytest"),
    ],
    imports = ["src"],
)

exports_files(["BUILD.bazel"])

sh_test(
    name = "ruff",
    srcs = ["@mikemol_check_ruff//:ruff_check.sh"],
    args = [
        "$(location @mikemol_check_ruff//:bin)",
        "$(location :pyproject.toml)",
    ] + ["$(location " + f + ")" for f in glob(["src/**/*.py", "tests/**/*.py"])],
    data = [
        "pyproject.toml",
        "@mikemol_check_ruff//:bin",
    ] + glob(["src/**/*.py", "tests/**/*.py"]),
    size = "small",
)

# ⚑ THE BASELINE WAS MINTED EMPTY: the distribution enters clean under preview, so the ratchet
# can only hold it there.
sh_test(
    name = "ratchet",
    srcs = ["@mikemol_check_ratchet//:ratchet_check.sh"],
    args = [
        "$(location //ratchet:ratchet_cli)",
        "$(location @mikemol_check_ruff//:bin)",
        "$(location :pyproject.toml)",
    ],
    data = [
        "pyproject.toml",
        "ratchet-preview.txt",
        "//ratchet:ratchet_cli",
        "@mikemol_check_ruff//:bin",
    ] + glob(["src/**/*.py", "tests/**/*.py"]),
    size = "small",
)

sh_test(
    name = "mutants",
    srcs = ["@mikemol_check_mutants//:mutate_check.sh"],
    args = [
        "$(location :pyproject.toml)",
        "$(location @mikemol_check_mutants//:mutate_runner.py)",
    ],
    data = [
        "pyproject.toml",
        ":.venv",
        "@mikemol_check_mutants//:mutate_runner.py",
    ] + glob(["src/**/*.py", "tests/**/*.py"]),
    size = "medium",
)

py_binary(
    name = "mypy_runner",
    srcs = ["@mikemol_check_mypy//:mypy_runner.py"],
    main = "@mikemol_check_mypy//:mypy_runner.py",
    deps = [
        dev_requirement("mypy"),
        dev_requirement("pytest"),
    ],
)

sh_test(
    name = "mypy",
    srcs = ["@mikemol_check_mypy//:mypy_check.sh"],
    args = [
        "$(location :mypy_runner)",
        "$(location :pyproject.toml)",
    ],
    data = [
        "pyproject.toml",
        ":mypy_runner",
    ] + glob(["src/**/*.py", "tests/**/*.py", "stubs/**"], allow_empty = True),
    size = "small",
    # ⚑ A GENEROUS TIMEOUT, NOT A TIGHT ONE (operator, 2026-09-24: "I hate wallclock-sensitive
    # things"). See //transcriptstruct:mypy for the measurement.
    timeout = "long",
)

# ⚑ NO console_scripts YET: stage 1 has no CLI. `mikemol-audio` arrives with W265.
venv_from_hub(
    name = ".venv",
    # ⚑ THE SAME ENTRY AS pyproject's [project.scripts], as //icsstruct:.venv mirrors its own.
    console_scripts = {
        "mikemol-audio": "mikemol.audiostruct.main:main",
    },
    # ⚑⚑ DEV PLUS GPU (W284, operator 2026-09-29): src/.../whisperx_site.py is the one module that
    # imports whisperx, and the mutation grid mutates every src module in THIS venv, so the venv must
    # import it or that site reads ERRORED and the grid refuses. The dev entries come first, and
    # venv_from_hub keeps the first file per site-packages path. The three packages in both hubs
    # are identical versions (packaging 26.3, pygments 2.21.0, typing-extensions 4.16.0, measured
    # 2026-09-29). About 8G, on the nvme since luthen:W236.
    hub_requirements = dev_all_requirements + gpu_all_requirements,
    python_version = "3.13.13",
    python_version_short = "3.13",
    srcs = glob(["src/mikemol/audiostruct/**"]),
)

# W376: this distribution's :venv (W342) and :suite (W362), declared together.
dist_checks()

