@misc{audiostruct-records-unplaced-raw-is-the-segment-verbatim,
  section = {records},
  title  = {`raw` is the segment's JSON with keys sorted, so it parses back to exactly the input},
  claim  = {`raw` is the segment's JSON with keys sorted, so it parses back to exactly the input.},
  check  = {cmd:.venv/bin/python3 -m pytest tests/test_records.py -k test_unplaced_raw_is_the_segment_verbatim},
