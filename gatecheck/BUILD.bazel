# ⚑ MIRRORS //pkgbuild:BUILD.bazel TARGET FOR TARGET (itself a mirror of //corpus and //icsstruct);
# the rationale for each shape lives there, this file says only where it differs. `@gatecheck_dev`
# is declared in MODULE.bazel beside this distribution's birth (mtools:W544, paperkit:W142).
load("@mikemol_rules_py//:dist.bzl", "dist_checks")
load("@mikemol_rules_py//:venv.bzl", "venv_from_hub")
load("@gatecheck_dev//:requirements.bzl", dev_all_requirements = "all_requirements", dev_requirement = "requirement")
load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

exports_files([
    # ⚑ EXPORTED FOR `//hooks:test_bar_fires`, which globs `*/pyproject.toml` for the population.
    "pyproject.toml",
    "requirements.txt",
    "requirements-dev.txt",
    "uv.lock",
])

# ⚑ THE SIBLING EDGE (mtools:W562, ruled A+B 2026-10-04): the shipping hub stays empty, because a pip hub
# cannot resolve a path source. `mikemol-importdag` (which itself depends on `mikemol-atomicwrite`) is
# declared in pyproject.toml for uv and carried here as a Bazel dependency on the sibling's py_library;
# `witness_reach` imports `dagnames` in a fresh child interpreter. Kept in step with pyproject by hand.
py_library(
    name = "gatecheck",
    srcs = glob(["src/mikemol/gatecheck/**/*.py"]),
    data = glob(["src/mikemol/gatecheck/py.typed"], allow_empty = True),
    imports = ["src"],
    visibility = ["//visibility:public"],
    deps = ["//importdag:importdag"],
)

# ⚑⚑⚑ ONE TARGET PER TEST MODULE, AND EACH IS A WITNESS. DIFFERS FROM //pkgbuild: no test needs
# setuptools, so the dev dependencies are the three siblings' alone.
[
    py_test(
        name = src.removeprefix("tests/").removesuffix(".py"),
        srcs = [src, "@mikemol_rules_py//:pytest_main.py"] + glob(["tests/conftest.py"], allow_empty = True),
        main = "@mikemol_rules_py//:pytest_main.py",
        args = [
            "$(location " + src + ")",
            "-q",
            "--strict-markers",
            "--strict-config",
            "-o",
            "faulthandler_timeout=60",
            "-c",
            "$(location pyproject.toml)",
        ],
        data = ["pyproject.toml"],
        size = "small",
        deps = [
            ":gatecheck",
            "//importdag:importdag",
            dev_requirement("pytest"),
            dev_requirement("mypy"),
        ],
        imports = ["src"],
        # ⚑ Three source roots on sys.path (this dist, importdag, atomicwrite): legacy implicit
        # `__init__.py` creation would shadow the `mikemol` namespace (W566).
        legacy_create_init = 0,
    )
    for src in glob(["tests/test_*.py"])
]

exports_files(["BUILD.bazel"])

sh_test(
    name = "ruff",
    srcs = ["@mikemol_check_ruff//:ruff_check.sh"],
    args = [
        "$(location @mikemol_check_ruff//:bin)",
        "$(location :pyproject.toml)",
    ] + ["$(location " + f + ")" for f in glob(["src/**/*.py", "tests/**/*.py"])],
    data = [
        "pyproject.toml",
        "@mikemol_check_ruff//:bin",
    ] + glob(["src/**/*.py", "tests/**/*.py"]),
    size = "small",
)

# ⚑ THE BASELINE IS MINTED EMPTY: the distribution enters clean under preview, so the ratchet
# can only hold it there.
sh_test(
    name = "ratchet",
    srcs = ["@mikemol_check_ratchet//:ratchet_check.sh"],
    args = [
        "$(location //ratchet:ratchet_cli)",
        "$(location @mikemol_check_ruff//:bin)",
        "$(location :pyproject.toml)",
    ],
    data = [
        "pyproject.toml",
        "ratchet-preview.txt",
        "//ratchet:ratchet_cli",
        "@mikemol_check_ruff//:bin",
    ] + glob(["src/**/*.py", "tests/**/*.py"]),
    size = "small",
)

sh_test(
    name = "mutants",
    srcs = ["@mikemol_check_mutants//:mutate_check.sh"],
    args = [
        "$(location :pyproject.toml)",
        "$(location @mikemol_check_mutants//:mutate_runner.py)",
    ],
    data = [
        "pyproject.toml",
        ":.venv",
        "//fence:fence",
        "//mutation:mutation",
        "@mikemol_check_mutants//:mutate_runner.py",
    ] + glob(["src/**/*.py", "tests/**/*.py"]),
    size = "medium",
)

# ⚑ ONE py_binary PER SCRIPT ROLE, so a paperkit action or hook runs each as a DECLARED tool by
# label (rules_python resolves by layout, with no sys.path and no script directory beside the
# module). `rungate` is `-m` only and `indexdiverge` is library-only, so neither has one.
py_binary(
    name = "hook_index",
    srcs = ["src/mikemol/gatecheck/hook_index.py"],
    main = "src/mikemol/gatecheck/hook_index.py",
    imports = ["src"],
    visibility = ["//visibility:public"],
    deps = [":gatecheck"],
)

py_binary(
    name = "hook_grid",
    srcs = ["src/mikemol/gatecheck/hook_grid.py"],
    main = "src/mikemol/gatecheck/hook_grid.py",
    imports = ["src"],
    visibility = ["//visibility:public"],
    deps = [":gatecheck"],
)

py_binary(
    name = "absence_audit",
    srcs = ["src/mikemol/gatecheck/absence_audit.py"],
    main = "src/mikemol/gatecheck/absence_audit.py",
    imports = ["src"],
    visibility = ["//visibility:public"],
    deps = [":gatecheck"],
)

py_binary(
    name = "lint_bzl",
    srcs = ["src/mikemol/gatecheck/lint_bzl.py"],
    main = "src/mikemol/gatecheck/lint_bzl.py",
    imports = ["src"],
    visibility = ["//visibility:public"],
    deps = [":gatecheck"],
)

# ⚑ THE SIBLING IS IN `deps` because this script imports `mikemol.importdag.dagnames`; the shared
# `:gatecheck` library already carries that edge. `legacy_create_init = 0` keeps the `mikemol`
# namespace from being shadowed by an implicit `__init__.py` across the three source roots (W566).
py_binary(
    name = "witness_reach",
    srcs = ["src/mikemol/gatecheck/witness_reach.py"],
    main = "src/mikemol/gatecheck/witness_reach.py",
    imports = ["src"],
    legacy_create_init = 0,
    visibility = ["//visibility:public"],
    deps = [
        ":gatecheck",
        "//importdag:importdag",
    ],
)

py_binary(
    name = "mypy_runner",
    srcs = ["@mikemol_check_mypy//:mypy_runner.py"],
    main = "@mikemol_check_mypy//:mypy_runner.py",
    deps = [
        # ⚑ How mypy sees the sibling inside the sandbox (the runner cannot see pip-installed siblings).
        "//importdag:importdag",
        dev_requirement("mypy"),
        dev_requirement("pytest"),
    ],
)

sh_test(
    name = "mypy",
    srcs = ["@mikemol_check_mypy//:mypy_check.sh"],
    args = [
        "$(location :mypy_runner)",
        "$(location :pyproject.toml)",
    ],
    data = [
        "pyproject.toml",
        ":mypy_runner",
    ] + glob(["src/**/*.py", "tests/**/*.py"], allow_empty = True),
    size = "small",
    # ⚑ A GENEROUS TIMEOUT, NOT A TIGHT ONE (operator, 2026-09-24: "I hate wallclock-sensitive
    # things"). See //transcriptstruct:mypy for the measurement.
    timeout = "long",
)

venv_from_hub(
    name = ".venv",
    # ⚑ THE SAME ENTRIES AS pyproject's [project.scripts].
    console_scripts = {
        "mikemol-hook-index": "mikemol.gatecheck.hook_index:cli",
        "mikemol-hook-grid": "mikemol.gatecheck.hook_grid:main",
        "mikemol-absence-audit": "mikemol.gatecheck.absence_audit:main",
        "mikemol-lint-bzl": "mikemol.gatecheck.lint_bzl:main",
        "mikemol-witness-reach": "mikemol.gatecheck.witness_reach:main",
    },
    hub_requirements = dev_all_requirements,
    python_version = "3.13.13",
    python_version_short = "3.13",
    # ⚑ A TRANSITIVE SIBLING MUST BE LISTED TOO (measured, W571): `srcs` takes the named target's own
    # files only, not its py_library deps, so importdag's own sibling (atomicwrite) is named here as well;
    # without it `:venv` and `:mutants` fail with `No module named 'mikemol.atomicwrite'`.
    srcs = glob(["src/mikemol/gatecheck/**"]) + ["//importdag:importdag", "//atomicwrite:atomicwrite"],
)

# W376: this distribution's :venv (W342) and :suite (W362), declared together.
dist_checks()
