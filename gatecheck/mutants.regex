#
# The defect classes this distribution DECLARES (mtools:W629, W670), planted one at a time by the
# `:mutants` runner: <module>|<name>|<pattern>|<replacement>|<scope>. A line that stops matching is a
# STALE declaration and fails the grid as UNAPPLIED. Each is a claim rungate.py's docstrings make
# about running a gate under the repo's OWN budget, and none moves a def.

# THE FLAGS ARE LOAD-BEARING: the command is the one the pre-commit hook runs. Without the budget 23
# sandboxes landed on a 15GB box and produced nothing in 60 minutes.
src/mikemol/gatecheck/rungate.py|budget-flag-not-passed|f"--local_resources=memory=\{ram\}"|"--local_resources=memory=0"|def=argv_for

src/mikemol/gatecheck/rungate.py|mutant-config-dropped|"--config=mutant",|"--config=default",|def=argv_for

src/mikemol/gatecheck/rungate.py|target-not-passed|        args\.target,|        "//:hook",|def=argv_for

# --keep-going keeps building after a failure; the default stops at the first.
src/mikemol/gatecheck/rungate.py|keep-going-inverted|"--keep_going" if args\.keep_going else "--notest_keep_going"|"--notest_keep_going" if args.keep_going else "--keep_going"|def=argv_for

# --dry-run prints the command line and exits WITHOUT running it, with 0.
src/mikemol/gatecheck/rungate.py|dry-run-runs-the-gate|if args\.dry_run:|if False:|def=main

src/mikemol/gatecheck/rungate.py|dry-run-exits-nonzero|return 0|return 1|def=main

# The gate's own exit code is the verdict, passed through.
src/mikemol/gatecheck/rungate.py|gate-exit-code-swallowed|return run\(cmd, where\)\.returncode|return 0|def=main

# The repo root is the current directory unless one is given.
src/mikemol/gatecheck/rungate.py|root-not-the-current-directory|Path\.cwd\(\) if root is None else root|Path("/") if root is None else root|def=main

# The owner of the RAM bound is `tools/sweep_budget.py`, asked from the repo root; a failure to ask is
# an error and the answer is its stripped stdout.
src/mikemol/gatecheck/rungate.py|sweep-budget-path-renamed|Path\("tools"\) / "sweep_budget\.py"|Path("tools") / "budget.py"|

src/mikemol/gatecheck/rungate.py|budget-asked-from-the-wrong-directory|\], root\)|], Path("."))|def=budget

src/mikemol/gatecheck/rungate.py|budget-failure-ignored|proc\.check_returncode\(\)|pass|def=budget

src/mikemol/gatecheck/rungate.py|budget-not-stripped|proc\.stdout\.strip\(\)|proc.stdout|def=budget

# `capture_output` collects TEXT and its status is read by the caller, never raised here.
src/mikemol/gatecheck/rungate.py|capture-returns-bytes|capture_output=True, text=True, check=False|capture_output=True, text=False, check=False|def=capture_output

src/mikemol/gatecheck/rungate.py|capture-raises-on-failure|capture_output=True, text=True, check=False|capture_output=True, text=True, check=True|def=capture_output

# `run_passthrough` leaves the terminal's own stdout and stderr, so the gate's output is not captured.
src/mikemol/gatecheck/rungate.py|passthrough-captures-output|subprocess\.run\(cmd, cwd=cwd, check=False, text=True\)|subprocess.run(cmd, cwd=cwd, check=False, text=True, capture_output=True)|def=run_passthrough
