#
# The defect classes this distribution DECLARES (mtools:W629), planted one at a time by the
# `:mutants` runner: <module>|<name>|<pattern>|<replacement>|<scope>. A line that stops
# matching is a STALE declaration and fails the grid as UNAPPLIED.

# W949: the tree tolerates what real pages get wrong. A void element given children swallows the
# text after a `<br>`; a stray end tag that closes the open element loses what follows; closing only
# the matched element leaves the ones opened inside it dangling; a BOM kept as content corrupts
# the first text node.
src/mikemol/htmlstruct/tree.py|void-element-opened|if tag in VOID:|if False:|def=_Builder.handle_starttag
src/mikemol/htmlstruct/tree.py|stray-end-tag-closes-the-open-element|if self\.stack\[i\]\.tag == tag\), 0\)|if self.stack[i].tag == tag), 1)|def=_Builder.handle_endtag
src/mikemol/htmlstruct/tree.py|inner-elements-left-open|while depth and len\(self\.stack\) > depth:|if depth:|def=_Builder.handle_endtag
src/mikemol/htmlstruct/tree.py|bom-kept|utf-8-sig|utf-8|def=parse

# W950-W953: the readers. Script/style text counted as visible, whitespace left uncollapsed and an absent
# id read as an empty string each mislead a caller; a heading test by prefix lists header and hr; an
# href-less anchor listed; a nested table folded into its parent; th cells unmarked; meta keys left
# in their written case or contentless entries kept.
src/mikemol/htmlstruct/text.py|script-text-visible|elif child\.tag not in SKIPPED:|elif True:|def=_strings
src/mikemol/htmlstruct/text.py|whitespace-not-collapsed|return " "\.join\(""\.join\(_strings\(node\)\)\.split\(\)\)|return "".join(_strings(node))|def=text_of
src/mikemol/htmlstruct/text.py|absent-id-is-empty|Miss\(ident\) if found is None|"" if found is None|def=by_id
src/mikemol/htmlstruct/outline.py|heading-by-prefix|if e\.tag in _LEVELS|if e.tag.startswith("h")|def=outline
src/mikemol/htmlstruct/links.py|hrefless-anchor-listed|\(href := e\.attr\("href"\)\) is not None|(href := e.attr("href") or "") is not None|def=links
src/mikemol/htmlstruct/tables.py|nested-table-folded-in|child\.tag != "table"|True|def=_rows
src/mikemol/htmlstruct/tables.py|header-cells-unmarked|c\.tag == "th"|False|def=_row
src/mikemol/htmlstruct/meta.py|key-case-kept|v\.lower\(\)|v|def=_key
src/mikemol/htmlstruct/meta.py|contentless-entry-kept|\(content := e\.attr\("content"\)\) is not None|(content := e.attr("content") or "") is not None|def=meta

# W907: the archive reader. Reading a non-multipart file as an archive, ignoring the boundary delimiters, leaving
# a transfer encoding undone, keeping the preamble as a part or matching a location loosely each hand a caller
# the wrong bytes.
src/mikemol/htmlstruct/mhtml.py|any-file-is-an-archive|!= _ROOT_TYPE:|== "":|def=read
src/mikemol/htmlstruct/mhtml.py|base64-left-encoded|if kind == "base64":|if False:|def=_decoded
src/mikemol/htmlstruct/mhtml.py|quoted-printable-left-encoded|if kind == "quoted-printable":|if False:|def=_decoded
src/mikemol/htmlstruct/mhtml.py|preamble-kept-as-a-part|None = None|None = []|def=_bodies
src/mikemol/htmlstruct/mhtml.py|location-matched-loosely|p\.location == location|p.location is not None and location in p.location|def=part_at
src/mikemol/htmlstruct/mhtml.py|root-charset-ignored|root\.charset or "utf-8"|"utf-8"|def=root_tree

# W908: the command. A miss, a skip or a usage error that exits 0 (or prints an empty answer) tells a caller
# "no headings" when the truth is "could not read it"; a part written as text corrupts its bytes.
src/mikemol/htmlstruct/cli.py|miss-exits-zero|return EXIT_MISS|return EXIT_OK|def=_html_verb
src/mikemol/htmlstruct/cli.py|unknown-verb-admitted|args\[0\] not in _OPERANDS|False|def=_well_formed
src/mikemol/htmlstruct/cli.py|operand-count-ignored|return len\(args\) - _FIXED_ARGS == _OPERANDS\[args\[0\]\]|return True|def=_well_formed
src/mikemol/htmlstruct/cli.py|skip-exits-zero|return EXIT_SKIP|return EXIT_OK|def=_skip
src/mikemol/htmlstruct/cli.py|missing-file-admitted|if not path\.is_file\(\):|if False:|def=main
src/mikemol/htmlstruct/cli.py|archive-suffix-ignored|path\.suffix\.lower\(\) not in _ARCHIVE_SUFFIXES|True|def=_document
