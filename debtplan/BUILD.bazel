# ⚑ MIRRORS //importdag:BUILD.bazel TARGET FOR TARGET (itself //pkgbuild, //corpus and //icsstruct); the
# rationale for each shape lives there, this file says only where it differs. A LIBRARY IN ITS FIRST
# UNIT: no py_binary until the command line ports with the queue writer (mtools:W790). `@debtplan_dev`
# and `@debtplan_deps` are declared in MODULE.bazel beside this distribution's birth.
load("@mikemol_rules_py//:dist.bzl", "dist_checks")
load("@mikemol_rules_py//:venv.bzl", "venv_from_hub")
load("@debtplan_dev//:requirements.bzl", dev_all_requirements = "all_requirements", dev_requirement = "requirement")
load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

exports_files([
    # ⚑ EXPORTED FOR `//hooks:test_bar_fires`, which globs `*/pyproject.toml` for the population.
    "pyproject.toml",
    "requirements.txt",
    "requirements-dev.txt",
    "uv.lock",
])

# ⚑ THE SIBLING EDGES (mtools:W562): the shipping hub stays empty, because a pip hub cannot resolve a
# path source. The dependency on `mikemol-importdag` is declared in pyproject.toml for uv and carried
# here as a Bazel dependency on the sibling's py_library, and so is importdag's own edge to
# `mikemol-atomicwrite`. They must be kept in step by hand.
py_library(
    name = "debtplan",
    srcs = glob(["src/mikemol/debtplan/**/*.py"]),
    data = glob(["src/mikemol/debtplan/py.typed"], allow_empty = True),
    imports = ["src"],
    visibility = ["//visibility:public"],
    deps = [
        "//atomicwrite:atomicwrite",
        "//importdag:importdag",
    ],
)

# ⚑⚑⚑ ONE TARGET PER TEST MODULE, AND EACH IS A WITNESS.
[
    py_test(
        name = src.removeprefix("tests/").removesuffix(".py"),
        srcs = [src, "@mikemol_rules_py//:pytest_main.py"] + glob(["tests/conftest.py"], allow_empty = True),
        main = "@mikemol_rules_py//:pytest_main.py",
        args = [
            "$(location " + src + ")",
            "-q",
            "--strict-markers",
            "--strict-config",
            "-o",
            "faulthandler_timeout=60",
            "-c",
            "$(location pyproject.toml)",
        ],
        data = ["pyproject.toml"],
        size = "small",
        deps = [
            ":debtplan",
            "//atomicwrite:atomicwrite",
            "//importdag:importdag",
            dev_requirement("pytest"),
            dev_requirement("mypy"),
        ],
        imports = ["src"],
        # ⚑ With three source roots on sys.path (this dist and its two siblings), legacy implicit
        # `__init__.py` creation would turn `mikemol` into a regular package from the first root and
        # shadow the namespace: every test would fail with `No module named 'mikemol.debtplan'` (W566).
        legacy_create_init = 0,
    )
    for src in glob(["tests/test_*.py"])
]

exports_files(["BUILD.bazel"])

sh_test(
    name = "ruff",
    srcs = ["@mikemol_check_ruff//:ruff_check.sh"],
    args = [
        "$(location @mikemol_check_ruff//:bin)",
        "$(location :pyproject.toml)",
    ] + ["$(location " + f + ")" for f in glob(["src/**/*.py", "tests/**/*.py"])],
    data = [
        "pyproject.toml",
        "@mikemol_check_ruff//:bin",
    ] + glob(["src/**/*.py", "tests/**/*.py"]),
    size = "small",
)

# ⚑ THE BASELINE IS MINTED EMPTY: the distribution enters clean under preview, so the ratchet
# can only hold it there.
sh_test(
    name = "ratchet",
    srcs = ["@mikemol_check_ratchet//:ratchet_check.sh"],
    args = [
        "$(location //ratchet:ratchet_cli)",
        "$(location @mikemol_check_ruff//:bin)",
        "$(location :pyproject.toml)",
    ],
    data = [
        "pyproject.toml",
        "ratchet-preview.txt",
        "//ratchet:ratchet_cli",
        "@mikemol_check_ruff//:bin",
    ] + glob(["src/**/*.py", "tests/**/*.py"]),
    size = "small",
)

# ⚑ THE MUTATION GATE: every def-site body is mutated and the gate refuses if any survives, so
# every function here is executed by a test whose assertion reads its result.
sh_test(
    name = "mutants",
    srcs = ["@mikemol_check_mutants//:mutate_check.sh"],
    args = [
        "$(location :pyproject.toml)",
        "$(location @mikemol_check_mutants//:mutate_runner.py)",
    ],
    data = [
        "pyproject.toml",
        ":.venv",
        "//fence:fence",
        "//mutation:mutation",
        "@mikemol_check_mutants//:mutate_runner.py",
    ] + glob(["src/**/*.py", "tests/**/*.py"]),
    size = "medium",
)

py_binary(
    name = "mypy_runner",
    srcs = ["@mikemol_check_mypy//:mypy_runner.py"],
    main = "@mikemol_check_mypy//:mypy_runner.py",
    deps = [
        # ⚑ How mypy sees the siblings inside the sandbox (the runner cannot see pip-installed siblings).
        "//atomicwrite:atomicwrite",
        "//importdag:importdag",
        dev_requirement("mypy"),
        dev_requirement("pytest"),
    ],
)

sh_test(
    name = "mypy",
    srcs = ["@mikemol_check_mypy//:mypy_check.sh"],
    args = [
        "$(location :mypy_runner)",
        "$(location :pyproject.toml)",
    ],
    data = [
        "pyproject.toml",
        ":mypy_runner",
    ] + glob(["src/**/*.py", "tests/**/*.py"], allow_empty = True),
    size = "small",
    # ⚑ A GENEROUS TIMEOUT, NOT A TIGHT ONE (operator, 2026-09-24: "I hate wallclock-sensitive
    # things"). See //transcriptstruct:mypy for the measurement.
    timeout = "long",
)

venv_from_hub(
    name = ".venv",
    # ⚑ NO CONSOLE SCRIPTS in the first unit: the command line ports with the queue writer.
    console_scripts = {},
    hub_requirements = dev_all_requirements,
    python_version = "3.13.13",
    python_version_short = "3.13",
    srcs = glob(["src/mikemol/debtplan/**"]) + [
        "//atomicwrite:atomicwrite",
        "//importdag:importdag",
    ],
)

# W376: this distribution's :venv (W342) and :suite (W362), declared together.
dist_checks()
