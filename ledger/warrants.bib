% warrants.bib — one claim PER TEST CASE in the ledger suite.
%
% The claim text is TRANSCRIBED from each test function's own docstring, whose flagged
% paragraphs already argue the defect the case prevents.  Where a docstring is a bare
% one-liner the claim is correspondingly plain; that thinness is a fact about the case
% rather than something invented over.
%
% Keying convention: ledger-<section>-<test name minus its `test_` prefix, hyphenated,
% with leading articles dropped>.  Each check runs that one test function.


@misc{ledger-finding-kinds-package-exposes-no-root,
  section = {finding_kinds},
  title  = {There is no module-level root: THE LETTER'S §3.1},
  claim  = {There is no module-level root: THE LETTER'S §3.1.},
  check  = {cmd:.venv/bin/python3 -m pytest tests/test_finding_kinds.py -k test_the_package_exposes_no_root},
}

