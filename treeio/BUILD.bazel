# ⚑ MIRRORS //pkgbuild:BUILD.bazel (itself //corpus and //icsstruct TARGET FOR TARGET) AND
# //mdstruct:BUILD.bazel FOR THE ONE SHIPPING DEPENDENCY (pygit2); the rationale for each shape
# lives there, this file says only where it differs. `@treeio_deps` and `@treeio_dev` are the two
# hubs MODULE.bazel must declare beside this distribution's birth (mtools:W550); they are NOT
# declared by this change, which leaves MODULE.bazel to the integrator.
load("@mikemol_rules_py//:dist.bzl", "dist_checks")
load("@mikemol_rules_py//:venv.bzl", "venv_from_hub")
load("@treeio_deps//:requirements.bzl", "requirement")
load("@treeio_dev//:requirements.bzl", dev_all_requirements = "all_requirements", dev_requirement = "requirement")
load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

exports_files([
    # ⚑ EXPORTED FOR `//hooks:test_bar_fires`, which globs `*/pyproject.toml` for the population.
    "pyproject.toml",
    "requirements.txt",
    "requirements-dev.txt",
    "uv.lock",
])

# ⚑ ONE SHIPPING DEPENDENCY, pygit2: `read` and `listing` open a repository to read a path at a
# revision. Everything else is the standard library, and the snapshot half runs the `git` binary,
# which the tests also need on PATH (the sandbox or executor image must carry it).
py_library(
    name = "treeio",
    srcs = glob(["src/mikemol/treeio/**/*.py"]),
    data = glob(["src/mikemol/treeio/py.typed"], allow_empty = True),
    imports = ["src"],
    deps = [
        requirement("pygit2"),
    ],
    visibility = ["//visibility:public"],
)

# ⚑⚑⚑ ONE TARGET PER TEST MODULE, AND EACH IS A WITNESS.
[
    py_test(
        name = src.removeprefix("tests/").removesuffix(".py"),
        srcs = [src, "@mikemol_rules_py//:pytest_main.py"] + glob(["tests/conftest.py"], allow_empty = True),
        main = "@mikemol_rules_py//:pytest_main.py",
        args = [
            "$(location " + src + ")",
            "-q",
            "--strict-markers",
            "--strict-config",
            "-o",
            "faulthandler_timeout=60",
            "-c",
            "$(location pyproject.toml)",
        ],
        data = ["pyproject.toml"],
        size = "small",
        deps = [
            ":treeio",
            dev_requirement("pytest"),
            dev_requirement("mypy"),
        ],
        imports = ["src"],
    )
    for src in glob(["tests/test_*.py"])
]

exports_files(["BUILD.bazel"])

sh_test(
    name = "ruff",
    srcs = ["@mikemol_check_ruff//:ruff_check.sh"],
    args = [
        "$(location @mikemol_check_ruff//:bin)",
        "$(location :pyproject.toml)",
    ] + ["$(location " + f + ")" for f in glob(["src/**/*.py", "tests/**/*.py"])],
    data = [
        "pyproject.toml",
        "@mikemol_check_ruff//:bin",
    ] + glob(["src/**/*.py", "tests/**/*.py"]),
    size = "small",
)

# ⚑ THE BASELINE IS MINTED EMPTY: the distribution enters clean under preview, so the ratchet
# can only hold it there.
sh_test(
    name = "ratchet",
    srcs = ["@mikemol_check_ratchet//:ratchet_check.sh"],
    args = [
        "$(location //ratchet:ratchet_cli)",
        "$(location @mikemol_check_ruff//:bin)",
        "$(location :pyproject.toml)",
    ],
    data = [
        "pyproject.toml",
        "ratchet-preview.txt",
        "//ratchet:ratchet_cli",
        "@mikemol_check_ruff//:bin",
    ] + glob(["src/**/*.py", "tests/**/*.py"]),
    size = "small",
)

# ⚑ THE MUTATION GATE: every def-site body is mutated and the gate refuses if any survives, so
# every function here is executed by a test whose assertion reads its result.
sh_test(
    name = "mutants",
    srcs = ["@mikemol_check_mutants//:mutate_check.sh"],
    args = [
        "$(location :pyproject.toml)",
        "$(location @mikemol_check_mutants//:mutate_runner.py)",
    ],
    data = [
        "pyproject.toml",
        ":.venv",
        "@mikemol_check_mutants//:mutate_runner.py",
    ] + glob(["src/**/*.py", "tests/**/*.py"]),
    size = "medium",
)

# ⚑ ONE py_binary PER COMMAND LINE, so a paperkit action runs each as a DECLARED tool by label
# (rules_python resolves by layout, with no sys.path and no script directory beside the module).
py_binary(
    name = "vfs",
    srcs = ["src/mikemol/treeio/vfs_cli.py"],
    main = "src/mikemol/treeio/vfs_cli.py",
    imports = ["src"],
    visibility = ["//visibility:public"],
    deps = [":treeio"],
)

py_binary(
    name = "edit_snapshot",
    srcs = ["src/mikemol/treeio/snapshot_cli.py"],
    main = "src/mikemol/treeio/snapshot_cli.py",
    imports = ["src"],
    visibility = ["//visibility:public"],
    deps = [":treeio"],
)

py_binary(
    name = "mypy_runner",
    srcs = ["@mikemol_check_mypy//:mypy_runner.py"],
    main = "@mikemol_check_mypy//:mypy_runner.py",
    deps = [
        dev_requirement("mypy"),
        dev_requirement("pytest"),
    ],
)

sh_test(
    name = "mypy",
    srcs = ["@mikemol_check_mypy//:mypy_check.sh"],
    args = [
        "$(location :mypy_runner)",
        "$(location :pyproject.toml)",
    ],
    data = [
        "pyproject.toml",
        ":mypy_runner",
    ] + glob(["src/**/*.py", "tests/**/*.py", "stubs/**"], allow_empty = True),
    size = "small",
    # ⚑ A GENEROUS TIMEOUT, NOT A TIGHT ONE (operator, 2026-09-24: "I hate wallclock-sensitive
    # things"). See //transcriptstruct:mypy for the measurement.
    timeout = "long",
)

venv_from_hub(
    name = ".venv",
    # ⚑ THE SAME ENTRIES AS pyproject's [project.scripts].
    console_scripts = {
        "mikemol-vfs": "mikemol.treeio.vfs_cli:main",
        "mikemol-edit-snapshot": "mikemol.treeio.snapshot_cli:main",
    },
    hub_requirements = dev_all_requirements,
    python_version = "3.13.13",
    python_version_short = "3.13",
    srcs = glob(["src/mikemol/treeio/**"]),
)

# W376: this distribution's :venv (W342) and :suite (W362), declared together.
dist_checks()
