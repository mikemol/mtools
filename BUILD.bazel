# ⚑⚑⚑ THE ROOT SCRIPTS MEET THE DISTRIBUTIONS' BAR, AND UNTIL THESE TARGETS NOTHING HELD THEM TO
# ANY. Each distribution's `//<dist>:ruff` and `//<dist>:mypy` stop at its own `pyproject.toml`, so
# `mutate_runner.py`, `pytest_main.py`, `mypy_runner.py`, `bep_probe.py`, `count_test_functions.py`
# and `test_mutate_runner.py` were linted by nothing and type-checked by nothing. MEASURED before
# the root `pyproject.toml` existed, under the house config: 26 ruff findings and 11 strict-mypy
# errors — paid in the same change that armed these, never baselined.
# ⚑⚑ THE SAME TWO SCRIPTS EVERY DISTRIBUTION USES, SO THE ROOT IS CHECKED THE WAY THEY ARE and a
# repair to either reaches all six. `bazel test //...` in the gate runs both; `preflight.sh` names
# them. ⚑ GLOBBED, for the reason the exports above are: a root script added tomorrow is checked
# the moment it exists, and `allow_empty = False` refuses a green over nothing.
_ROOT_PY = glob(["*.py"], allow_empty = False)

# ⚑ THE ATOMS' PYTHON IS STILL LINTED HERE (W323, W325). It moved out of the root glob into the
# atoms, which have no gate of their own yet. Ruff takes files as arguments, so it covers them by
# label. mypy reads its file list from a config, so each atom carries a mypy.ini and gets its own
# mypy target below.
_ATOM_PY = [
    "@mikemol_rules_py//:pytest_main.py",
    "@mikemol_rules_py//:venv_check.py",
    "@mikemol_rules_py//:test_venv_check.py",
    "@mikemol_rules_py//:suite_check.py",
    "@mikemol_rules_py//:test_suite_check.py",
    "@mikemol_rules_py//:reqs_check.py",
    "@mikemol_rules_py//:test_reqs_check.py",
    "@mikemol_check_mypy//:mypy_runner.py",
    "@mikemol_check_mutants//:mutate_runner.py",
    "@mikemol_check_mutants//:test_mutate_runner.py",
    "@mikemol_check_ruff//:selector_check.py",
    "@mikemol_check_ruff//:test_selector_check.py",
    "@mikemol_check_ruff//:suppression_check.py",
    "@mikemol_check_ruff//:test_suppression_check.py",
    "@mikemol_check_ratchet//:refusal_check.py",
    "@mikemol_check_ratchet//:test_refusal_check.py",
]

sh_test(
    name = "ruff",
    srcs = ["@mikemol_check_ruff//:ruff_check.sh"],
    args = [
        "$(location @mikemol_check_ruff//:bin)",
        "$(location :pyproject.toml)",
    ] + ["$(location %s)" % f for f in _ROOT_PY + _ATOM_PY],
    data = ["pyproject.toml", "@mikemol_check_ruff//:bin"] + _ROOT_PY + _ATOM_PY,
    size = "small",
)

# ⚑⚑ THE RUNNER IS `//hooks:mypy_runner`, NOT ONE DECLARED HERE. A py_binary in THIS package writes
# its generated `_<name>_stage2_bootstrap.py` into `_main/`, which `files = ["*.py"]` then checks —
# measured, 154 errors, all in the bootstrap. hooks' runner carries the same mypy and pytest pins
# (`@hooks_dev`) and leaves its bootstrap under `_main/hooks/`.
sh_test(
    name = "mypy",
    srcs = ["@mikemol_check_mypy//:mypy_check.sh"],
    args = [
        "$(location //hooks:mypy_runner)",
        "$(location :pyproject.toml)",
    ],
    data = ["pyproject.toml", "//hooks:mypy_runner"] + _ROOT_PY,
    size = "small",
    # ⚑ A GENEROUS TIMEOUT, NOT A TIGHT ONE (operator, 2026-09-24: "I hate wallclock-sensitive
    # things"). See any distribution's mypy target for the measurement.
    timeout = "long",
)

# ⚑⚑ ONE MYPY TARGET PER ATOM CARRYING PYTHON (W325), under the atom's own mypy.ini. It closes the
# gap W323 named: pytest_main.py fell out of the root's `files = ["*.py"]` when it moved.
[
    sh_test(
        name = "mypy_" + atom,
        srcs = ["@mikemol_check_mypy//:mypy_check.sh"],
        args = [
            "$(location //hooks:mypy_runner)",
            "$(location @mikemol_%s//:mypy.ini)" % atom,
        ],
        data = [
            "@mikemol_%s//:mypy.ini" % atom,
            "//hooks:mypy_runner",
        ] + ["@mikemol_%s//:%s" % (atom, script) for script in scripts],
        size = "small",
        timeout = "long",
    )
    for atom, scripts in [
        ("rules_py", [
            "pytest_main.py",
            "venv_check.py",
            "test_venv_check.py",
            "suite_check.py",
            "test_suite_check.py",
            "reqs_check.py",
            "test_reqs_check.py",
        ]),
        ("check_mypy", ["mypy_runner.py"]),
        ("check_mutants", ["mutate_runner.py", "test_mutate_runner.py"]),
        ("check_ruff", [
            "selector_check.py",
            "test_selector_check.py",
            "suppression_check.py",
            "test_suppression_check.py",
        ]),
        ("check_ratchet", ["refusal_check.py", "test_refusal_check.py"]),
    ]
]
