# ⚑ EMPTY BY DESIGN, AND NOT A PLACEHOLDER. Its only job is to make the repository root a Bazel
# PACKAGE, so that `//hooks:requirements.txt` and `//mdstruct:requirements.txt` resolve as labels.
# Without it `bazel mod deps` fails inside pip.parse's module extension — before any BUILD file is
# consulted for targets — with "Unable to load package for //mdstruct:requirements.txt: BUILD file
# not found". MEASURED: that failure names a file that EXISTS, so the missing package marker is
# the blocker rather than the missing lock, which inverts the ordering assumed at first.

exports_files(["pytest_main.py"])

# ⚑⚑⚑ THE GATE'S OWN SHELL IS A TEST TARGET, because it was previously checked by nothing. This
# file's `.githooks/pre-commit` runs ruff, mypy, pytest, the warrant ledger, the hermetic suite,
# the stub authority and the ratchet — and until now the only thing verifying IT was its author
# remembering to run shellcheck after each edit. A convention held in one person's memory,
# guarding the file that guards everything else.
sh_test(
    name = "shellcheck_githooks",
    srcs = ["shellcheck_test.sh"],
    # ⚑⚑ THE CHECKER'S OWN SCRIPT IS IN THE LIST. A gate that checks every shell file except
    # itself is the shape this repository keeps finding: `shellcheck_test.sh` is shell, it runs
    # in the gate, and excluding it would leave exactly one unchecked file — the one nobody
    # would think to look at, for the same reason nobody checked the hook before this target.
    # ⚑⚑⚑ GLOBBED, NOT LISTED, AND THE HAND LIST HAD ALREADY DRIFTED. It named 7 files while the
    # repo held more: `domain_witness.sh` and `collect_check.sh` were written after it and were
    # never added, and `.githooks/commit-msg` arrived with this change. Measured now: 11 shell
    # files against a list of 7, so the gate that checks every shell file was checking 7/11. That is
    # this repository's own denylist defect (a population enumerated once, correct on the day it
    # was written, wrong by growth) in the target whose purpose is total coverage.
    #
    # ⚑⚑ A GLOB CANNOT DRIFT: a new `.sh` at the root is covered the moment it exists, with no
    # edit here and nothing to remember. The hooks are named explicitly because they carry no
    # suffix — `.githooks/*` is the whole directory, so a hook added later is covered too.
    args = ["$(location @shellcheck//:bin)"] + [
        "$(location //:%s)" % f
        for f in glob(["*.sh", ".githooks/*"], allow_empty = False)
    ],
    data = glob(["*.sh", ".githooks/*"], allow_empty = False) + ["@shellcheck//:bin"],
    size = "small",
)

# ⚑⚑ THIS LIST HAD DRIFTED TO 8 OF 13 and the failure mode reads as a permissions problem rather
# than a declaration one: a label for an unexported source resolves and is then REFUSED with a
# *Visibility error*, so the natural reading is "I may not depend on that" instead of "nobody
# exported it". Five scripts written after this list — `collect_check`, `domain_witness`,
# `orphan_check`, `rule_citations`, `rule_freshness` — were all unreachable as data.
# ⚑ A `glob()` is the right shape here, as it was for the shellcheck target, but it changes the
# default visibility and that is a separate measurement; listed explicitly until then.
# ⚑⚑⚑ GLOBBED, AND THE DEFERRAL ABOVE IS RETIRED BY MEASUREMENT. The comment said a glob
# "is the right shape here, as it was for the shellcheck target, but it changes the default
# visibility and that is a separate measurement". ⚑ MEASURED: this file declares no `package()`
# and no `default_visibility`, so the list form and the glob form take the IDENTICAL default.
# The deferral's premise — that the two forms differ on visibility — is false, and it held a
# correct repair for two drifts.
# ⚑⚑ THE LIST DRIFTED TWICE AND BOTH DRIFTS ARE RECORDED ABOVE: 8 of 13, then short by seven.
# A THIRD was already in the tree when this was written — `figure_freshness.sh` and
# `roster_drift.sh` are root scripts this list never named, found because a hermetic arm counted
# 11 scripts where the tree holds 16. Three drifts of one list, each repaired by re-transcribing
# it, is the reified population this repo keeps measuring in other people's checkers: a fix that
# restores the count and leaves the mechanism that produced it.
# ⚑ SO THE POPULATION IS DECLARED BY CONSTRUCTION. `*.sh` is exactly "every root script", which
# is the property every consumer wants; a script added tomorrow is exported the moment it exists.
# `allow_empty = False` matches the shellcheck target above and refuses the vacuous read where a
# moved directory leaves the glob green over nothing.
exports_files(glob(
    ["*.sh", ".githooks/*"],
    allow_empty = False,
) + [
    ".bazelrc",
    "mypy_runner.py",
    ".claude/settings.json",
    "findings/CENSUS-BRIEF.md",
])

# ⚑⚑⚑ ONE NAME FOR "EVERY ROOT SCRIPT", so a consumer depends on the POPULATION rather than on
# a transcription of it. `hooks/BUILD.bazel` carried twelve of these labels by hand while the
# tree held sixteen; the four it missed were invisible because a label for an unexported source
# fails as a *Visibility error*, which reads as "I may not depend on that".
# ⚑⚑ A CONSUMER CANNOT DETECT A SHORT LIST — that is the whole difficulty. It sees the files it
# was given and reports confidently over them, which is this repo's standing defect class with
# the truncation moved into the build graph. Declaring the set here makes the omission
# unconstructible instead of merely unlikely.
# ⚑ `allow_empty = False` so a moved directory refuses rather than silently supplying nothing.
filegroup(
    name = "all_root_scripts",
    srcs = glob(["*.sh", ".githooks/*"], allow_empty = False),
    visibility = ["//visibility:public"],
)

exports_files(["BUILD.bazel"])
