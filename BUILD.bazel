# ⚑ EMPTY BY DESIGN, AND NOT A PLACEHOLDER. Its only job is to make the repository root a Bazel
# PACKAGE, so that `//hooks:requirements.txt` and `//mdstruct:requirements.txt` resolve as labels.
# Without it `bazel mod deps` fails inside pip.parse's module extension — before any BUILD file is
# consulted for targets — with "Unable to load package for //mdstruct:requirements.txt: BUILD file
# not found". MEASURED: that failure names a file that EXISTS, so the missing package marker is
# the blocker rather than the missing lock, which inverts the ordering assumed at first.

# ⚑ `pytest_main.py` moved to the python rules atom (W323): `@mikemol_rules_py//:pytest_main.py`.

# ⚑⚑ THE ATOMS' SHELL IS STILL SHELLCHECKED HERE, AND IT WAS NOT FOR ONE COMMIT. The target below
# globs the root's `*.sh`, so `ruff_check.sh` silently left its coverage when W324 moved it into
# check_ruff/, and nothing went red: an absence reads as green. Found at W325, before mypy_check.sh
# could follow it. Until each atom carries its own gate, the root checks atom files BY LABEL.
_ATOM_SH = [
    "@mikemol_check_ruff//:ruff_check.sh",
    "@mikemol_check_mypy//:mypy_check.sh",
    "@mikemol_check_mutants//:mutate_check.sh",
    "@mikemol_check_ratchet//:ratchet_check.sh",
    "@mikemol_rules_py//:venv_check.sh",
]

# ⚑⚑⚑ THE GATE'S OWN SHELL IS A TEST TARGET, because it was previously checked by nothing. This
# file's `.githooks/pre-commit` runs ruff, mypy, pytest, the warrant ledger, the hermetic suite,
# the stub authority and the ratchet — and until now the only thing verifying IT was its author
# remembering to run shellcheck after each edit. A convention held in one person's memory,
# guarding the file that guards everything else.
sh_test(
    name = "shellcheck_githooks",
    srcs = ["shellcheck_test.sh"],
    # ⚑⚑ THE CHECKER'S OWN SCRIPT IS IN THE LIST. A gate that checks every shell file except
    # itself is the shape this repository keeps finding: `shellcheck_test.sh` is shell, it runs
    # in the gate, and excluding it would leave exactly one unchecked file — the one nobody
    # would think to look at, for the same reason nobody checked the hook before this target.
    # ⚑⚑⚑ GLOBBED, NOT LISTED, AND THE HAND LIST HAD ALREADY DRIFTED. It named 7 files while the
    # repo held more: `domain_witness.sh` and `collect_check.sh` were written after it and were
    # never added, and `.githooks/commit-msg` arrived with this change. Measured now: 11 shell
    # files against a list of 7, so the gate that checks every shell file was checking 7/11. That is
    # this repository's own denylist defect (a population enumerated once, correct on the day it
    # was written, wrong by growth) in the target whose purpose is total coverage.
    #
    # ⚑⚑ A GLOB CANNOT DRIFT: a new `.sh` at the root is covered the moment it exists, with no
    # edit here and nothing to remember. The hooks are named explicitly because they carry no
    # suffix — `.githooks/*` is the whole directory, so a hook added later is covered too.
    args = ["$(location @shellcheck//:bin)"] + [
        "$(location //:%s)" % f
        for f in glob(["*.sh", ".githooks/*"], allow_empty = False)
    ] + ["$(location %s)" % f for f in _ATOM_SH],
    data = glob(["*.sh", ".githooks/*"], allow_empty = False) + _ATOM_SH + ["@shellcheck//:bin"],
    size = "small",
)

