# ⚑ MIRRORS //pkgbuild:BUILD.bazel TARGET FOR TARGET (itself a mirror of //corpus and //icsstruct);
# the rationale for each shape lives there, this file says only where it differs. `@memres_dev` is
# declared in MODULE.bazel beside this distribution's birth (mtools:W554, paperkit:W142).
load("@mikemol_rules_py//:dist.bzl", "dist_checks")
load("@mikemol_rules_py//:venv.bzl", "venv_from_hub")
load("@memres_dev//:requirements.bzl", dev_all_requirements = "all_requirements", dev_requirement = "requirement")
load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

exports_files([
    # ⚑ EXPORTED FOR `//hooks:test_bar_fires`, which globs `*/pyproject.toml` for the population.
    "pyproject.toml",
    "requirements.txt",
    "requirements-dev.txt",
    "uv.lock",
])

# ⚑ NO `deps`: the shipping hub is empty on purpose. Every module is standard library only
# (sqlite3, json, pathlib, os).
py_library(
    name = "memres",
    srcs = glob(["src/mikemol/memres/**/*.py"]),
    data = glob(["src/mikemol/memres/py.typed"], allow_empty = True),
    imports = ["src"],
    visibility = ["//visibility:public"],
)

# ⚑⚑⚑ ONE TARGET PER TEST MODULE, AND EACH IS A WITNESS. No test needs more than pytest and mypy:
# every host path (cgroup root, proc root, meminfo, the sqlite file) is a parameter, and the tests
# plant fakes of them under tmp_path.
[
    py_test(
        name = src.removeprefix("tests/").removesuffix(".py"),
        srcs = [src, "@mikemol_rules_py//:pytest_main.py"] + glob(["tests/conftest.py"], allow_empty = True),
        main = "@mikemol_rules_py//:pytest_main.py",
        args = [
            "$(location " + src + ")",
            "-q",
            "--strict-markers",
            "--strict-config",
            "-o",
            "faulthandler_timeout=60",
            "-c",
            "$(location pyproject.toml)",
        ],
        data = ["pyproject.toml"],
        size = "small",
        deps = [
            ":memres",
            dev_requirement("pytest"),
            dev_requirement("mypy"),
        ],
        imports = ["src"],
    )
    for src in glob(["tests/test_*.py"])
]

exports_files(["BUILD.bazel"])

sh_test(
    name = "ruff",
    srcs = ["@mikemol_check_ruff//:ruff_check.sh"],
    args = [
        "$(location @mikemol_check_ruff//:bin)",
        "$(location :pyproject.toml)",
    ] + ["$(location " + f + ")" for f in glob(["src/**/*.py", "tests/**/*.py"])],
    data = [
        "pyproject.toml",
        "@mikemol_check_ruff//:bin",
    ] + glob(["src/**/*.py", "tests/**/*.py"]),
    size = "small",
)

# ⚑ THE BASELINE IS MINTED EMPTY: the distribution enters clean under preview, so the ratchet
# can only hold it there.
sh_test(
    name = "ratchet",
    srcs = ["@mikemol_check_ratchet//:ratchet_check.sh"],
    args = [
        "$(location //ratchet:ratchet_cli)",
        "$(location @mikemol_check_ruff//:bin)",
        "$(location :pyproject.toml)",
    ],
    data = [
        "pyproject.toml",
        "ratchet-preview.txt",
        "//ratchet:ratchet_cli",
        "@mikemol_check_ruff//:bin",
    ] + glob(["src/**/*.py", "tests/**/*.py"]),
    size = "small",
)

sh_test(
    name = "mutants",
    srcs = ["@mikemol_check_mutants//:mutate_check.sh"],
    args = [
        "$(location :pyproject.toml)",
        "$(location @mikemol_check_mutants//:mutate_runner.py)",
    ],
    data = [
        "pyproject.toml",
        # W629: the defect classes this distribution declares, planted one at a time by the runner.
        "mutants.regex",
        ":.venv",
        "//fence:fence",
        "//mutation:mutation",
        "@mikemol_check_mutants//:mutate_runner.py",
    ] + glob(["src/**/*.py", "tests/**/*.py"]),
    size = "medium",
)

# ⚑ ONE py_binary PER SCRIPT ROLE (the four console scripts, plus `mem_learn`), so a paperkit
# action or hook runs each as a DECLARED tool by label. `mem_learn` has no console script but IS a
# script role: paperkit's `pk_mem_learn` rule (calc.bzl:270) runs it as an action tool, so it needs
# a label. `mem_db`, `mem_converge` and `zswap_probe` have no caller in paperkit and ship no
# target; `python -m mikemol.memres.<module>` reaches them.
py_binary(
    name = "mem_learn",
    srcs = ["src/mikemol/memres/mem_learn.py"],
    main = "src/mikemol/memres/mem_learn.py",
    imports = ["src"],
    visibility = ["//visibility:public"],
    deps = [":memres"],
)

py_binary(
    name = "mem_project",
    srcs = ["src/mikemol/memres/mem_project.py"],
    main = "src/mikemol/memres/mem_project.py",
    imports = ["src"],
    visibility = ["//visibility:public"],
    deps = [":memres"],
)

py_binary(
    name = "mem_harvest",
    srcs = ["src/mikemol/memres/mem_harvest.py"],
    main = "src/mikemol/memres/mem_harvest.py",
    imports = ["src"],
    visibility = ["//visibility:public"],
    deps = [":memres"],
)

py_binary(
    name = "sweep_budget",
    srcs = ["src/mikemol/memres/sweep_budget.py"],
    main = "src/mikemol/memres/sweep_budget.py",
    imports = ["src"],
    visibility = ["//visibility:public"],
    deps = [":memres"],
)

py_binary(
    name = "cpuweight",
    srcs = ["src/mikemol/memres/cpuweight.py"],
    main = "src/mikemol/memres/cpuweight.py",
    imports = ["src"],
    visibility = ["//visibility:public"],
    deps = [":memres"],
)

py_binary(
    name = "mypy_runner",
    srcs = ["@mikemol_check_mypy//:mypy_runner.py"],
    main = "@mikemol_check_mypy//:mypy_runner.py",
    deps = [
        dev_requirement("mypy"),
        dev_requirement("pytest"),
    ],
)

sh_test(
    name = "mypy",
    srcs = ["@mikemol_check_mypy//:mypy_check.sh"],
    args = [
        "$(location :mypy_runner)",
        "$(location :pyproject.toml)",
    ],
    data = [
        "pyproject.toml",
        ":mypy_runner",
    ] + glob(["src/**/*.py", "tests/**/*.py"], allow_empty = True),
    size = "small",
    # ⚑ A GENEROUS TIMEOUT, NOT A TIGHT ONE (operator, 2026-09-24: "I hate wallclock-sensitive
    # things"). See //transcriptstruct:mypy for the measurement.
    timeout = "long",
)

venv_from_hub(
    name = ".venv",
    # ⚑ THE SAME ENTRIES AS pyproject's [project.scripts].
    console_scripts = {
        "mikemol-mem-project": "mikemol.memres.mem_project:main",
        "mikemol-mem-harvest": "mikemol.memres.mem_harvest:main",
        "mikemol-sweep-budget": "mikemol.memres.sweep_budget:main",
        "mikemol-cpuweight": "mikemol.memres.cpuweight:main",
    },
    hub_requirements = dev_all_requirements,
    python_version = "3.13.13",
    python_version_short = "3.13",
    srcs = glob(["src/mikemol/memres/**"]),
)

# W376: this distribution's :venv (W342) and :suite (W362), declared together.
dist_checks()
