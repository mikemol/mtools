% warrants.bib — one claim PER TEST FUNCTION in the python rules atom's suite (W341).
%
% The atom's one test module, `test_venv_check.py`, sits beside `venv_check.py`, the check each
% distribution runs over its own built `.venv`. The claims are transcribed from the test
% docstrings. The checks run with the hooks venv's interpreter, which carries the same pytest pin
% the `//:test_venv_check` target stages.
%
% Keying convention: rules-py-<section>-<test name minus its `test_` prefix, hyphenated>.

@misc{rules-py-venv-check-good-venv-has-no-findings,
  section = {venv_check},
  claim   = {The positive control: a venv with every property reports nothing.},
  check   = {cmd:hooks/.venv/bin/python3 -m pytest test_venv_check.py -k test_good_venv_has_no_findings}
}

@misc{rules-py-venv-check-missing-interpreter-is-named,
  section = {venv_check},
  claim   = {A venv with no bin/python3 is one finding, before anything tries to run it.},
  check   = {cmd:hooks/.venv/bin/python3 -m pytest test_venv_check.py -k test_missing_interpreter_is_named}
}

