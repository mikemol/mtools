# The python rules atom (mtools:W323): load `@mikemol_rules_py//:venv.bzl`, and name
# `@mikemol_rules_py//:pytest_main.py` as a py_test's main and in its srcs.
# W341: `venv_check.py` checks one distribution's built `.venv`; each distribution runs it over its
# own (W342). Its test is run by the root's //:test_venv_check until the atom has a gate.
# W362: `suite_check.py` checks one distribution's suite is run by pytest and never resolves
# `__file__` out of the sandbox; its test is run by the root's //:test_suite_check.
# W233: `reqs_check.py` checks one distribution's requirements.txt pins agree with its uv.lock;
# its test is run by the root's //:test_reqs_check.
# W375: `dist.bzl`'s dist_checks() declares a distribution's :venv and :suite together.
exports_files([
    "dist.bzl",
    "mypy.ini",
    "pytest_main.py",
    "reqs_check.py",
    "suite_check.py",
    "test_reqs_check.py",
    "test_suite_check.py",
    "test_vacuity_floor.py",
    "test_venv_check.py",
    "vacuity_floor.py",
    "venv.bzl",
    "venv_check.py",
    "venv_check.sh",
])
