# ⚑ THE LOCK IS EXPORTED, NOT A TARGET. `pip.parse` in MODULE.bazel reads both locks by LABEL at
# module-extension evaluation time, which is before any target in this package is built — so what
# is needed is visibility of the files, not a rule producing them.
load("@mdstruct_dev//:requirements.bzl", dev_all_requirements = "all_requirements", dev_requirement = "requirement")
load("//:venv.bzl", "venv_from_hub")
load("@mdstruct_deps//:requirements.bzl", "requirement")
load("@rules_python//python:defs.bzl", "py_library", "py_test")

exports_files([
    # ⚑ EXPORTED FOR A SIBLING'S WITNESS: `//hooks:test_bar_fires` derives the distribution
    # population by globbing `*/pyproject.toml`, and in the sandbox an unexported pyproject makes
    # this distribution invisible to that arm rather than merely unchecked.
    "pyproject.toml",
    "requirements.txt",
    "requirements-dev.txt",
])

# ⚑⚑ `imports = ["src"]` IS THE PEP 420 LAYOUT MADE EXPLICIT TO BAZEL. The runfiles tree resolves
# `mikemol.mdstruct` by LAYOUT rather than by an installed `.pth`, which is the mechanism that
# retires the `mypy_path`/`explicit_package_bases` pair (⟡mtools-drop-mypypath): that pair exists
# because mypy reads the filesystem and an editable install's import hook is invisible to it.
py_library(
    name = "mdstruct",
    srcs = glob(["src/mikemol/mdstruct/**/*.py"]),
    data = glob(["src/mikemol/mdstruct/py.typed"], allow_empty = True),
    imports = ["src"],
    deps = [
        requirement("panflute"),
    ],
    visibility = ["//visibility:public"],
)

# ⚑⚑⚑ ONE TARGET PER TEST MODULE, AND EACH IS A WITNESS. The thesis in MODULE.bazel is that a
# pytest case and a paperkit witness are the same object; this is where that stops being prose. A
# failing module names itself rather than collapsing into one red suite target.
[
    py_test(
        name = src.removeprefix("tests/").removesuffix(".py"),
        srcs = [src, "//:pytest_main.py"] + glob(["tests/conftest.py"], allow_empty = True),
        main = "//:pytest_main.py",
        args = [
            "$(location " + src + ")",
            "-q",
            "--strict-markers",
            "--strict-config",
            "-c",
            "$(location pyproject.toml)",
        ],
        # ⚑⚑ pandoc IS STAGED AS A DECLARED INPUT AND PUT ON PATH, so the 54 cases carrying
        # `needs_pandoc` EXECUTE here instead of skipping. Without it the sandbox lacks the
        # binary by construction, `conftest` skips honestly, and the suite reports green over
        # cases that never ran — which is indistinguishable from a pass in bazel's summary.
        data = [
            "pyproject.toml",
            # ⚑ THE STUB AND ITS ALLOWLIST ARE STAGED because the stub-authority witness reads
            # both. They passed before only by resolving out of the sandbox into the live tree.
            "@pandoc//:bin",
        ] + glob([
            "stubs/**",
        ]),
        env = {"PANDOC_BIN": "$(location @pandoc//:bin)"},
        # ⚑ SMALL IS A DECLARATION, NOT A GUESS: every module here runs in under two seconds,
        # and bazel's default of `medium` reserves a timeout budget nothing uses. An honest
        # size is what lets a genuinely slow witness stand out later instead of blending in.
        size = "small",
        deps = [
            ":mdstruct",
            dev_requirement("pytest"),
            # ⚑ `stubtest` SHIPS INSIDE mypy, and the stub-authority witness runs it as a
            # subprocess. Staged for every module rather than one, because a per-target dep list
            # that differs by module is a place a future witness silently loses its tool.
            dev_requirement("mypy"),
        ],
        imports = ["src"],
    )
    for src in glob(["tests/test_*.py"])
]

exports_files(["BUILD.bazel"])

# ⚑⚑ ruff IN THE GRAPH. Outside it, ruff had no key at all — full re-execution every commit,
# nothing reused. Its domain is the sources, the config and the binary, all declared below, and
# all three are hand-writable because ruff does not follow imports (measured: breaking a type in
# an imported module changes mypy's verdict on the importer and leaves ruff's unchanged).
sh_test(
    name = "ruff",
    srcs = ["//:ruff_check.sh"],
    args = [
        "$(location @ruff//:bin)",
        "$(location :pyproject.toml)",
    ] + ["$(location " + f + ")" for f in glob(["src/**/*.py", "tests/**/*.py"])],
    data = [
        "pyproject.toml",
        "@ruff//:bin",
    ] + glob(["src/**/*.py", "tests/**/*.py"]),
    size = "small",
)

# ⚑⚑ THE RATCHET IN THE GRAPH, WITH ITS BASELINE DECLARED. Outside it, the ratchet had no key.
# Its domain is this distribution's sources and config, the ruff binary, AND `ratchet-preview.txt`
# — the last being the one a careless declaration drops. A census keyed without the thing it is
# compared against could be lowered with no gate noticing, which is the laundering `--init-absent`
# refuses on a second run.
sh_test(
    name = "ratchet",
    srcs = ["//:ratchet_check.sh"],
    args = [
        "$(location //ratchet:ratchet_cli)",
        "$(location @ruff//:bin)",
        "$(location :pyproject.toml)",
    ],
    data = [
        "pyproject.toml",
        "ratchet-preview.txt",
        "//ratchet:ratchet_cli",
        "@ruff//:bin",
    ] + glob(["src/**/*.py", "tests/**/*.py"]),
    size = "small",
)

# ⚑⚑ mypy IN THE GRAPH, ONE ACTION PER DISTRIBUTION. It was the last check running outside — no
# key, no invalidation, full re-execution every commit. The grain was measured rather than
# inherited: whole-distribution mypy costs 0.12s against ~3.0s for 27 per-file runs, because
# mypy's startup dominates at this scale and each per-file run re-analyses the same closure.
py_binary(
    name = "mypy_runner",
    srcs = ["//:mypy_runner.py"],
    main = "//:mypy_runner.py",
    # ⚑ pytest IS A DEP OF THE CHECKER, NOT JUST OF THE TESTS. mypy checks `files = ["src",
    # "tests"]`, and a test module imports pytest — so without it staged, mypy reports
    # `Cannot find implementation or library stub for module named "pytest"` and every fixture
    # degrades to Any. The checker's domain includes what the checked code imports.
    deps = [
        dev_requirement("mypy"),
        dev_requirement("pytest"),
    ],
)

sh_test(
    name = "mypy",
    srcs = ["//:mypy_check.sh"],
    args = [
        "$(location :mypy_runner)",
        "$(location :pyproject.toml)",
    ],
    data = [
        "pyproject.toml",
        ":mypy_runner",
    ] + glob(["src/**/*.py", "tests/**/*.py", "stubs/**"], allow_empty = True),
    size = "small",
)

# ⚑ THE SAME FOUR LINES AS EVERY OTHER DISTRIBUTION — that repetition IS the deliverable. See
# //:venv.bzl for why this duplicates rules_python's per-target venv deliberately.
venv_from_hub(
    name = ".venv",
    hub_requirements = dev_all_requirements,
    python_version = "3.13.13",
    python_version_short = "3.13",
    srcs = glob(["src/mikemol/mdstruct/**"]),
)
