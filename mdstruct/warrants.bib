  title  = {A published vocabulary is the only population that cannot go stale},
  claim  = {A consumer of this corpus carried four states written by hand from the two documents its
            author happened to be reading, and the declared union across the corpus was twice that.
            One of the states it missed is annotated in its own document as reading like a zero
            when nobody was asked, so a reader blind to that state reports the absence of a survey
            as the absence of a finding. Reading the vocabulary from the document itself removes
            the hand-written list entirely: the population is whatever the author published, and a
            document that adds a state is understood the moment it does so rather than after
            someone notices.},
  check  = {cmd:.venv/bin/python3 -m pytest tests/test_tables.py -k test_the_vocabulary_is_read_from_the_document},
}

@misc{mdstruct-tables-vocabulary-is-ordered-longest-first,
  section = {tables},
  title  = {One declared state can be a prefix of another},
  claim  = {Measured in this corpus: a prefix query for the shorter of two declared states returns the
            longer one's rows as well, eight where the truth is seven. The declared states are
            therefore not a partition and cannot be summed, and matching them longest-first is what
            makes them separable at all. The ordering is part of the contract rather than a
            convenience, because a caller that iterates in declaration order silently classifies
            the specific case under the general one.},
  check  = {cmd:.venv/bin/python3 -m pytest tests/test_tables.py -k test_the_vocabulary_is_ordered_longest_first},
}

@misc{mdstruct-tables-a-state-declared-as-a-schema-still-classifies,
