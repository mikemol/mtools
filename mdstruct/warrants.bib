  section = {lint},
  claim   = {Markup inside backticks is NOT reported as inline HTML: code spans are masked first, then looked at. This is the recorded false positive --- the inline-HTML check's first guard counted backticks AROUND the match and admitted text plainly INSIDE code, and the author nearly fixed a document to satisfy it. Printing the source line is what caught it; a count would have sent a reader editing prose that was already correct},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_lint.py -k test_code_spans_are_masked_before_the_html_scan}
}

@misc{md-lint-real-tag-is-still-reported,
  section = {lint},
  claim   = {A POSITIVE CONTROL for the masking: a genuine tag outside code IS still found. Without it, masking EVERYTHING would pass the masking case --- the two together say the predicate discriminates rather than suppresses},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_lint.py -k test_a_real_tag_is_still_reported}
}

@misc{md-lint-fenced-lines-not-measured-for-width,
  section = {lint},
  claim   = {A long line inside a code fence is not a width finding. Every rule here is about PROSE, and applying them inside a code block reports the code's own syntax as a document defect},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_lint.py -k test_fenced_lines_are_not_measured_for_width}
}

@misc{md-lint-long-prose-line-reported-at-narrow-width,
  section = {lint},
  claim   = {The width rule FIRES when the document genuinely exceeds the configured width},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_lint.py -k test_a_long_prose_line_is_reported_at_a_narrow_width}
}

@misc{md-lint-no-width-findings-at-measured-narrowest,
  section = {lint},
  claim   = {The width rule is SILENT at the width the document already satisfies --- the whole argument of this module, as a case. Four rules were about to be disabled without any being measured, and turning a rule off is the allow-list move: it rots, and it hides the population instead of retiring it. Most of these rules are SATISFIABLE, so measuring the narrowest admissible width turns a suppression into a CONFIGURATION: the rule was never incompatible with the document, it was misconfigured against it},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_lint.py -k test_no_width_findings_at_the_measured_narrowest}
}

@misc{md-lint-frontmatter-excluded-and-lines-offset,
  section = {lint},
  claim   = {Findings are body lines, numbered against the FILE, and no finding names a metadata line. A finding a reader cannot locate is not actionable, so the offset must put the number back into the file's own numbering rather than the body's},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_lint.py -k test_frontmatter_is_excluded_and_lines_are_offset}
}

@misc{md-lint-narrowest-is-none-when-nothing-fits,
  section = {lint},
  claim   = {A document exceeding the search ceiling reports NO admissible width rather than the ceiling. Never a silent ceiling: returning the upper bound would claim a width the document does not satisfy},
