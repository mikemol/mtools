}

% ---------------------------------------------------------------- roundtrip: drift

@misc{md-drift-normalized-document-round-trips-identically,
  section = {roundtrip-drift},
  claim   = {A document already at its fixpoint reports NO drift --- the positive control for the whole reader. Without it, a drift detector that reported a difference unconditionally would satisfy every other case about one round},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_roundtrip_drift.py -k test_a_normalized_document_round_trips_identically}
}

@misc{md-drift-carries-its-sample-not-just-a-count,
  section = {roundtrip-drift},
  claim   = {A non-identical round-trip reports WHAT changed, not merely that something did. Pandoc normalizes by design, so identity is the UNUSUAL case --- which makes a bare pass/fail the wrong shape for this reader: the caller almost always gets not-identical and needs the SIZE and SHAPE of the difference to decide whether it matters. A bare count is a number they cannot act on without reading the two documents themselves},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_roundtrip_drift.py -k test_drift_carries_its_sample_not_just_a_count}
}

% ---------------------------------------------------------------- roundtrip: fixpoint

@misc{md-fixpoint-reports-the-whole-sequence,
  section = {roundtrip-fixpoint},
  claim   = {The per-round deltas are returned, not only the verdict, and the last of them is zero. The reading IS the sequence: a descending sequence says approach, a repeating one says plateau, a growing one says divergence --- and a boolean discards the only thing that separates those three, which is precisely how BOTH historical stopping rules were adopted},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_roundtrip_fixpoint.py -k test_convergence_reports_the_whole_sequence}
}

@misc{md-fixpoint-converged-text-is-returned,
  section = {roundtrip-fixpoint},
  claim   = {The fixpoint's TEXT comes back, not only the fact that one exists. A function that ran a document all the way to its fixpoint and returned only deltas let a census report 48 rows going to 0 after one pass while NOTHING COULD WRITE THAT RESULT --- and a census with no apply trains a reader to dismiss it as pre-existing},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_roundtrip_fixpoint.py -k test_the_converged_text_is_returned}
}

% ---------------------------------------------------------------- roundtrip: stopping

@misc{md-stopping-plateau-is-not-a-stall,
  section = {roundtrip-stopping},
  claim   = {The flat budget ADMITS repeats --- a TERMINATION bound, not a capability one. This is the SECOND wrong stopping rule, pinned as a named constant: stop-unless-the-delta-strictly-decreases read a PLATEAU as a stall, when a real document converges in twelve rounds descending in plateaus because pandoc re-emits a block group at a time. A budget of one would reproduce the defect exactly by stopping on the first repeat, so the case asserts room for the measured worst plateau of three repeats, with margin},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_roundtrip_stopping.py -k test_a_plateau_is_not_treated_as_a_stall}
}

@misc{md-stopping-round-cap-is-not-the-default,
  section = {roundtrip-stopping},
  claim   = {A document needing several rounds converges when no round count is requested. This is the FIRST wrong stopping rule: a default cap turns a document needing one more round than the cap into a reported DIVERGENCE --- a capability bound dressed as a termination bound --- and it read a strictly DECREASING delta sequence as divergence when decrease is the signature of approach. It is asserted as BEHAVIOUR rather than by introspecting the signature: a parameter default is typed as unchecked by design, so every read of it carries an untyped value into the assertion at exactly the point it makes its claim, and the signature was never the property that mattered --- a null default with a cap applied inside the body satisfies that check and still has the defect. The two rules share a file because EACH FIX CAUSED THE NEXT DEFECT, and fixing either in isolation is what produced the other},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_roundtrip_stopping.py -k test_a_round_cap_is_not_the_default}
}

% ---------------------------------------------------------------- output

@misc{md-output-fresh-import-emits-nothing-on-stderr,
  section = {output},
  claim   = {Running the CLI in a CLEAN interpreter produces no stderr output. A fresh subprocess is the only honest test, because import warnings fire ONCE per interpreter --- a check inside the running test process passes trivially, since the import already happened when the suite loaded and its warning went wherever it went. The specific leak: a dependency documents a signature containing an escape sequence in a non-raw docstring, which Python reports as a SyntaxWarning on every import, a defect in a dependency's source that nothing a consumer writes can fix},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_output_is_clean.py -k test_a_fresh_import_emits_nothing_on_stderr}
}

@misc{md-output-stdout-is-only-the-answer,
  section = {output},
  claim   = {Every stdout line belongs to the report, not to a dependency. This is a CORRECTNESS property rather than tidiness: this package's modes are READ BY PROGRAMS --- a structural grep's output is parsed, a span list feeds a section rewrite --- so a warning rides along with the answer, and a caller capturing both streams gets a third-party warning interleaved with the data},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_output_is_clean.py -k test_stdout_is_only_the_answer}
}

@misc{md-output-suppression-does-not-silence-own-warnings,
  section = {output},
  claim   = {A warning raised from this package's OWN code is still delivered --- a positive control on the SCOPE of the suppression. The suppression is narrow on purpose, scoped to one category and one module: a blanket ignore would pass both of the quiet-streams cases above while hiding a SyntaxWarning this package's own code earns, which is exactly the finding a warning exists to deliver},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_output_is_clean.py -k test_the_suppression_does_not_silence_this_packages_own_warnings}
}

% ---------------------------------------------------------------- verify

@misc{md-verify-plain-heading-reaches,
  section = {verify},
  claim   = {A plain heading reaches the section list. This is the P-arm, and without it a contract that reported EVERY heading missing would pass as readily as a correct one},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_verify.py -k test_a_plain_heading_reaches_the_section_list}
}

@misc{md-verify-apostrophe-reaches,
  section = {verify},
  claim   = {A heading carrying an ASCII apostrophe reaches the section list. pandoc smart-quotes it to U+2019 while the raw line keeps U+0027, so under the old hand-maintained markup model the anchor keys never compared equal --- the heading was dropped and the PRECEDING section's span silently extended across it. Found by four repos writing possessive prose},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_verify.py -k test_an_apostrophe_heading_reaches_the_section_list}
}

@misc{md-verify-link-reaches,
  section = {verify},
  claim   = {A heading carrying a link reaches the section list, having failed by the same anchor-key divergence --- pandoc renders [x](y) to x. This one was found by ENUMERATING the heading-shape space rather than by being bitten, and was unknown to every party until then, which is why the shape table remains the standing weakness of this contract rather than its guarantee},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_verify.py -k test_a_link_heading_reaches_the_section_list}
}

@misc{md-verify-non-heading-hash-does-not-shift-pairing,
  section = {verify},
  claim   = {A line beginning with # that is NOT a heading does not shift the source-to-render pairing. Rendering every candidate line in one batched pandoc call made the result POSITIONAL, and a line like #no-space is a paragraph while a # inside a fence is code --- so a bare batch returns fewer headings than it was given and every later pairing shifts by one, which is the same positional-assumption class as the defect the batching replaced. Caught by this contract's own after-fence arm rather than by review, and now guarded by a sentinel heading between every input plus a strict zip that raises rather than truncates},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_verify.py -k test_a_hash_line_that_is_not_a_heading_does_not_shift_the_pairing}
}

@misc{md-verify-fenced-hash-is-not-a-heading,
  section = {verify},
  claim   = {A # inside a fenced block is not a heading. The independent witness borrows exactly ONE fact from the parser and this is it --- a fact about markdown rather than about this tool's section model},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_verify.py -k test_a_heading_inside_a_fence_is_not_a_heading}
}

@misc{md-verify-scan-does-not-use-the-parser,
  section = {verify},
  claim   = {The expected set is read by a PLAIN LINE SCAN over raw source, not by this tool's parser. A checker that shares the defect it checks for cannot detect it, and re-running a broken reader is not a second opinion --- so the scan is deliberately the awk reflex that spans exists to replace, used as an independent witness rather than as the answer},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_verify.py -k test_the_source_scan_does_not_use_this_tools_parser}
}

@misc{md-verify-selftest-holds-both-arms,
  section = {verify},
  claim   = {The selftest holds both arms across the whole shape space, as shipped},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_verify.py -k test_the_selftest_holds_both_arms_over_the_shape_space}
}

@misc{md-verify-anchor-keys-are-rendered-not-modelled,
  section = {verify},
  claim   = {The anchor reconciliation RENDERS a source line through the same pipeline the document went through rather than modelling what that pipeline strips. The previous model was a three-character tuple whose own comment warned against growing it into a grammar the renderer does not share --- it did not grow, and that was the defect. Nothing here models pandoc, so the reconciliation cannot drift from it},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_verify.py -k test_a_source_line_renders_to_exactly_what_its_document_header_renders_to}
}

@misc{md-verify-render-is-one-entry-per-input,
  section = {verify},
  claim   = {`render_headings` returns exactly one entry per input line, a non-heading holding its slot as the empty string. This is the positional contract the strict zip in spans.py asserts against, and it exists because the invariant failed silently once already},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_verify.py -k test_render_headings_returns_one_entry_per_input}
}

@misc{md-verify-selftest-fires-when-the-table-lies,
  section = {verify},
  claim   = {A shape table asserting the OPPOSITE of the truth makes the selftest FAIL, in both directions --- a row claiming a swallowed shape is reachable trips the P-arm, and a row claiming a reachable shape is swallowed trips the F-arm. This is the contract's own F-arm: without it the selftest could be green because it is aimed at the wrong predicate, which is the class this repo paid for twice in one day. A configured-but-inert gate fires on nothing and is eventually noticed; an ACTIVE gate aimed at the wrong predicate produces findings, passes review, and its greens are indistinguishable from correct ones},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_verify.py -k test_the_selftest_fires_when_a_shape_row_claims_the_opposite}
}

% ---------------------------------------------------------------- stub-authority

@misc{md-stub-matches-the-library,
  section = {stub-authority},
  claim   = {The hand-written panflute stub is checked against the library it describes, by `mypy.stubtest`. A STUB IS AN UNCHECKED CLAIM UNTIL SOMETHING CHECKS IT --- and this one's own evidence-prose cited a `scripts/check_stub_authority.py` that DID NOT EXIST, so the file asserted a verification nobody had built, which reads as covered to anyone who does not go look. On its first real run stubtest found two divergences in the two functions this package calls most: `load`'s parameter was named `source` where the runtime calls it `input_stream`, and `stringify` omitted `newlines` entirely},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_stub_authority.py -k test_the_stub_matches_the_library_it_describes}
}

@misc{md-stub-allowlist-is-constructors-only,
  section = {stub-authority},
  claim   = {Every allowlist entry is a constructor, never a called function --- which is what keeps the allowlist from becoming a suppression list. mdstruct NEVER constructs a panflute element; it reads them via isinstance checks and attribute access from whatever `load` returns, so a constructor entry is surface the stub declines to model while a non-constructor entry is a real inconsistency in something this package calls. THE GENERATED ALLOWLIST WAS NOT USABLE AS GENERATED: `--generate-allowlist` produced 15 entries and two of them were `load` and `stringify`, both carrying real defects, so accepting the generated file would have frozen both as permanently allowed and made the gate vacuous at exactly the point it exists to check. A KNOWN BOUND, F-armed: stubtest compares SIGNATURES and not RETURN TYPES, so declaring `stringify` as returning int passes silently --- that case is caught by mypy against the CALL SITES instead},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_stub_authority.py -k test_every_allowlist_entry_is_a_constructor}
}
