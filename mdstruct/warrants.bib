@misc{mdstruct-tables-an-undeclared-state-lands-in-the-residue,
  section = {tables},
  title  = {The row a stem match would have absorbed is the finding},
  claim  = {Measured on a real census: it declares one state as a schema, uses a second state in a
            status row, and never declares that second state at all. The first state's stem is a
            prefix of the second, so a stem classifier reported eight rows in one state where the
            truth is seven and one, folding an undeclared state into a declared one and calling its
            coverage complete. A stem match that continues with another word is therefore treated
            as ambiguous rather than classified: punctuation or a parenthetical may follow a state,
            but a further word means the document is naming something the vocabulary does not
            contain, and that row is the only evidence such a state exists.},
  check  = {cmd:.venv/bin/python3 -m pytest tests/test_tables.py -k test_an_undeclared_state_lands_in_the_residue_not_in_its_prefix},
}

