@misc{mdstruct-tables-short-row-padded-by-the-parser,
  section = {tables},
  title   = {A short row is padded by the parser, so this reader cannot see raggedness},
  note    = {A peer's line-based arm reported seven ragged rows in a census this reader called
            eight rows by three columns, clean. The peer was right: under a `surveyor | prefix |
            file` header seven rows carried two cells, a filing status pasted into the prefix slot
            and the remaining columns simply absent. This reader certified a table it had never
            measured, since the column count came entirely from the header and no body row was
            ever compared against it — and a structural verdict beating a textual one in the
            structural reader's favour, exactly where it has nothing to say, is the worse of the
            two failures, because a structural verdict is the one a reader trusts. The obvious
            repair was built and measured and it cannot work: counting each row's cells against
            the header reported zero on a visibly two-cell row, because pandoc pads the row before
            the AST exists, parsing a two-cell row under three columns as two values and an empty
            string. The absence is destroyed upstream of every reader in this module, so the
            blindness is by construction rather than by omission, and it belongs to this reader
            and to any successor built on the same parse. The module's own docstring already
            located the fact: table syntax is a property of the raw lines, not of the parsed
            document, so the syntax half is the only place raggedness can be read and the peer's
            line-based arm is not merely another way to find it but the only way. The arm
            therefore asserts a limit rather than a capability, and it asserts the pad positively
            — that the parser presents three cells with the last one empty — because an arm
            asserting only that the reader misses raggedness would also pass on a reader that
            dropped the row entirely, which is a different defect wearing the same silence. If
            pandoc ever stops padding, the arm fails and says that the recorded limit should be
            re-measured rather than trusted.},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_tables.py -k test_a_short_row_is_padded_by_the_parser_so_this_reader_cannot_see_it}
}

@misc{mdstruct-tables-state-headed-decoy-is-not-a-vocabulary,
  section = {tables},
  title   = {A state-headed table that is not a vocabulary is not read as one},
  note    = {The vocabulary finder identified a document's declared states by one property: that a
            table's first column is called `state`. Measured on a frozen census in this corpus,
            that reported its filing-status section as zero of seven rows matching a state the
            census publishes — seven rows using undeclared states, the worst reading anywhere in
            the corpus and the one a reader would act on first. The census was clean. Every one of
            those rows says filed. What the reader had classified against was a different table in
            the same document, two rows headed `state | what it means for the apex`, about whether
            a leg exists at all and answering an unrelated question; its first column is called
            state, so the finder took it as the vocabulary and checked filing statuses against
            `waiting is the only option`. Zero matches, arithmetically correct, over a mis-named
            population — which passes every check that catches wrong counts. The finder's own
            docstring is where the defect entered: it argued that the header is the key rather than
            a position, so a document may carry its vocabulary anywhere and add columns beside it,
            and every example it cited was a state-and-means variant. The rule as written was wider
            than the rule its examples supported, and that gap is exactly what admitted the decoy.
            The repair keys on both columns, because a vocabulary maps a state to what it MEANS and
            a table whose second column asks a different question is a different table whatever its
            first column is called. Column two is matched as a prefix, which keeps the corpus's real
            variants including a three-column form while refusing the decoy. Running the repaired
            reader against that census produces a third answer and the correct one: it declares no
            vocabulary at all, so the reader refuses rather than reporting a count, which makes the
            original figure wrong twice over — the wrong population, and a reading offered where a
            refusal was owed. The arm carries a positive control asserting the real table is still
            found, so it cannot pass by the finder going blind; it names the decoy's rows rather
            than only counting, since two populations of the same size can differ entirely; and it
            asserts the consequence as well as the cause, requiring the status rows to classify
            with an empty residue.},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_tables.py -k test_a_state_headed_table_that_is_not_a_vocabulary_is_not_read_as_one}
}

@misc{mdstruct-cli-rows-scoped-to-one-table,
  section = {cli-flags},
  title   = {Rows scoped to one table returns only that table's rows},
  note    = {The capability asserted before the refusals mean anything: a mode that refused every
            table index would satisfy an arm checking only that impossible indices are rejected,
            so this pins that a valid index does the thing the flag claims. The fixture's two
            tables hold different row counts, which makes a scoped read distinguishable from an
            unscoped one by count as well as by content, and the rows are named rather than only
            counted, because two populations of the same size can differ entirely and a future
            off-by-one selecting the same table twice would pass a count check.},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_cli_flags.py -k test_rows_scoped_to_one_table_returns_only_that_tables_rows}
}

@misc{mdstruct-cli-impossible-table-index-refuses,
  section = {cli-flags},
  title   = {An impossible table index refuses rather than returning everything},
  note    = {A peer measured this from the consumer side: asking the rows mode for table 99 of a
            five-table document returned all thirty-three rows, byte-identical to the output for a
            valid index and to the output for no index at all. The flag was parsed by the classify
            mode and never looked for by the rows mode, so it worked in whichever of the two a
            reader happened to try second, while both share a document, a vocabulary and a help
            text whose continuation lines were attached to the wrong verb. The cost landed in a
            commit message of mine, which cited measuring with that flag as the evidence for a
            defect report; the operation never occurred, since the output had been read in full and
            the isolation attributed to a filter that did nothing. The conclusion held because the
            wanted table was visible unfiltered, but a defect report whose reproduction step does
            not reproduce is one revision from being uncheckable, which is the actual finding. The
            repair refuses rather than returning an empty result, because empty is
            indistinguishable from a table that genuinely holds no rows — the absence-versus-
            unavailable confusion this corpus keeps measuring, arriving in the flag a reader
            reaches for when narrowing. The refusal names the rejected index and the range that
            exists, so the message carries the components of the comparison that produced it.},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_cli_flags.py -k test_an_impossible_table_index_refuses_rather_than_returning_everything}
}

@misc{mdstruct-cli-unparseable-table-index-refuses,
  section = {cli-flags},
  title   = {An unparseable table index refuses},
  note    = {The same discipline the column flag already had, with its reason recorded beside it:
            silently reading table zero for a non-numeric index would answer a question nobody
            asked and report it as a clean result. The classify mode already refused this while the
            rows mode did not, so one document read two ways gave two answers to one malformed
            query — and the mode that refused was not the mode whose flag was inert, which is what
            made the asymmetry hard to see from either side alone.},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_cli_flags.py -k test_an_unparseable_table_index_refuses}
}

@misc{mdstruct-lint-ragged-table-row-is-reported,
  section = {lint},
  title   = {A row whose cell count differs from its header is reported},
  note    = {This is the one structural defect no reader in this package can see through the AST.
            Pandoc pads a short row to its header's width before the parse exists, so a two-cell
            row under three columns arrives as two values and an empty string; the table module
            asserts that as a measured limit rather than repairing it, because the absence is
            destroyed upstream of every reader built on the same parse. Raggedness is therefore a
            fact about the raw lines, and the shape linter is the only place in this package where
            it can be read at all. A peer's line-based arm has been finding these in this
            repository from outside it, and was right where this package's own table reader called
            a broken table clean. The two directions are reported separately because their causes
            are opposite: a row wider than its header gained a separator, which in this corpus is
            always a raw or escaped pipe inside a code span, and a row narrower lost a cell. A
            single ragged count would state a number and imply a cause it had not measured. Code
            spans are deliberately not masked here, unlike the inline-HTML scan in the same loop,
            because a pipe inside a code span is precisely the defect: it splits the cell for every
            field-splitting reader, and masking would hide every instance this corpus has measured.
            Escaping does not help either, since a field-splitting reader splits on the raw byte.
            Each row is measured against its own table's declared width rather than a document-wide
            count, so two tables of different widths in one document do not contaminate each other,
            and a fenced block is skipped like every other rule in this linter because a code
            block's own syntax is not a document defect. The arm carries both controls: a fenced
            row of pipes and a prose line mentioning a pipe must not be reported, since a rule
            flagging every line containing a pipe would satisfy the counts while being useless.
            Verified two-armed against the corpus rather than only a fixture: silent on a census
            whose ragged section was repaired, and reproducing exactly the seven rows a peer
            reported on the same file's broken revision, with the direction named.},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_lint.py -k test_a_row_whose_cell_count_differs_from_its_header_is_reported}
}

@misc{mdstruct-verify-main-takes-its-arguments-rather-than-reading-the-global,
  section = {verify},
  claim   = {⚑⚑⚑ A FUNCTION THAT READS `sys.argv` CANNOT BE VARIED BY A CASE, so its usage, unknown-mode and arity branches were reachable only through a caller that MUTATES the global and remembers to restore it — which this suite did, putting every case behind one `finally`. ⚑⚑ The shape came from cassian's finding about a different repository: *the captivity is the defect and the raise is its symptom*. mtools recorded it as owed, cassian checked their tree because of that sentence, and mtools carried it as owed a SECOND time before looking. Measured then: the raise-shape is ABSENT from all 36 sources here, with a constructed positive control proving the searcher can see it, and the captivity was in exactly one place.},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_verify.py -k test_main_takes_its_arguments_rather_than_reading_the_global}
}

@misc{mdstruct-verify-main-still-defaults-to-the-global-for-the-console-script,
  section = {verify},
  claim   = {⚑ THE DEFAULT MUST NOT MOVE, or the installed entry point stops working: `[project.scripts]` names this function and a console script calls it with NO arguments. Making `argv` a parameter is safe only if omitting it still reads the global — the same discipline as the grader's interpreter default, pinned for the same reason.},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_verify.py -k test_main_still_defaults_to_the_global_for_the_console_script}
}

@misc{mdstruct-cli-usage-text-names-every-registered-mode,
  section = {cli-flags},
  title   = {The usage text names every registered mode},
  note    = {Two spellings of one fact, and they drifted. The unknown-mode refusal derives its
            list from the dispatch registry, while the usage banner is hand-written prose in the
            module docstring; measured 2026-09-12, the registry held eleven modes and the banner
            listed ten. The missing one was verify, which is registered, dispatchable, and
            named by the routing table's own instruction to run it before any bounded write. The
            cost is not cosmetic, because the usage text is what a reader consults before
            concluding a capability is absent: a peer migrating onto this tool reads a mode it
            cannot see as a mode the tool does not have, and the honest conclusion from that
            reading is to keep using the other implementation. The arm drives both surfaces as
            subprocesses and compares what each PRINTS, rather than importing the module and
            reading the registry attribute: an in-process read proves nothing about whether the
            banner a user is shown agrees with the refusal a user is shown, and the first cut,
            which did exactly that, needed a private-name escape and was refused by both ruff and
            the ratchet. The figures in this note were themselves wrong when first written, as
            twelve and eleven, because the refusal's comma-separated list was counted by eye
            rather than by a counter, inside the repair whose whole subject is a hand-maintained
            figure drifting from a derived one; a peer re-measured and reported eleven, and the
            registry literal holds eleven. So the arm asserts a relation between two live
            surfaces and never a cardinality, which is what makes it unable to inherit the
            mistake its own warrant records.},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_cli_flags.py -k test_the_usage_text_names_every_registered_mode}
}
