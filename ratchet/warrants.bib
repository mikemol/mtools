% warrants.bib — one claim PER TEST CASE in the ratchet suite.
%
% The claim text is TRANSCRIBED from each test function's own docstring, whose flagged
% paragraphs already argue the defect the case prevents.  Where a docstring is a bare
% one-liner the claim is correspondingly plain; that thinness is a fact about the case
% rather than something invented over.
%
% Keying convention: ratchet-<section>-<test name minus its `test_` prefix, hyphenated,
% with leading articles dropped>.  Each check runs that one test function.

% ---------------------------------------------------------------- membership

@misc{ratchet-membership-substitution-at-constant-size-is-refused,
  section = {membership},
  claim   = {THE ARM THAT PROVES THIS IS A SET RATCHET AND NOT A COUNT WEARING THE NAME. Pay one key down and add another: the cardinality is unchanged, so a count-based ratchet reports green while the membership churned ENTIRELY. The origin measured this as "six-vs-six different sets". Under set membership the added key is refused},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_core.py -k test_a_substitution_at_constant_size_is_refused}
}

@misc{ratchet-membership-growth-is-refused,
  section = {membership},
  claim   = {A key present now and absent from the baseline is refused},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_core.py -k test_growth_is_refused}
}

@misc{ratchet-membership-unchanged-census-passes,
  section = {membership},
  claim   = {The P-arm. Without it every refusal above passes against a gate that refuses everything --- which is not a strict gate but a broken one},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_core.py -k test_an_unchanged_census_passes}
}

@misc{ratchet-membership-paydown-lowers-permanently,
  section = {membership},
  claim   = {PAYDOWN LOWERS THE BASELINE PERMANENTLY, so a repair cannot silently regress --- a paid-down key returning makes the gate refuse. That is what makes this a ratchet rather than a report},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_core.py -k test_paydown_passes_and_lowers_the_baseline}
}

@misc{ratchet-membership-mixed-run-writes-nothing,
  section = {membership},
  claim   = {A run that both grows and pays down REFUSES and writes nothing. Lowering alongside growth would bank the paydown and lose the refusal in the same run},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_core.py -k test_a_mixed_run_refuses_and_writes_nothing}
}

@misc{ratchet-membership-partition-separates-growth-from-paydown,
  section = {membership},
  claim   = {Growth and paydown are INDEPENDENT; a single run can do both, and each means something different to a reader},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_core.py -k test_the_partition_separates_growth_from_paydown}
}

% ---------------------------------------------------------------- states

@misc{ratchet-states-absent-is-refused-not-read-as-clean,
  section = {states},
  claim   = {ABSENT READS GREEN WHILE ASSERTING NOTHING, which is why it exits 1. A gate with no baseline has nothing to check against and is indistinguishable in a summary line from a gate that examined a clean tree. The birth move is EXPLICIT, because a baseline that creates itself on first run grandfathers whatever happened to be present at that moment and nobody chose that set},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_core.py -k test_an_absent_baseline_is_refused_rather_than_read_as_clean}
}

@misc{ratchet-states-empty-refuses-every-key,
  section = {states},
  claim   = {EMPTY IS THE STRONGEST STATE, NOT A DEGRADED ONE --- every key reads as new and is refused},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_core.py -k test_an_empty_baseline_refuses_every_key}
}

@misc{ratchet-states-absent-and-empty-are-different-facts,
  section = {states},
  claim   = {ABSENT and EMPTY both yield an empty key set and they are OPPOSITES: one asserts nothing, the other is zero tolerance. A reader keeping only the set cannot tell them apart},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_core.py -k test_absent_and_empty_are_different_facts}
}

@misc{ratchet-states-unreadable-is-unread-not-empty,
  section = {states},
  claim   = {A decode failure is a fact about the READER, not a verdict about the gate. Reporting it as EMPTY would silently widen what the ratchet permits to everything},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_core.py -k test_an_unreadable_baseline_is_unread_rather_than_empty}
}

@misc{ratchet-states-two-independent-properties,
  section = {states},
  claim   = {A 2-BIT SPACE A BOOLEAN CANNOT CARRY. `is_defect` says the GATE cannot be trusted; `deserves_mark` says a READER should look. UNREAD marks without being a defect; EMPTY is neither. Any `!= OK` flattens the space to one bit, ALWAYS in the direction that reads strictness as debt --- the origin measured three separate instances of exactly that in one repo, including a census that printed "8 with a DEGRADED baseline" two lines above a legend explaining the two collapsed states are opposites},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_core.py -k test_each_state_declares_two_independent_properties}
}

% ---------------------------------------------------------------- write

@misc{ratchet-write-false-is-a-no-op,
  section = {write},
  claim   = {`write` IS REQUIRED AND EXPLICIT --- no environment variable arms a mutation here. An ambient switch is the same shape as a hook reporting itself armed while refusing nothing, and under a build system a cached write is a SKIPPED write, so the mutation silently does not happen},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_core.py -k test_write_false_is_a_no_op}
}

@misc{ratchet-write-confirms-what-landed,
  section = {write},
  claim   = {A write succeeding and a write LANDING are different claims. A baseline that did not land reads as ABSENT on the next run --- which reads green while asserting nothing},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_core.py -k test_a_write_confirms_what_landed}
}

% ---------------------------------------------------------------- census

@misc{ratchet-census-key-is-file-and-rule-not-line,
  section = {census},
  claim   = {A LINE NUMBER CHANGES WHEN ANYTHING ABOVE IT MOVES, so a line-keyed baseline reports a whole file as new debt after an unrelated edit --- every key refused, none of it real. A gate that cries wolf gets disabled},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_census.py -k test_the_key_is_file_and_rule_not_line}
}

@misc{ratchet-census-key-keeps-the-file,
  section = {census},
  claim   = {Collapsing the key to the rule alone loses WHERE the debt is, so paying one file down while another regresses reads as unchanged --- the same substitution blindness the set exists to defeat, one axis over},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_census.py -k test_the_key_keeps_the_file_rather_than_collapsing_to_the_rule}
}

@misc{ratchet-census-path-with-colons-is-parsed,
  section = {census},
  claim   = {A path containing colons is parsed --- the path is matched non-greedily, because a greedy match swallows the colons into the rule field},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_census.py -k test_a_path_containing_colons_is_parsed}
}

@misc{ratchet-census-non-finding-line-is-dropped,
  section = {census},
  claim   = {Summary lines and warnings are not findings},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_census.py -k test_a_non_finding_line_is_dropped}
}

@misc{ratchet-census-unexpected-exit-refuses,
  section = {census},
  claim   = {A CENSUS FROM A CHECKER THAT DID NOT RUN IS AN EMPTY SET THAT LOOKS EXACTLY LIKE A CLEAN ONE. Exit 0 and 1 are both success --- a clean tree and findings --- and anything else means the checker failed, so reporting that as an empty census would pay the ENTIRE baseline down in one run. That is the fail-open shape this ecosystem keeps paying for, so it raises instead. The parser's own first cut matched rule CODES against a tool emitting rule NAMES and produced zero keys over a tree with 192 findings, which is why the exit code is checked separately from the parse},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_census.py -k test_an_unexpected_exit_refuses_rather_than_reporting_an_empty_census}
}

% ---------------------------------------------------------------- cli

@misc{ratchet-cli-bare-invocation-refuses-absent,
  section = {cli},
  claim   = {ABSENT EXITS 1 AND THE MESSAGE NAMES THE BIRTH MOVE. A gate with no baseline reports green over nothing, which is indistinguishable in a summary line from a gate that examined a clean tree},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_cli.py -k test_the_bare_invocation_refuses_an_absent_baseline}
}

@misc{ratchet-cli-bare-invocation-does-not-mutate,
  section = {cli},
  claim   = {THE CHEAP READ IS THE DEFAULT AND EXECUTION IS OPTED INTO. A sibling repo's `--list` did not list keys --- it EXECUTED every registered witness as a subprocess and blew a two-minute timeout, and its `--times` re-ran rather than reading recorded times. The tell is not in the name and the expensive reading was the default one, so the bare invocation here must leave the tree untouched},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_cli.py -k test_the_bare_invocation_does_not_mutate}
}

@misc{ratchet-cli-init-absent-mints,
  section = {cli},
  claim   = {The birth move records what is there, ONCE, because someone said so. A baseline that creates itself on first run grandfathers whatever happened to be present at that moment, and nobody chose that set},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_cli.py -k test_init_absent_mints_the_census}
}

@misc{ratchet-cli-second-init-absent-is-refused,
  section = {cli},
  claim   = {RE-MINTING WOULD LAUNDER GROWTH INTO A NEW FLOOR, which is the one thing a paydown-only ratchet must never permit},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_cli.py -k test_a_second_init_absent_is_refused}
}

@misc{ratchet-cli-growth-is-refused-end-to-end,
  section = {cli},
  claim   = {End to end through the CLI: a new key refuses, and the refusal NAMES it --- a refusal that only denies leaves the author with no next move},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_cli.py -k test_growth_is_refused_through_the_cli}
}

@misc{ratchet-census-synthesized-bootstrap-is-not-censused,
  section = {census},
  claim   = {A generated py_binary bootstrap is a build artifact and does not enter the census. THE SIBLING ARM BELOW RECORDS *the discriminator is emptiness, not the name* AND THE PREDICATE IT GUARDS CHECKED THE NAME FIRST --- `_is_synthesized` returned False outright unless the path ended in `__init__.py`, so emptiness was consulted for exactly one filename. A domain too narrow, which that arm names as the mirror defect and then reproduces. MEASURED by a dependency bump: rules_python 1.0.0 to 2.3.3 generates `_ratchet_cli_stage2_bootstrap.py` into the runfiles tree and the gate REFUSED 49 NEW KEYS, every one in a file nobody wrote; it exists only under bazel-out and `git status --ignored` shows no such file in source. NOT a false positive and NOT a regression --- the census was correct over the wrong population, since its scope is everything ruff reports in cwd and a bump changed what is in cwd. THE RATCHET CAUGHT ITS OWN BLIND SPOT, and a bump that silently added 49 keys to a baseline would have been far worse than one that refused. Matched by the suffix the generator writes rather than a leading underscore, because `_private.py` is this repository's own convention and excluding on it would pay down real debt by accident},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_census.py -k test_a_synthesized_bootstrap_is_not_censused}
}

@misc{ratchet-census-synthesized-marker-is-not-censused,
  section = {census},
  claim   = {An EMPTY `__init__.py` is a build artifact and does not enter the census. rules_python writes one at every level of a runfiles tree so it is importable; none exist in the source tree, and `src/mikemol/__init__.py` is the file PEP 420 forbids here outright because it would make the first-installed distribution the exclusive owner of the `mikemol` prefix. MEASURED: the first honest run of the bazel ratchet gate REFUSED 8 keys, all from these --- the census was correct about what it saw, and what it saw was not the distribution. THE DISCRIMINATOR IS EMPTINESS, NOT THE NAME: a first cut excluded every `__init__.py` and over-excluded, because mdstruct's own package marker exists, carries content, and legitimately held a key, so dropping it PAID DOWN REAL DEBT by accident. That is the mirror defect --- a domain too NARROW, which serves a stale green rather than failing loudly},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_census.py -k test_a_synthesized_package_marker_is_not_censused}
}

@misc{ratchet-membership-move-is-not-growth,
  section = {membership},
  claim   = {A relocated finding is a MOVE, not growth. A rename is content-preserving but KEY-CHANGING --- the old key retires and a new one is minted for a byte-identical finding --- so a set ratchet sees "a key appeared" and refuses, and because it returns on `added` BEFORE reaching the paydown branch, the churn also stops real paydown from recording. The act of reorganising a tree then makes every gate over it read as growth while the credit that reorganisation earns cannot be banked. MEASURED here before the repair, one `git mv` of lint.py to linting.py with no content change: "1 new key REFUSED" AND "1 key paid down" in the same run. THE IDENTITY IS EVERY FIELD EXCEPT THE PATH --- the design a peer arrived at over a per-gate key schema where which field holds the path differs by gate; mtools' grammar is fixed at `path:rule`, so the identity is just the rule and the schema machinery has no counterpart here. The concept transfers; the modules would have solved a problem this repository does not have},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_core.py -k test_a_relocated_finding_is_a_move_not_growth}
}

@misc{ratchet-membership-move-lowers-the-baseline,
  section = {membership},
  claim   = {A move lowers the baseline. Otherwise the next run refuses the same relocation again --- blocking a reorganisation PERMANENTLY rather than once, which is the defect the whole distinction exists to remove},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_core.py -k test_a_move_lowers_the_baseline}
}

@misc{ratchet-membership-different-rule-is-growth,
  section = {membership},
  claim   = {A different rule at a new path is GROWTH, not a move. The identity is the rule, so only a matching rule pairs --- a different finding at a different path is two facts rather than one relocated one, and absorbing it as a move would be the ratchet weakened rather than sharpened},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_core.py -k test_a_different_rule_at_a_new_path_is_growth}
}

@misc{ratchet-membership-move-with-growth-still-refuses,
  section = {membership},
  claim   = {Recognising a move must not launder the growth beside it --- a run that both relocates and grows still REFUSES and writes nothing},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_core.py -k test_a_move_alongside_growth_still_refuses}
}

@misc{ratchet-core-one-retirement-cannot-absolve-two-arrivals,
  section = {membership},
  title   = {A single retired key absolves at most one arrival},
  note    = {Pairing on identity alone let one departure launder an unbounded fan-out of
             new findings carrying the same rule. Measured here as
             a.py -> {b.py, z.py} reporting no growth; a peer hit the same shape on its
             first live run and named it a false absolution. The pairing is one-to-one.}
}

@misc{ratchet-core-a-shared-rule-at-an-unrelated-path-is-not-a-move,
  section = {membership},
  title   = {One-to-one pairing is necessary but not sufficient},
  note    = {A lone retirement and a lone arrival sharing a rule are pairable by count while
             naming no relocation. A move must also be path-plausible: a split into a
             directory of the module's own name, or a rename within one directory.}
}

@misc{ratchet-core-two-findings-relocating-together-are-two-moves,
  section = {membership},
  title   = {A directory reorganisation is churn, not growth},
  note    = {The count asymmetry alone refuses a legitimate two-for-two relocation. Distinct
             identities pair independently, so both moves are recognised. This is the case
             that proves path plausibility is load-bearing rather than merely restrictive.}
}

@misc{ratchet-core-fan-out-refusal-is-unconditional-not-a-mode,
  section = {membership},
  title   = {The fan-out refusal is unconditional, never a mode},
  note    = {The peer implementation this machinery was derived from agrees on every
             classification and diverges on one axis: its fan-out defence is a strict=
             parameter, opt-in at its CLI and defaulting off. Measured by running its own
             classify on the fan-out shape -- two churn entries by default, two SUSPECT
             only under strict. A defence that defaults off is the false absolution with a
             flag beside it, because the hazard is that the laundering is silent. This
             test refuses a future strict= parameter as much as it checks the behaviour.}
}

@misc{ratchet-core-an-ambiguous-refusal-is-marked-suspect,
  section = {membership},
  title   = {A refusal on ambiguity is marked apart from a refusal on evidence},
  note    = {A fan-out means at most one arrival is the relocation and nothing in the census
             says which. Both are refused, but an operator needs "I refused this and could
             not have told you it was real" apart from "this is new debt". This is the
             three-outcome discipline -- a comparison that cannot be made reports INVALID,
             not FALSE -- arriving at the ratchet, which was the one place holding that rule
             while violating it.}
}

@misc{ratchet-core-an-unambiguous-refusal-is-not-suspect,
  section = {membership},
  title   = {The mark discriminates, or it means nothing},
  note    = {A key sharing a rule with a retirement but never path-plausible is refused as
             plain new debt and must NOT be marked. A state that everything carries is a
             synonym for the set it annotates. This is the F-arm without which the added
             state would be indistinguishable from added itself.}
}

@misc{ratchet-core-suspect-never-softens-the-verdict,
  section = {membership},
  title   = {Suspect says why a key was refused, never whether},
  note    = {The peer implementation carries this state behind a strict= flag defaulting
             off, so its fan-out classifies as churn unless asked -- measured by running its
             own classifier. Here the refusal is unconditional and the state is pure
             vocabulary, which is what makes it structurally unable to become a route by
             which something passes. The baseline is asserted unchanged to prove it.}
}

@misc{ratchet-core-a-comment-line-in-the-baseline-is-not-a-key,
  section = {states},
  title   = {Two instruments, each correct alone, wrong together},
  note    = {The domain witness appends a nonce to the baseline as a # comment, deliberately, so
             the file's digest moves while its census does not. This reader had no comment
             handling, so the nonce was read as a KEY: the gate refused, reporting the nonce as a
             paid-down key and an unrelated finding as new. The witness's own comment claimed the
             nonce was outside the census and the verdict unchanged. It was not, and nothing
             found it until both ran in one gate. A claim about another component's behaviour is
             a claim, and this one was never armed.}
}

@misc{ratchet-core-a-baseline-of-only-comments-reads-empty-not-ok,
  section = {states},
  title   = {A commented-out baseline must reach EMPTY},
  note    = {EMPTY is the zero-tolerance setting. A file holding only annotations asserts no debt,
             which is a different fact from a file holding keys, and reading it as OK-with-no-keys
             would reach the same value by a route that loses the distinction the state enum
             exists to keep.}
}

@misc{ratchet-census-successful-exit-is-accepted,
  section = {census},
  title   = {A successful exit is accepted, not merely not refused},
  note    = {The arm covering this predicate was one-armed. It planted a checker exiting with an
            unexpected status and asserted that the census refuses, which proves a refusal happens
            and proves nothing about what is accepted: a predicate rewritten to refuse every exit
            status would satisfy it completely. That is the broken-shut gate this repository names
            elsewhere, sitting inside the module whose whole subject is refusing a read it cannot
            trust. Both accepted statuses are load-bearing and for different reasons. Exit zero is
            a clean tree, and refusing it would make a clean distribution unmeasurable; exit one is
            a tree WITH findings, which is the normal case for a census, and refusing that would
            turn every real census into a refusal. The arm is also the control for a refactor taken
            the same tick: the membership test was rewritten from a tuple to a set literal on the
            checker's advice, and a rewrite that changed which statuses are admitted would have
            been invisible to the sibling arm. Writing the positive control first is what made the
            rewrite witnessed rather than merely plausible. One correction inside the work: the
            first cut asserted the function returns an empty list, and it returns a frozenset — the
            return type read from expectation rather than from the function, which is the cheapest
            possible instance of characterising an instrument without reading it. The behaviour was
            already correct; only the claim about it was wrong.},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_census.py -k test_a_successful_exit_is_accepted_not_merely_not_refused}
}
