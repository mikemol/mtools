# ⚑ THE RUFF CHECK ATOM (mtools:W324, plan .claude/design/W317-split-plan.md): the check script
# AND the ruff binary it runs, in one module. A check is its tool's version as much as its script.
# Pinning the binary anywhere else would put two sources under one check, the place they drift.
#
# A module repo composes it into its gate:
#     sh_test(srcs = ["@mikemol_check_ruff//:ruff_check.sh"],
#             args = ["$(location @mikemol_check_ruff//:bin)", "$(location :pyproject.toml)", ...],
#             data = ["@mikemol_check_ruff//:bin", ...])
module(name = "mikemol_check_ruff", version = "0.1.0")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

# ⚑⚑ AN http_archive BECAUSE RUFF DECLARES NO CONSOLE SCRIPT: its wheel's bin/ruff is a compiled
# ELF, so there is no entry point to regenerate (measured, and kept under an arm in hooks'
# test_bar_fires: `test_the_ruff_archive_rests_on_a_measured_entry_point_set`).
# ⚑ THE VERSION IS THE ONE THE DISTRIBUTIONS' LOCKS PIN (0.16.6). Moved verbatim from the root
# MODULE.bazel at W324: same URL, same sha256.
http_archive(
    name = "ruff",
    build_file_content = """exports_files(["ruff"])
filegroup(
    name = "bin",
    srcs = ["ruff"],
    visibility = ["//visibility:public"],
)
""",
    sha256 = "0696335ef16615d8c7445ad438750eb0f55b3da6f153df21265a7c6d5750254f",
    strip_prefix = "ruff-x86_64-unknown-linux-gnu",
    url = "https://github.com/astral-sh/ruff/releases/download/0.16.6/ruff-x86_64-unknown-linux-gnu.tar.gz",
)
