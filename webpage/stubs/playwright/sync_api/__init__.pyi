# The slice of Playwright's sync API the webpage dist's browser tests and CDP poker call (W1820).
# ⚑ DECLARED HERE BECAUSE THE BAZEL MYPY RUNNER CANNOT SEE RUNTIME DEPENDENCIES (as in otlp): the
# real package is what the tests run against, and this only says, with no Any, what they use of it.

from collections.abc import Callable
from types import TracebackType

class Error(Exception): ...
class JSHandle: ...

class CDPSession:
    def send(self, method: str) -> dict[str, object]: ...

class Page:
    url: str
    def goto(self, url: str) -> object: ...
    def add_init_script(self, script: str) -> None: ...
    def wait_for_function(self, expression: str, *, timeout: float = ...) -> JSHandle: ...
    def evaluate(self, expression: str) -> object: ...
    def on(self, event: str, handler: Callable[[Error], None]) -> None: ...
    def title(self) -> str: ...
    def close(self) -> None: ...

class BrowserContext:
    pages: list[Page]
    def new_cdp_session(self, page: Page) -> CDPSession: ...

class Browser:
    contexts: list[BrowserContext]
    def new_page(self) -> Page: ...
    def close(self) -> None: ...

class BrowserType:
    def launch(self, *, executable_path: str = ..., args: list[str] = ...) -> Browser: ...
    def connect_over_cdp(self, endpoint_url: str) -> Browser: ...

class Playwright:
    chromium: BrowserType

class PlaywrightContextManager:
    def __enter__(self) -> Playwright: ...
    def __exit__(
        self,
        exc_type: type[BaseException] | None,
        exc_value: BaseException | None,
        traceback: TracebackType | None,
    ) -> None: ...

def sync_playwright() -> PlaywrightContextManager: ...
