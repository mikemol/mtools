# ⚑ MIRRORS //transcriptstruct:BUILD.bazel TARGET FOR TARGET, which mirrors //pathsforward and
# //ratchet. The rationale for each shape lives there; this file says only where it differs.
# `@icsstruct_dev` is declared in MODULE.bazel beside this distribution's birth (W254).
load("@icsstruct_deps//:requirements.bzl", "requirement")
load("@icsstruct_dev//:requirements.bzl", dev_all_requirements = "all_requirements", dev_requirement = "requirement")
load("@mikemol_rules_py//:dist.bzl", "dist_checks")
load("@mikemol_rules_py//:venv.bzl", "venv_from_hub")
load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

exports_files([
    # ⚑ EXPORTED FOR `//hooks:test_bar_fires`, which globs `*/pyproject.toml` for the population.
    "pyproject.toml",
    "requirements.txt",
    "requirements-dev.txt",
    "uv.lock",
])

py_library(
    name = "icsstruct",
    srcs = glob(["src/mikemol/icsstruct/**/*.py"]),
    data = glob(["src/mikemol/icsstruct/py.typed"], allow_empty = True),
    imports = ["src"],
    visibility = ["//visibility:public"],
    # ⚑ FROM THE SHIPPING HUB, as //mdstruct takes panflute: these are runtime dependencies.
    deps = [
        requirement("icalendar"),
        requirement("recurring-ical-events"),
    ],
)

# ⚑⚑⚑ ONE TARGET PER TEST MODULE, AND EACH IS A WITNESS.
# ⚑ DIFFERS FROM transcriptstruct: THE FIXTURES ARE FILES, NOT INLINE. They are life's synthetic
# set (life 4a652ec), kept byte-for-byte with their CRLF terminators, so they are declared data.
# An undeclared fixture would be absent in the sandbox and the glob in the test would see none —
# which `test_fixture_set_is_the_six_life_sent` refuses rather than reading as an empty pass.
[
    py_test(
        name = src.removeprefix("tests/").removesuffix(".py"),
        srcs = [src, "@mikemol_rules_py//:pytest_main.py"] + glob(["tests/conftest.py"], allow_empty = True),
        main = "@mikemol_rules_py//:pytest_main.py",
        args = [
            "$(location " + src + ")",
            "-q",
            "--strict-markers",
            "--strict-config",
            "-o",
            "faulthandler_timeout=60",
            "-c",
            "$(location pyproject.toml)",
        ],
        # ⚑ `stubs/**` IS DATA FOR test_stub_authority, which runs stubtest over it (W258).
        data = ["pyproject.toml"] + glob(["tests/fixtures/*.ics", "stubs/**"]),
        size = "small",
        deps = [
            ":icsstruct",
            dev_requirement("pytest"),
            dev_requirement("mypy"),
        ],
        imports = ["src"],
    )
    for src in glob(["tests/test_*.py"])
]

exports_files(["BUILD.bazel"])

sh_test(
    name = "ruff",
    srcs = ["@mikemol_check_ruff//:ruff_check.sh"],
    args = [
        "$(location @mikemol_check_ruff//:bin)",
        "$(location :pyproject.toml)",
    ] + ["$(location " + f + ")" for f in glob(["src/**/*.py", "tests/**/*.py"])],
    data = [
        "pyproject.toml",
        "@mikemol_check_ruff//:bin",
    ] + glob(["src/**/*.py", "tests/**/*.py"]),
    size = "small",
)

# ⚑ THE BASELINE WAS MINTED EMPTY: the distribution enters clean under preview, so the ratchet
# can only hold it there.
sh_test(
    name = "ratchet",
    srcs = ["@mikemol_check_ratchet//:ratchet_check.sh"],
    args = [
        "$(location //ratchet:ratchet_cli)",
        "$(location @mikemol_check_ruff//:bin)",
        "$(location :pyproject.toml)",
    ],
    data = [
        "pyproject.toml",
        "ratchet-preview.txt",
        "//ratchet:ratchet_cli",
        "@mikemol_check_ruff//:bin",
    ] + glob(["src/**/*.py", "tests/**/*.py"]),
    size = "small",
)

sh_test(
    name = "mutants",
    srcs = ["@mikemol_check_mutants//:mutate_check.sh"],
    args = [
        "$(location :pyproject.toml)",
        "$(location @mikemol_check_mutants//:mutate_runner.py)",
    ],
    data = [
        "pyproject.toml",
        ":.venv",
        "//fence:fence",
        "//mutation:mutation",
        "@mikemol_check_mutants//:mutate_runner.py",
    ] + glob(["src/**/*.py", "tests/**/*.py", "tests/fixtures/*.ics"]),
    size = "medium",
)

# ⚑ A py_binary SO life AND nemik CAN RUN `mikemol-ics` AS A DECLARED TOOL, as //transcriptstruct.
py_binary(
    name = "icsstruct_cli",
    srcs = ["src/mikemol/icsstruct/cli.py"],
    main = "src/mikemol/icsstruct/cli.py",
    imports = ["src"],
    visibility = ["//visibility:public"],
    deps = [":icsstruct"],
)

py_binary(
    name = "mypy_runner",
    srcs = ["@mikemol_check_mypy//:mypy_runner.py"],
    main = "@mikemol_check_mypy//:mypy_runner.py",
    deps = [
        dev_requirement("mypy"),
        dev_requirement("pytest"),
    ],
)

sh_test(
    name = "mypy",
    srcs = ["@mikemol_check_mypy//:mypy_check.sh"],
    args = [
        "$(location :mypy_runner)",
        "$(location :pyproject.toml)",
    ],
    data = [
        "pyproject.toml",
        ":mypy_runner",
    ] + glob(["src/**/*.py", "tests/**/*.py", "stubs/**"], allow_empty = True),
    size = "small",
    # ⚑ A GENEROUS TIMEOUT, NOT A TIGHT ONE (operator, 2026-09-24: "I hate wallclock-sensitive
    # things"). See //transcriptstruct:mypy for the measurement.
    timeout = "long",
)

venv_from_hub(
    name = ".venv",
    # ⚑ THE SAME ENTRY AS pyproject's [project.scripts], as //transcriptstruct:.venv mirrors its own.
    console_scripts = {
        "mikemol-ics": "mikemol.icsstruct.cli:main",
    },
    hub_requirements = dev_all_requirements,
    python_version = "3.13.13",
    python_version_short = "3.13",
    srcs = glob(["src/mikemol/icsstruct/**"]),
)

# W376: this distribution's :venv (W342) and :suite (W362), declared together. venv_check collects
# the suite, which reads .ics fixtures and the stubs, so those are staged beside the tests.
dist_checks(venv_data = glob(["tests/fixtures/*.ics", "stubs/**"]))
