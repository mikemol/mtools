% warrants.bib — one claim PER TEST FUNCTION in the icsstruct suite.
%
% The claim text is TRANSCRIBED from each test function's own docstring, which argues the
% defect the case prevents. Where a docstring is a bare one-liner the claim is correspondingly
% plain; that thinness is a fact about the case rather than something invented over.
%
% Keying convention: icsstruct-<section>-<test name minus its `test_` prefix, hyphenated, with
% leading articles dropped>. Each check runs that one test function.


@misc{icsstruct-lexical-fixture-set-is-the-six-life-sent,
  section = {lexical},
  title  = {The fixture glob sees all six files, so a parametrize over it cannot pass empty},
  claim  = {The fixture glob sees all six files, so a parametrize over it cannot pass empty.},
  check  = {cmd:.venv/bin/python3 -m pytest tests/test_lexical.py -k test_fixture_set_is_the_six_life_sent},
}

