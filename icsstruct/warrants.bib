  section = {lexical},
  title  = {Fixture 06: a stray END, a line with no colon, and a VEVENT an outer END closes over},
  claim  = {Fixture 06: a stray END, a line with no colon, and a VEVENT an outer END closes over.
            `END:VCALENDAR` over an open VEVENT closes the VCALENDAR and reports the
            VEVENT unclosed. Treating it as a stray instead would report the calendar
            unclosed too — a fourth defect the file does not have.},
  check  = {cmd:.venv/bin/python3 -m pytest tests/test_lexical.py -k test_the_malformed_fixture_yields_exactly_its_three_defects},
}

