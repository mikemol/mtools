# SHARED pre-push, owned by mtools (handover: inbox/2026-09-23-substrate-githooks-handover.md).
# Install in a repo by symlinking it: <repo>/.githooks/pre-push -> <mtools>/githooks/pre-push,
# with `git config core.hooksPath .githooks`. ⚑ A SYMLINK, NOT A COPY OR A HARD LINK: a hard link
# carries no pointer, so nothing in the adopting tree says whose file it is, and an edit on either
# side silently changes the other (the mat230 hazard the handover letter names).
#
# 1. BLOCKS the push while a git operation is in flight: index.lock, a rebase, a merge, a
#    cherry-pick or a revert. Pushing then races it (substrate measured the post-commit amend
#    racing a push, so local and origin diverged).
# 2. THE EXTENSION POINT (asked by el-openglo, seconded by substrate): if
#    `<toplevel>/.githooks/pre-push.local` is EXECUTABLE, run it with the same arguments and the
#    SAME stdin, byte for byte, and refuse the push if it fails. A repo's own policy lives there;
#    substrate's post-commit-marker check, which the shared body used to carry, moves into
#    substrate's pre-push.local. A missing or non-executable local hook is not an error: the
#    shared checks alone decide.
#
# ⚑ STDIN IS CAPTURED ONCE, to a file, before anything reads it. Git feeds pre-push the ref list
# on stdin exactly once; a shared check that consumed it would leave the local hook an empty
# list, and a local hook that loops over refs would then check nothing and pass.
set -uo pipefail

refs="$(mktemp)" || {
  echo "pre-push: cannot create a temporary file for the ref list — push refused" >&2
  exit 1
}
trap 'rm -f "$refs"' EXIT
cat >"$refs"

gitdir="$(git rev-parse --git-dir)"
for f in index.lock rebase-merge rebase-apply MERGE_HEAD CHERRY_PICK_HEAD REVERT_HEAD; do
  if [ -e "$gitdir/$f" ]; then
    echo "pre-push: BLOCKED — git operation in flight ($f present)." >&2
    echo "          Wait for it to finish, then push." >&2
    exit 1
  fi
done

local_hook="$(git rev-parse --show-toplevel)/.githooks/pre-push.local"
if [ -x "$local_hook" ]; then
  if ! "$local_hook" "$@" <"$refs"; then
    echo "pre-push: refused by $local_hook" >&2
    exit 1
  fi
fi
exit 0
