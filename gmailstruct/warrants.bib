% warrants.bib — one claim PER TEST FUNCTION in the gmailstruct suite.
%
% The claim text is TRANSCRIBED from each test function's own docstring, which argues the
% defect the case prevents. Where a docstring is a bare one-liner the claim is correspondingly
% plain; that thinness is a fact about the case rather than something invented over.
%
% Keying convention: gmailstruct-<section>-<test name minus its `test_` prefix, hyphenated, with
% leading articles dropped>. Each check runs that one test function.


@misc{gmailstruct-records-well-formed-response-reads-in-full,
  section = {records},
  title  = {The positive control: no damage reported where there is none, and no field lost},
  claim  = {The positive control: no damage reported where there is none, and no field lost.},
  check  = {cmd:.venv/bin/python3 -m pytest tests/test_records.py -k test_well_formed_response_reads_in_full},
}

