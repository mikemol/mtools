@misc{corpus-corpus-root-discovery-uses-the-walk-vocabulary-and-the-caller-skip,
  section = {corpus},
  title  = {Generated, hidden and caller-skipped top-level trees are not discovered as roots},
  claim  = {Generated, hidden and caller-skipped top-level trees are not discovered as roots. A
            generated tree that is a TOP-LEVEL entry becomes its own root, so the
            component check below it never sees its name. And `agda` is substrate's
            policy, passed as `skip`.},
  check  = {cmd:.venv/bin/python3 -m pytest tests/test_corpus.py -k test_root_discovery_uses_the_walk_vocabulary_and_the_caller_skip},
}

@misc{corpus-corpus-walk-of-a-real-tree-is-not-empty,
  section = {corpus},
  title  = {Walking a tree with sources returns at least one file: the positive control},
  claim  = {Walking a tree with sources returns at least one file: the positive control. Every
            exclusion returns FEWER files, and an over-eager one returns zero, which
            reads as a clean tree. The empty list passes sortedness vacuously, so this
            arm keeps the next two honest.},
  check  = {cmd:.venv/bin/python3 -m pytest tests/test_corpus.py -k test_the_walk_of_a_real_tree_is_not_empty},
}

