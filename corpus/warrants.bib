  section = {corpus},
  title  = {A path neither the current directory nor the root has raises, naming what was asked},
  claim  = {A path neither the current directory nor the root has raises, naming what was asked.
            Silently returning the default corpus is the bug: a peer nearly published
            substrate's census as their own repo's.},
  check  = {cmd:.venv/bin/python3 -m pytest tests/test_corpus.py -k test_an_unresolvable_root_raises_naming_the_request},
}

