% warrants.bib — one claim PER TEST CASE in the corpus suite.
%
% The claim text is TRANSCRIBED from each test function's own docstring, whose flagged
% paragraphs already argue the defect the case prevents.  Where a docstring is a bare
% one-liner the claim is correspondingly plain; that thinness is a fact about the case
% rather than something invented over.
%
% Keying convention: corpus-<section>-<test name minus its `test_` prefix, hyphenated,
% with leading articles dropped>.  Each check runs that one test function.


@misc{corpus-corpus-root-has-no-default-anywhere,
  section = {corpus},
  title  = {No walker defaults its root, and the module holds no `ROOT` to default to},
  claim  = {No walker defaults its root, and the module holds no `ROOT` to default to. substrate's
            `ROOT = Path(__file__).absolute().parent.parent` is its repo root in place
            and the venv's lib directory once installed, so its 173 importers would have
            censused site-packages with no error. Here, a walker called without a root
            refuses at the call.},
  check  = {cmd:.venv/bin/python3 -m pytest tests/test_corpus.py -k test_the_root_has_no_default_anywhere},
}

