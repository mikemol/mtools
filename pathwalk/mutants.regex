#
# The defect classes this distribution DECLARES (mtools:W629), planted one at a time by the
# `:mutants` runner: <module>|<name>|<pattern>|<replacement>|<scope>. Each is a mistake a plausible
# edit to the walk could make, so each asks "would the suite notice THIS", which the def-site grid
# (body to raise) cannot: a call reaches every def, and none of these changes whether it is called.
# A line that stops matching is a STALE declaration and fails the grid as UNAPPLIED.

# `build` must prune build/ and NOT builder/ or rebuild.py: the match is against one path component.
src/mikemol/pathwalk/walk.py|exclude-matches-by-substring|fnmatch\.fnmatchcase\(name, pattern\)|pattern in name|def=_is_excluded

# The worktree switch: `--include-worktrees` must read them and the default must skip them.
src/mikemol/pathwalk/walk.py|worktree-switch-inverted|if include_worktrees else|if not include_worktrees else|def=expand

# A symlink is refused as data and COUNTED: the check that drops a linked directory from the walk is
# the only thing keeping it out (os.walk's own `followlinks=False` is redundant behind it, which a
# `followlinks=True` declaration here measured as SURVIVED because that mutant is EQUIVALENT).
src/mikemol/pathwalk/walk.py|symlinked-directory-not-refused|if sub\.is_symlink\(\):|if False:|def=_walk

# W575: a suffix is a dot and at least one more character; inverted, `.md` is refused and `md` (which
# matches every file ending in those letters) is accepted.
src/mikemol/pathwalk/walk.py|suffix-validation-inverted|if not suffix\.startswith\(_DOT\) or suffix == _DOT:|if suffix.startswith(_DOT) or suffix == _DOT:|def=expand
