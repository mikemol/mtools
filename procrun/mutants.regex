#
# The defect classes this distribution DECLARES (mtools:W629), planted one at a time by the
# `:mutants` runner: <module>|<name>|<pattern>|<replacement>|<scope>. A line that stops matching is a
# STALE declaration and fails the grid as UNAPPLIED.

# W872/W873: `capture` passes its timeout to the child. Dropping it lets a runaway child hang the
# caller (the 30-second sleeping child outlasts the 0.2-second timeout only when it is passed).
src/mikemol/procrun/proc.py|capture-drops-the-timeout|        timeout=timeout,|        timeout=None,|def=capture

# The working directory is the one passed: dropping it runs the child in the caller's.
src/mikemol/procrun/proc.py|capture-drops-the-cwd|        cwd=cwd,|        cwd=None,|def=capture

# The whole environment is the one passed: dropping it hands the child the caller's.
src/mikemol/procrun/proc.py|capture-drops-the-env|        env=env,|        env=None,|def=capture

# A non-zero status is a value: `check=True` would raise it.
src/mikemol/procrun/proc.py|capture-raises-on-failure|check=False|check=True|def=capture

# W2231: the text on stdin reaches the child; dropping it leaves the child reading nothing.
src/mikemol/procrun/proc.py|capture-drops-the-input|        input=input_text,|        input=None,|def=capture

# W2231: the bytes seam is the same seam in bytes: each of its parameters reaches the child.
src/mikemol/procrun/proc.py|capture-bytes-drops-the-timeout|        timeout=timeout,|        timeout=None,|def=capture_bytes
src/mikemol/procrun/proc.py|capture-bytes-drops-the-input|        input=input_bytes,|        input=None,|def=capture_bytes
src/mikemol/procrun/proc.py|capture-bytes-raises-on-failure|check=False|check=True|def=capture_bytes

# W2241: spawn hands the child what it was given, and discard really drops each stream.
src/mikemol/procrun/proc.py|spawn-drops-the-cwd|            cwd=cwd,|            cwd=None,|def=spawn
src/mikemol/procrun/proc.py|spawn-drops-the-env|            env=env,|            env=None,|def=spawn
src/mikemol/procrun/proc.py|spawn-discard-keeps-stdin|            stdin=sink if stdin == "discard" else None,|            stdin=None,|def=spawn
src/mikemol/procrun/proc.py|spawn-discard-keeps-stdout|            stdout=sink if output == "discard" else None,|            stdout=None,|def=spawn
src/mikemol/procrun/proc.py|spawn-discard-keeps-stderr|            stderr=sink if output == "discard" else None,|            stderr=None,|def=spawn

# W2241: a Child's wait honours its timeout, and its signals reach the process.
src/mikemol/procrun/proc.py|child-wait-drops-the-timeout|        return self._popen.wait\(timeout=timeout\)|        return self._popen.wait()|def=Child.wait
src/mikemol/procrun/proc.py|child-kill-does-nothing|        self._popen.kill\(\)|        pass|def=Child.kill
src/mikemol/procrun/proc.py|child-terminate-does-nothing|        self._popen.terminate\(\)|        pass|def=Child.terminate

# W2242: capture_stdout leaves stderr to the caller and still passes its timeout.
src/mikemol/procrun/proc.py|capture-stdout-captures-stderr|        stderr=None,|        stderr=subprocess.PIPE,|def=capture_stdout
src/mikemol/procrun/proc.py|capture-stdout-drops-the-timeout|        timeout=timeout,|        timeout=None,|def=capture_stdout
