% warrants.bib — one claim PER TEST FUNCTION in the repository root's suite.
%
% The root carries one test module, `test_mutate_runner.py`, beside the script it tests: the
% runner is a root file every distribution's `mutants` target runs, and a test importing it from
% inside a distribution would read it as `Any` under strict mypy. Its tests had no warrant home
% until this file; the gate now holds them to the same 1:1 ledger, section diff and pairing as
% every distribution. The checks run from the repository root with the hooks venv's interpreter,
% which carries the same pytest pin the `//:test_mutate_runner` target stages.
%
% Keying convention: root-<section>-<test name minus its `test_` prefix, hyphenated>.

@misc{root-mutate-runner-methods-of-two-classes-are-two-sites-and-the-second-mutates-the-second,
  section = {mutate_runner},
  claim   = {Two classes' `run` methods are two def-sites, and mutating the second leaves the first alone. The bare-name runner mutated the FIRST def carrying a name, so both rows were one mutation},
  check   = {cmd:hooks/.venv/bin/python3 -m pytest test_mutate_runner.py -k test_methods_of_two_classes_are_two_sites_and_the_second_mutates_the_second}
}

@misc{root-mutate-runner-a-protocol-stub-and-a-function-of-its-name-are-separate-sites,
  section = {mutate_runner},
  claim   = {A Protocol stub and a same-named function are separate sites, and the function mutates itself. Measured on ratchet: a stub `parse` came back SURVIVED three times because every `parse` mutated the stub},
  check   = {cmd:hooks/.venv/bin/python3 -m pytest test_mutate_runner.py -k test_a_protocol_stub_and_a_function_of_its_name_are_separate_sites}
}

@misc{root-mutate-runner-a-nested-def-is-addressed-through-its-enclosing-function,
