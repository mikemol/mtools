# ⚑⚑⚑ THE FIRST GATE IN THIS REPOSITORY THAT CHECKS THE COMMIT MESSAGE AGAINST THE TREE. Every
# other gate asks whether the CODE is correct; this asks whether the MESSAGE is true. Both are
# claims, only one was checked, and the unchecked one is the durable artifact — a reader six months
# out reads the message, not the diff.
#
# ⚑⚑ IT EXISTS BECAUSE A COMMIT ASSERTED A RULE THAT WAS NEVER WRITTEN. "mdstruct: add a
# column-anchored row filter; Rule 23" landed with its code, its tests and its warrants; the rule
# itself did not. It survived two hours and was found by eye, from the heading sequence stepping
# 22 -> 24. ⚑ A citation to a rule that does not exist reads exactly like a citation to one that
# does: nothing is malformed, the document exists, and only following the pointer separates them.
#
# ⚑ COMMIT-MSG, NOT PRE-COMMIT, because the message is not available at pre-commit time — and this
# is the one property whose subject IS the message.
set -uo pipefail

repo="$(git rev-parse --show-toplevel)"
say() { printf 'commit-msg: %s\n' "$*" >&2; }
# ⚑⚑ SOURCED, NOT COPIED. Six of this repo's seven refusal paths left no durable row; four of
# them are in this file. The recorder lives in one place so a new refusal site here inherits it.
# ⚑ Its own absence is REPORTED and does not refuse — a missing recorder is a lost row, while a
# refusal here would turn a bookkeeping gap into a blocked commit. That asymmetry is deliberate
# and is the one place in this file where absence is not a refusal.
if [ -r "$repo/refusal_record.sh" ]; then
    . "$repo/refusal_record.sh"
else
    say "  ⚑ refusal_record.sh unreadable — this refusal will not be recorded"
    record_refusal() { :; }
fi

if [ ! -x "$repo/rule_citations.sh" ]; then
    say "rule_citations.sh is missing or not executable — cannot verify citations, commit refused"
    say "  a gate that skips when its checker is absent is armed while refusing nothing"
    record_refusal commit-msg " - rule_citations.sh absent or not executable"
    exit 1
fi

# ⚑⚑⚑ A COUNT IS A CITATION TOO. `rule_citations.sh` refuses a message naming a rule that does
# not exist; this refuses one asserting a ledger count the staged ledger does not have. MEASURED:
# `2c75167` says *188 entries* and the ledger at that commit holds 189 — a figure taken before the
# commit's own change, published as the state the commit produced.
# ⚑ Absence is reported rather than skipped, same as below.
if [ ! -x "$repo/message_counts.sh" ]; then
    say "message_counts.sh is missing or not executable — cannot verify counts, commit refused"
    record_refusal commit-msg " - message_counts.sh absent or not executable"
    exit 1
fi
"$repo/message_counts.sh" "$1" || {
    say "REFUSED — a ledger count in this message disagrees with the staged ledger"
    record_refusal commit-msg " - message ledger count disagrees with the staged ledger"
    exit 1
}

"$repo/rule_citations.sh" "$1" || {
    say "REFUSED"
    record_refusal commit-msg " - message cites a rule that does not exist"
    exit 1
}
