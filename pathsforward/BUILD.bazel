# ⚑ MIRRORS //ratchet:BUILD.bazel TARGET FOR TARGET, with //fence's console_scripts on the venv.
# The rationale for each shape lives there; this file says only where it differs.
# ⚑⚑ `@pathsforward_dev` DOES NOT EXIST UNTIL MODULE.bazel DECLARES IT — see NOTES.md, "root
# wiring". Until then this package does not load, which is the honest state of a proposal.
load("@pathsforward_dev//:requirements.bzl", dev_all_requirements = "all_requirements", dev_requirement = "requirement")
load("@mikemol_check_mutants//:defs.bzl", "mutants_sharded")
load("@mikemol_rules_py//:dist.bzl", "dist_checks")
load("@mikemol_rules_py//:venv.bzl", "venv_from_hub")
load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

exports_files([
    # ⚑ EXPORTED FOR `//hooks:test_bar_fires`, which globs `*/pyproject.toml` for the population.
    "pyproject.toml",
    "requirements.txt",
    "requirements-dev.txt",
    "uv.lock",
])

py_library(
    name = "pathsforward",
    srcs = glob(["src/mikemol/pathsforward/**/*.py"]),
    # W850: the realizability policy is package data, read by opa_eval at its own path.
    data = glob(["src/mikemol/pathsforward/py.typed"], allow_empty = True) + glob(
        ["src/mikemol/pathsforward/policy/*.rego"],
    ),
    imports = ["src"],
    visibility = ["//visibility:public"],
)

# ⚑⚑⚑ ONE TARGET PER TEST MODULE, AND EACH IS A WITNESS.
# ⚑⚑ `test_lock` AND `test_store` SPAWN REAL PROCESSES — the defects they close (a double
# acquire in 6 of 40 trials, a torn read) were races BETWEEN processes, and an in-process arm
# cannot race. They launch `sys.executable -m mikemol.pathsforward` with PYTHONPATH derived from
# the imported package, so the runfiles copy is the one under test. Every wait is bounded (60s),
# so they are `medium` for the headroom, not because they are slow: measured under 3s together.
[
    py_test(
        name = src.removeprefix("tests/").removesuffix(".py"),
        srcs = [src, "@mikemol_rules_py//:pytest_main.py"] + glob(["tests/conftest.py"], allow_empty = True),
        main = "@mikemol_rules_py//:pytest_main.py",
        args = [
            "$(location " + src + ")",
            "-q",
            "--strict-markers",
            "--strict-config",
            "-o",
            "faulthandler_timeout=60",
            "-c",
            "$(location pyproject.toml)",
        ],
        # W850: test_certify runs the real policy under the hash-pinned opa, named by OPA_BIN.
        data = ["pyproject.toml", "@opa//file"],
        env = {"OPA_BIN": "$(location @opa//file)"},
        size = "medium" if src in ("tests/test_lock.py", "tests/test_store.py") else "small",
        deps = [
            ":pathsforward",
            dev_requirement("pytest"),
        ],
        imports = ["src"],
    )
    for src in glob(["tests/test_*.py"])
]

# W850: the realizability policy's own witnesses and controls (policy/realizability_test.rego),
# run by the pinned opa, as //hooks:policy_test runs the standing policy's.
sh_test(
    name = "policy_test",
    srcs = ["policy_test.sh"],
    args = [
        "$(location @opa//file)",
        "$(location src/mikemol/pathsforward/policy/realizability.rego)",
    ],
    data = ["@opa//file"] + glob(["src/mikemol/pathsforward/policy/*.rego"]),
    size = "small",
)

exports_files(["BUILD.bazel"])

sh_test(
    name = "ruff",
    srcs = ["@mikemol_check_ruff//:ruff_check.sh"],
    args = [
        "$(location @mikemol_check_ruff//:bin)",
        "$(location :pyproject.toml)",
    ] + ["$(location " + f + ")" for f in glob(["src/**/*.py", "tests/**/*.py"])],
    data = [
        "pyproject.toml",
        "@mikemol_check_ruff//:bin",
    ] + glob(["src/**/*.py", "tests/**/*.py"]),
    size = "small",
)

# ⚑ THE BASELINE WAS MINTED EMPTY (`mikemol-ratchet <dist> --init-absent` -> 0 keys): the
# distribution enters clean under preview, so the ratchet can only hold it there.
sh_test(
    name = "ratchet",
    srcs = ["@mikemol_check_ratchet//:ratchet_check.sh"],
    args = [
        "$(location //ratchet:ratchet_cli)",
        "$(location @mikemol_check_ruff//:bin)",
        "$(location :pyproject.toml)",
    ],
    data = [
        "pyproject.toml",
        "ratchet-preview.txt",
        "//ratchet:ratchet_cli",
        "@mikemol_check_ruff//:bin",
    ] + glob(["src/**/*.py", "tests/**/*.py"]),
    size = "small",
)

# ⚑ MEASURED BEFORE PROPOSING: 104 def-sites, 104 KILLED, 0 SURVIVED, 0 ERRORED.
mutants_sharded(
    name = "mutants",
    shards = 3,
    srcs = ["@mikemol_check_mutants//:mutate_check.sh"],
    args = [
        "$(location :pyproject.toml)",
        "$(location @mikemol_check_mutants//:mutate_runner.py)",
    ],
    data = [
        "pyproject.toml",
        # W629: the defect classes this distribution declares, planted one at a time by the runner.
        "mutants.regex",
        ":.venv",
        "//fence:fence",
        "//mutation:mutation",
        "@mikemol_check_mutants//:mutate_runner.py",
    ] + glob(["src/**/*.py", "src/**/*.rego", "tests/**/*.py"]),
    size = "medium",
    # ⚑ DECLARED, NOT LEFT TO THE SIZE DEFAULT (as //pycodemod:mutants): this grid TIMED OUT at the
    # `medium` 300s default on 2026-10-09 when the whole 686-test suite ran beside the pycodemod
    # grid, after pathsforward --update gained --add-enables. The grid grows with every def-site, so
    # the limit is stated; a gate that passes alone and times out under load is a flake.
    timeout = "long",
)

# ⚑ A py_binary SO OTHER REPOS CAN RUN THE TOOL AS A DECLARED TOOL rather than a copied script —
# the copies are how four hash schemes arose.
py_binary(
    name = "pathsforward_cli",
    srcs = glob(["src/mikemol/pathsforward/**/*.py"]),
    main = "src/mikemol/pathsforward/cli.py",
    imports = ["src"],
    visibility = ["//visibility:public"],
)

py_binary(
    name = "mypy_runner",
    srcs = ["@mikemol_check_mypy//:mypy_runner.py"],
    main = "@mikemol_check_mypy//:mypy_runner.py",
    deps = [
        dev_requirement("mypy"),
        dev_requirement("pytest"),
    ],
)

sh_test(
    name = "mypy",
    srcs = ["@mikemol_check_mypy//:mypy_check.sh"],
    args = [
        "$(location :mypy_runner)",
        "$(location :pyproject.toml)",
    ],
    data = [
        "pyproject.toml",
        ":mypy_runner",
    ] + glob(["src/**/*.py", "tests/**/*.py", "stubs/**"], allow_empty = True),
    size = "small",
    # ⚑ A GENEROUS TIMEOUT, NOT A TIGHT ONE (operator, 2026-09-24: "I hate wallclock-sensitive
    # things"). MEASURED under host contention: a cold mypy took wall=295s against user=2.9s, so
    # the 60s default of `small` timed out on waiting, not on work. `size` stays small (it is a
    # resource claim); only the wall-clock allowance grows.
    timeout = "long",
)

venv_from_hub(
    name = ".venv",
    # ⚑ THE SAME ENTRY AS pyproject's [project.scripts], as //fence:.venv mirrors its own.
    console_scripts = {
        "mikemol-paths-forward": "mikemol.pathsforward.cli:main",
    },
    hub_requirements = dev_all_requirements,
    python_version = "3.13.13",
    python_version_short = "3.13",
    srcs = glob(["src/mikemol/pathsforward/**"]),
)

# W376: this distribution's :venv (W342) and :suite (W362), declared together.
dist_checks()

