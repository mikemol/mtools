#
# The defect classes this distribution DECLARES (mtools:W629), planted one at a time by the
# `:mutants` runner: <module>|<name>|<pattern>|<replacement>|<scope>. A line that stops matching is a
# STALE declaration and fails the grid as UNAPPLIED.

# W604: the rendered mirror must pass the markdown bar's 120 columns; a wrap whose break condition
# never fires still renders every word and every table, and only a line-length check sees it.
src/mikemol/pathsforward/render.py|wrap-never-breaks|> WIDTH and current|> WIDTH * 100 and current|def=wrap

# W577: a local card claims a peer's ask by `enables` OR by `caused_by`; without the second, a card
# minted from the ask reads as no claim and the ask stays UNCLAIMED after it was taken.
src/mikemol/pathsforward/inbound.py|caused-by-no-longer-claims|, text\(w, "caused_by"\)\)|, "")|def=claims

# W869: a bundled title is refused at mint time on nemik's predicate, LENGTH AND a clause mark.
# `or` refuses every short title that carries a mark; a looser limit lets exactly-150 through
# wrongly or a tighter one refuses it; dropping the call lets `--add` mint a bundle.
src/mikemol/pathsforward/ops.py|bundled-needs-length-and-mark|len\(title\) > BUNDLED_LENGTH and marks|len(title) > BUNDLED_LENGTH or marks|def=refuse_bundled
src/mikemol/pathsforward/ops.py|bundled-limit-inclusive|> BUNDLED_LENGTH and|>= BUNDLED_LENGTH and|def=refuse_bundled
src/mikemol/pathsforward/ops.py|add-skips-the-bundled-check|refuse_bundled\(draft\.title\)|pass|def=add

# W870: the gate card. A second red must not block a waypoint twice; a repair keeps its other edges
# (`enables` is SET, not merged) and is not itself blocked by the card; green with no open card is a
# no-op rather than closing something else.
src/mikemol/pathsforward/gate.py|block-twice|if card in current:|if False:|def=_block
src/mikemol/pathsforward/gate.py|repair-erases-its-edges|edges = \(\*edges, card\)|edges = (card,)|def=_repair
src/mikemol/pathsforward/gate.py|repair-is-blocked-too|skip = \{card, \*spec\.repairs\}|skip = {card}|def=red
src/mikemol/pathsforward/gate.py|green-closes-without-a-card|if existing is None:|if existing is not None:|def=green

# W870 slice 2: the CLI hands the card its first step, its operator ask and its repairs. Dropping
# the repairs blocks the work that fixes the gate; dropping the ask leaves the card waiting on nobody.
src/mikemol/pathsforward/cli.py|gate-red-drops-the-repairs|repairs=ctx\.many\("exclude"\) or \(\),|repairs=(),|def=_gate_red
src/mikemol/pathsforward/cli.py|gate-red-drops-the-operator-ask|human=" "\.join\(ctx\.many\("blocked_on"\) or \(\)\),|human="",|def=_gate_red
src/mikemol/pathsforward/cli.py|gate-green-always-finds-a-card|if not card:|if card:|def=_gate_green

# W882 (nemik:W224): a citation's repo part is a path of segments. Each segment must lead with a
# letter or digit, so `..` and a hidden directory cannot be cited; a segment that is empty or dot-led
# is refused by name before any read; a link anywhere on the way is refused as data.
src/mikemol/pathsforward/foreign.py|empty-segment-allowed|not segment or segment\.startswith\("\."\)|segment.startswith(".")|def=_escapes
src/mikemol/pathsforward/foreign.py|dot-led-segment-allowed|not segment or segment\.startswith\("\."\)|not segment|def=_escapes
src/mikemol/pathsforward/foreign.py|link-on-the-way-ignored|_link_in\(root, repo\) or path\.parent|path.parent|def=peer

# W880: `--add-enables` appends. Dropping the repeat check duplicates an edge; replacing the kept
# list with an empty one erases the edges already there; dropping the both-flags refusal lets an
# ambiguous update through.
src/mikemol/pathsforward/ops.py|append-repeats-an-edge|if edge not in edges:|if True:|def=_append_edges
src/mikemol/pathsforward/ops.py|append-erases-the-kept-edges|edges = strlist\(new, "enables"\)|edges = []|def=_append_edges
src/mikemol/pathsforward/ops.py|both-enables-flags-allowed|upd\.enables is not None and upd\.add_enables is not None|False|def=_refuse_enums

# W830: `--gate-note` appends to an open gate card and NEVER mints one. Minting on a missing card
# would block the ledger on an exploratory failure; dropping the append would lose the report; and
# writing it into a replaced field would lose the earlier one.
src/mikemol/pathsforward/gate.py|note-ignores-a-missing-card|if existing is None:|if False:|def=note
src/mikemol/pathsforward/gate.py|note-drops-the-evidence|ops\.Update\(evidence_append=evidence\)|ops.Update()|def=note
