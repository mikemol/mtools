# ⚑ MIRRORS //pkgbuild:BUILD.bazel (the first distribution of paperkit's tools/ migration) TARGET
# FOR TARGET; the rationale for each shape lives there and in //corpus, this file says only where
# it differs. `@mutantcell_dev` is declared in MODULE.bazel beside this distribution's birth
# (mtools:W545, paperkit:W142).
load("@mikemol_rules_py//:dist.bzl", "dist_checks")
load("@mikemol_rules_py//:venv.bzl", "venv_from_hub")
load("@mutantcell_dev//:requirements.bzl", dev_all_requirements = "all_requirements", dev_requirement = "requirement")
load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

exports_files([
    # ⚑ EXPORTED FOR `//hooks:test_bar_fires`, which globs `*/pyproject.toml` for the population.
    "pyproject.toml",
    "requirements.txt",
    "requirements-dev.txt",
    "uv.lock",
])

# ⚑ THE SIBLING EDGES (mtools:W562, ruled A+B 2026-10-04): the shipping hub stays empty, because a pip
# hub cannot resolve a path source. The dependencies on `mikemol-mutation` and `mikemol-importdag` are
# declared in pyproject.toml for uv and carried here as Bazel dependencies on the siblings'
# py_library targets. The two must be kept in step by hand.
py_library(
    name = "mutantcell",
    srcs = glob(["src/mikemol/mutantcell/**/*.py"]),
    data = glob(["src/mikemol/mutantcell/py.typed"], allow_empty = True),
    imports = ["src"],
    visibility = ["//visibility:public"],
    deps = [
        "//importdag:importdag",
        "//mutation:mutation",
    ],
)

# ⚑⚑⚑ ONE TARGET PER TEST MODULE, AND EACH IS A WITNESS. test_eval spawns `python -m
# mikemol.mutantcell.eval` for the cells whose caps are irreversible, resolving the package from
# the `src` directory its own import found, so no extra data is declared for it.
[
    py_test(
        name = src.removeprefix("tests/").removesuffix(".py"),
        srcs = [src, "@mikemol_rules_py//:pytest_main.py"] + glob(["tests/conftest.py"], allow_empty = True),
        main = "@mikemol_rules_py//:pytest_main.py",
        args = [
            "$(location " + src + ")",
            "-q",
            "--strict-markers",
            "--strict-config",
            "-o",
            "faulthandler_timeout=60",
            "-c",
            "$(location pyproject.toml)",
        ],
        data = ["pyproject.toml"],
        size = "small",
        deps = [
            ":mutantcell",
            "//importdag:importdag",
            "//mutation:mutation",
            dev_requirement("pytest"),
            dev_requirement("mypy"),
        ],
        imports = ["src"],
        # ⚑ With several source roots on sys.path (this dist and its siblings), legacy implicit
        # `__init__.py` creation would turn `mikemol` into a regular package from the first root and
        # shadow the namespace (W566).
        legacy_create_init = 0,
    )
    for src in glob(["tests/test_*.py"])
]

exports_files(["BUILD.bazel"])

sh_test(
    name = "ruff",
    srcs = ["@mikemol_check_ruff//:ruff_check.sh"],
    args = [
        "$(location @mikemol_check_ruff//:bin)",
        "$(location :pyproject.toml)",
    ] + ["$(location " + f + ")" for f in glob(["src/**/*.py", "tests/**/*.py"])],
    data = [
        "pyproject.toml",
        "@mikemol_check_ruff//:bin",
    ] + glob(["src/**/*.py", "tests/**/*.py"]),
    size = "small",
)

# ⚑ THE BASELINE IS MINTED EMPTY: the distribution enters clean under preview, so the ratchet
# can only hold it there.
sh_test(
    name = "ratchet",
    srcs = ["@mikemol_check_ratchet//:ratchet_check.sh"],
    args = [
        "$(location //ratchet:ratchet_cli)",
        "$(location @mikemol_check_ruff//:bin)",
        "$(location :pyproject.toml)",
    ],
    data = [
        "pyproject.toml",
        "ratchet-preview.txt",
        "//ratchet:ratchet_cli",
        "@mikemol_check_ruff//:bin",
    ] + glob(["src/**/*.py", "tests/**/*.py"]),
    size = "small",
)

sh_test(
    name = "mutants",
    srcs = ["@mikemol_check_mutants//:mutate_check.sh"],
    args = [
        "$(location :pyproject.toml)",
        "$(location @mikemol_check_mutants//:mutate_runner.py)",
    ],
    data = [
        "pyproject.toml",
        # W629: the defect classes this distribution declares, planted one at a time by the runner.
        "mutants.regex",
        ":.venv",
        "//fence:fence",
        "//mutation:mutation",
        "@mikemol_check_mutants//:mutate_runner.py",
    ] + glob(["src/**/*.py", "tests/**/*.py"]),
    size = "medium",
)

# ⚑ `eval` IS THE ONE SCRIPT ROLE, AND ITS SRCS ARE eval + ITS THREE SIBLINGS BY LABEL, exactly as
# paperkit's tools/BUILD.bazel:56 built it (srcs eval.py, cellargs.py, cellcgroup.py, cellstage.py)
# so `from mikemol.mutantcell import cellargs, ...` resolves BY LAYOUT in the sweep cell's runfiles,
# with no sys.path mutation. `sens`, `decisions` and `def_sites` are `-m` only; `cellargs`,
# `cellcgroup` and `cellstage` are library-only (nothing runs at their import).
py_binary(
    name = "eval",
    srcs = [
        "src/mikemol/mutantcell/eval.py",
        "src/mikemol/mutantcell/cellargs.py",
        "src/mikemol/mutantcell/cellcgroup.py",
        "src/mikemol/mutantcell/cellstage.py",
    ],
    main = "src/mikemol/mutantcell/eval.py",
    imports = ["src"],
    visibility = ["//visibility:public"],
    deps = [":mutantcell"],
    # ⚑ The siblings' source roots sit beside this one in the runfiles (see the py_test above); without
    # this `bazel run //mutantcell:eval` fails with `No module named 'mikemol.mutantcell'` (measured).
    legacy_create_init = 0,
)

# ⚑ `sites` imports both siblings, so it too needs `legacy_create_init = 0`.
py_binary(
    name = "sites",
    srcs = ["src/mikemol/mutantcell/sites.py"],
    main = "src/mikemol/mutantcell/sites.py",
    imports = ["src"],
    visibility = ["//visibility:public"],
    deps = [":mutantcell"],
    legacy_create_init = 0,
)

py_binary(
    name = "mypy_runner",
    srcs = ["@mikemol_check_mypy//:mypy_runner.py"],
    main = "@mikemol_check_mypy//:mypy_runner.py",
    deps = [
        # ⚑ How mypy sees the siblings inside the sandbox (the runner cannot see pip-installed siblings).
        "//importdag:importdag",
        "//mutation:mutation",
        dev_requirement("mypy"),
        dev_requirement("pytest"),
    ],
)

sh_test(
    name = "mypy",
    srcs = ["@mikemol_check_mypy//:mypy_check.sh"],
    args = [
        "$(location :mypy_runner)",
        "$(location :pyproject.toml)",
    ],
    data = [
        "pyproject.toml",
        ":mypy_runner",
    ] + glob(["src/**/*.py", "tests/**/*.py"], allow_empty = True),
    size = "small",
    # ⚑ A GENEROUS TIMEOUT, NOT A TIGHT ONE (operator, 2026-09-24: "I hate wallclock-sensitive
    # things"). See //transcriptstruct:mypy for the measurement.
    timeout = "long",
)

venv_from_hub(
    name = ".venv",
    # ⚑ THE SAME ENTRIES AS pyproject's [project.scripts].
    console_scripts = {
        "mikemol-eval": "mikemol.mutantcell.eval:main",
        "mikemol-sites": "mikemol.mutantcell.sites:main",
    },
    hub_requirements = dev_all_requirements,
    python_version = "3.13.13",
    python_version_short = "3.13",
    # ⚑ THE TRANSITIVE CLOSURE: venv_from_hub takes each named target's own files, not its deps, so
    # importdag's own sibling (atomicwrite) is listed too (W566).
    srcs = glob(["src/mikemol/mutantcell/**"]) + [
        "//atomicwrite:atomicwrite",
        "//importdag:importdag",
        "//mutation:mutation",
    ],
)

# W376: this distribution's :venv (W342) and :suite (W362), declared together.
dist_checks()
