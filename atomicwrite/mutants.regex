# The defect classes this distribution DECLARES (mtools:W629), planted one at a time by the
# `:mutants` runner: <module>|<name>|<pattern>|<replacement>|<scope>. A line that stops matching is a
# STALE declaration and fails the grid as UNAPPLIED. Each is a claim durable.py's docstring makes
# about how a write commits bytes, and none moves a def, so none is a body-to-raise.

# Replace the PATH, never the inode: a write THROUGH the inode shows the new bytes to every hardlinked
# twin (a content-addressed dedup creates exactly that state), and a reader sees a torn file.
src/mikemol/atomicwrite/durable.py|replace-becomes-write-through|staged\.temp\.replace\(staged\.target\)|staged.target.write_bytes(staged.temp.read_bytes())|def=commit

# The target's permissions are PRESERVED: mkstemp creates at 0600, so without the chmod a replace
# silently NARROWS every file it touches.
src/mikemol/atomicwrite/durable.py|permissions-narrowed-to-0600|staged\.temp\.chmod\(keep\)|pass|def=stage

# A new file gets the process umask default, as open(path, "w") would; ignoring the umask opens it
# wider than the caller's process allows.
src/mikemol/atomicwrite/durable.py|new-file-ignores-the-umask|return _NEW_FILE_MODE & ~_umask\(\)|return _NEW_FILE_MODE|def=_keep_mode

# An existing file keeps ITS mode, not the new-file default.
src/mikemol/atomicwrite/durable.py|existing-mode-ignored|return path\.stat\(\)\.st_mode & _MODE_BITS|return _NEW_FILE_MODE|def=_keep_mode

# If anything fails the temp is removed; left behind, a failed write litters the directory it was
# writing into.
src/mikemol/atomicwrite/durable.py|failed-write-leaves-its-temp|staged\.temp\.unlink\(\)|pass|def=discard

# ...in stage, when the staging itself fails (an interrupt included)...
src/mikemol/atomicwrite/durable.py|stage-failure-leaves-its-temp|        discard\(staged\)|        pass|def=stage

# ...and in write_atomic, when the commit fails.
src/mikemol/atomicwrite/durable.py|commit-failure-leaves-its-temp|        discard\(staged\)|        pass|def=write_atomic

# ...and the original exception propagates: swallowed, the caller is told a failed write succeeded.
src/mikemol/atomicwrite/durable.py|stage-failure-swallowed|^        raise$|        pass|def=stage

src/mikemol/atomicwrite/durable.py|commit-failure-swallowed|^        raise$|        pass|def=write_atomic

# ...on ANY failure, an interrupt included, not only an ordinary exception (mtools:W857: this was
# declared in treeio for its own copy and moves here with the code).
src/mikemol/atomicwrite/durable.py|stage-cleanup-only-on-exception|except BaseException:|except Exception:|def=stage

src/mikemol/atomicwrite/durable.py|commit-cleanup-only-on-exception|except BaseException:|except Exception:|def=write_atomic

# A staged temp is the one beside its target, named for it, so a leftover points at its owner.
src/mikemol/atomicwrite/durable.py|stage-returns-the-wrong-target|return staged$|return Staged(staged.temp, staged.temp)|def=stage

# Reading the umask must not change it (there is no read-only syscall): left at 0, every file the
# process creates afterwards is created world-writable.
src/mikemol/atomicwrite/durable.py|umask-left-changed|    os\.umask\(current\)|    pass|def=_umask

# Bytes are written as bytes: through the text branch they raise, or are mangled by an encoding.
src/mikemol/atomicwrite/durable.py|bytes-written-as-text|if isinstance\(data, bytes\):|if False:|def=_fill

# The bytes reach the disk before the rename (mtools:W857): without the flush a crash can leave the
# NEW name over a file whose data never arrived. One declaration per branch, since each is its own call.
src/mikemol/atomicwrite/durable.py|bytes-not-flushed-before-rename|os\.fsync\(fb\.fileno\(\)\)|pass|def=_fill

src/mikemol/atomicwrite/durable.py|text-not-flushed-before-rename|os\.fsync\(ft\.fileno\(\)\)|pass|def=_fill

# Text is UTF-8 by name: the locale's default encoding would write another file's bytes elsewhere.
src/mikemol/atomicwrite/durable.py|text-encoded-by-locale|os\.fdopen\(fd, "w", encoding="utf-8"\)|os.fdopen(fd, "w")|def=_fill
