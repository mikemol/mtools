# ⚑ MIRRORS //corpus:BUILD.bazel (an empty shipping hub) AND //icsstruct TARGET FOR TARGET; the
# rationale for each shape lives there, this file says only where it differs. `@pkgbuild_dev` is
# declared in MODULE.bazel beside this distribution's birth (mtools:W542, paperkit:W142).
load("@mikemol_rules_py//:dist.bzl", "dist_checks")
load("@mikemol_rules_py//:venv.bzl", "venv_from_hub")
load("@pkgbuild_dev//:requirements.bzl", dev_all_requirements = "all_requirements", dev_requirement = "requirement")
load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

exports_files([
    # ⚑ EXPORTED FOR `//hooks:test_bar_fires`, which globs `*/pyproject.toml` for the population.
    "pyproject.toml",
    "requirements.txt",
    "requirements-dev.txt",
    "uv.lock",
])

# ⚑ NO `deps`: the shipping hub is empty on purpose. `wheel build` imports setuptools lazily,
# and in a paperkit action the DECLARED backend is staged by the action, not by this library.
py_library(
    name = "pkgbuild",
    srcs = glob(["src/mikemol/pkgbuild/**/*.py"]),
    data = glob(["src/mikemol/pkgbuild/py.typed"], allow_empty = True),
    imports = ["src"],
    visibility = ["//visibility:public"],
)

# ⚑⚑⚑ ONE TARGET PER TEST MODULE, AND EACH IS A WITNESS. DIFFERS FROM THE SIBLINGS: test_wheel
# drives the real PEP 517 backend, so setuptools is a declared dev dependency of every test.
[
    py_test(
        name = src.removeprefix("tests/").removesuffix(".py"),
        srcs = [src, "@mikemol_rules_py//:pytest_main.py"] + glob(["tests/conftest.py"], allow_empty = True),
        main = "@mikemol_rules_py//:pytest_main.py",
        args = [
            "$(location " + src + ")",
            "-q",
            "--strict-markers",
            "--strict-config",
            "-o",
            "faulthandler_timeout=60",
            "-c",
            "$(location pyproject.toml)",
        ],
        data = ["pyproject.toml"],
        size = "small",
        deps = [
            ":pkgbuild",
            dev_requirement("pytest"),
            dev_requirement("mypy"),
            dev_requirement("setuptools"),
        ],
        imports = ["src"],
    )
    for src in glob(["tests/test_*.py"])
]

exports_files(["BUILD.bazel"])

sh_test(
    name = "ruff",
    srcs = ["@mikemol_check_ruff//:ruff_check.sh"],
    args = [
        "$(location @mikemol_check_ruff//:bin)",
        "$(location :pyproject.toml)",
    ] + ["$(location " + f + ")" for f in glob(["src/**/*.py", "tests/**/*.py"])],
    data = [
        "pyproject.toml",
        "@mikemol_check_ruff//:bin",
    ] + glob(["src/**/*.py", "tests/**/*.py"]),
    size = "small",
)

# ⚑ THE BASELINE IS MINTED EMPTY: the distribution enters clean under preview, so the ratchet
# can only hold it there.
sh_test(
    name = "ratchet",
    srcs = ["@mikemol_check_ratchet//:ratchet_check.sh"],
    args = [
        "$(location //ratchet:ratchet_cli)",
        "$(location @mikemol_check_ruff//:bin)",
        "$(location :pyproject.toml)",
    ],
    data = [
        "pyproject.toml",
        "ratchet-preview.txt",
        "//ratchet:ratchet_cli",
        "@mikemol_check_ruff//:bin",
    ] + glob(["src/**/*.py", "tests/**/*.py"]),
    size = "small",
)

sh_test(
    name = "mutants",
    srcs = ["@mikemol_check_mutants//:mutate_check.sh"],
    args = [
        "$(location :pyproject.toml)",
        "$(location @mikemol_check_mutants//:mutate_runner.py)",
    ],
    data = [
        "pyproject.toml",
        ":.venv",
        "//fence:fence",
        "//mutation:mutation",
        "@mikemol_check_mutants//:mutate_runner.py",
    ] + glob(["src/**/*.py", "tests/**/*.py"]),
    size = "medium",
)

# ⚑ ONE py_binary PER TOOL, so a paperkit action runs each as a DECLARED tool by label (rules_python
# resolves by layout, with no sys.path and no script directory beside the module). paperkit's
# calc.bzl:379 PkWheel action needs `python -P` ONLY when it runs wheel.py BY PATH; see README.
py_binary(
    name = "wheel",
    srcs = ["src/mikemol/pkgbuild/wheel.py"],
    main = "src/mikemol/pkgbuild/wheel.py",
    imports = ["src"],
    visibility = ["//visibility:public"],
    deps = [":pkgbuild"],
)

py_binary(
    name = "pyc",
    srcs = ["src/mikemol/pkgbuild/pyc.py"],
    main = "src/mikemol/pkgbuild/pyc.py",
    imports = ["src"],
    visibility = ["//visibility:public"],
    deps = [":pkgbuild"],
)

py_binary(
    name = "pyinfo",
    srcs = ["src/mikemol/pkgbuild/pyinfo.py"],
    main = "src/mikemol/pkgbuild/pyinfo.py",
    imports = ["src"],
    visibility = ["//visibility:public"],
    deps = [":pkgbuild"],
)

py_binary(
    name = "mypy_runner",
    srcs = ["@mikemol_check_mypy//:mypy_runner.py"],
    main = "@mikemol_check_mypy//:mypy_runner.py",
    deps = [
        dev_requirement("mypy"),
        dev_requirement("pytest"),
    ],
)

sh_test(
    name = "mypy",
    srcs = ["@mikemol_check_mypy//:mypy_check.sh"],
    args = [
        "$(location :mypy_runner)",
        "$(location :pyproject.toml)",
    ],
    data = [
        "pyproject.toml",
        ":mypy_runner",
    ] + glob(["src/**/*.py", "tests/**/*.py"], allow_empty = True),
    size = "small",
    # ⚑ A GENEROUS TIMEOUT, NOT A TIGHT ONE (operator, 2026-09-24: "I hate wallclock-sensitive
    # things"). See //transcriptstruct:mypy for the measurement.
    timeout = "long",
)

venv_from_hub(
    name = ".venv",
    # ⚑ THE SAME ENTRIES AS pyproject's [project.scripts].
    console_scripts = {
        "mikemol-wheel": "mikemol.pkgbuild.wheel:main",
        "mikemol-pyc": "mikemol.pkgbuild.pyc:main",
        "mikemol-pyinfo": "mikemol.pkgbuild.pyinfo:main",
    },
    hub_requirements = dev_all_requirements,
    python_version = "3.13.13",
    python_version_short = "3.13",
    srcs = glob(["src/mikemol/pkgbuild/**"]),
)

# W376: this distribution's :venv (W342) and :suite (W362), declared together.
dist_checks()
