#
# The defect classes this distribution DECLARES (mtools:W629), planted one at a time by the
# `:mutants` runner: <module>|<name>|<pattern>|<replacement>|<scope>. A line that stops matching is a
# STALE declaration and fails the grid as UNAPPLIED.

# W669: a warrant's check command names the LAYOUT's interpreter. Hardcoding the distribution's
# `.venv` there writes a command that is wrong for the repository root, and every entry still looks
# well formed.
src/mikemol/hooks/gen_warrants.py|check-ignores-the-layout-runner|cmd:\{spec\.layout\.runner\}|cmd:.venv/bin/python3|def=_entry

# W587: one parser decides what a command is, and only a `git` program is read for --no-verify. The
# filter inverted refuses everything that is NOT git and lets every real bypass through.
src/mikemol/hooks/no_verify.py|program-filter-inverted|if program != "git":|if program == "git":|def=findings

# W621: `inbound-asks --check` exits 1 when a piece is missing; an exit that never fails reports a
# broken install as fine to every caller that reads the status.
src/mikemol/hooks/inbound_asks.py|check-exit-never-fails|return 0 if ok else 1|return 0|def=check_main

# W868: a file that exists is judged AT its real path (mypy --shadow-file), so a relative import
# resolves. Dropping the existence test shadows a path with nothing behind it for a new file, which
# the recorded-limit witness would see change.
src/mikemol/hooks/checkers.py|shadow-without-existing-file|real\.is_file\(\) and not|not|def=mypy_subject

# W830: the failure hook notes an open gate card and writes nothing else. Dropping the queue test
# calls the CLI in a repo with no queue; dropping the bound lets an unbounded report into every
# payload that names the card.
src/mikemol/hooks/build_failure.py|note-without-a-queue|if state.is_file\(\) else None|if True else None|def=note_gate_card
src/mikemol/hooks/build_failure.py|note-unbounded|report\[:NOTE_CHARS\]|report|def=note_gate_card

# W845: an unknown flag is a usage error, not a repository name. Dropping the guard reads `--help`
# as the repo `~/github/--help` and fails in git with exit 3 instead of printing the usage.
src/mikemol/hooks/snapshot.py|flag-read-as-a-repo|names\[0\]\.startswith\("-"\)|False|def=main

# W898: the hooks probe passes a gate only when it DENIES, from the root AND from elsewhere, armed.
# Reading any decision as success passes an inert guard; dropping the foreign directory passes a
# launcher that resolves from the cwd; unarming the gate reads its advisory as silence; ending 0
# whatever the rows said hides every failure; an unknown gate name must not pass over zero rows.
src/mikemol/hooks/probe.py|any-decision-passes|self\.decision == DENY|self.decision is not None|def=Verdict.ok
src/mikemol/hooks/probe.py|foreign-directory-dropped|\(\("root", project\), \("foreign", foreign\)\)|(("root", project),)|def=probe
src/mikemol/hooks/probe.py|gate-unarmed|ARM: "1",|ARM: "0",|def=fire
src/mikemol/hooks/probe.py|exit-zero-whatever-the-rows-said|return 0 if all\(v\.ok for v in verdicts\) else EXIT_FAILED|return 0|def=main
src/mikemol/hooks/probe.py|unknown-gate-passes|if unknown:|if False:|def=main
src/mikemol/hooks/probe.py|empty-decision-is-a-decision|or None$|or ""|def=decision_of

# W910: the commit claim is taken by the commit itself, keyed on the repository it commits. A nested
# call must not wait on its own parent; the host's budget variables must be restored (not the other
# way round); the load gate must stay off and an override of the wait must be honoured.
src/mikemol/hooks/commit_kata.py|nested-call-waits-on-itself|if env\.get\(HELD_ENV\):|if False:|def=claim_of
src/mikemol/hooks/commit_kata.py|restore-and-removal-swapped|for name in BUDGET if name not in env for part|for name in BUDGET if name in env for part|def=claim_of
src/mikemol/hooks/commit_kata.py|load-gate-left-on|held\["MEMBUDGET_MAXLOAD"\] = "0"|held["MEMBUDGET_MAXLOAD"] = "1"|def=claim_of
src/mikemol/hooks/commit_kata.py|lease-wait-gets-a-deadline|held\.pop\("MEMBUDGET_TIMEOUT", None\)|held["MEMBUDGET_TIMEOUT"] = "3600"|def=claim_of

# W924: the verdict says whether the sha is on origin/main. Always PUSHED hides an unpushed commit;
# skipping the no-ref test reports a repository with no remote as LOCAL.
src/mikemol/hooks/commit_kata.py|always-pushed|return f"\{MISMATCH_MARK\} remote=\{remote\[:SHORT\]\}" if tracked else "LOCAL: not on origin/main"|return "PUSHED"|def=published
src/mikemol/hooks/commit_kata.py|no-remote-reads-local|if ref\.returncode != 0:|if False:|def=published

# W925: a prune drops the rubric rows that have no warrant left, by the pairing gate's own rule, and
# nothing else. Keeping every row leaves the gate refusing; dropping every row empties a rubric;
# counting a section named inside a title would keep a row that has no warrant.
src/mikemol/hooks/gen_warrants.py|empty-rows-kept|if key is not None and key not in present:|if False:|def=prune_rubric
src/mikemol/hooks/gen_warrants.py|every-row-dropped|if key is not None and key not in present:|if key is not None:|def=prune_rubric

# W927: a relative launcher is resolved against the project. Dropping the resolution makes every
# foreign-directory row of a relative launcher fail with 'No such file or directory'.
src/mikemol/hooks/probe.py|relative-launcher-not-resolved|if "/" in argv\[0\] and not Path\(argv\[0\]\)\.is_absolute\(\):|if False:|def=fire

# W928: run_git waits on the git process itself, with its output in files, and bounds the wait.
