# ⚑ THE LOCK IS EXPORTED, NOT A TARGET. `pip.parse` in MODULE.bazel reads this file by LABEL at
# module-extension evaluation time, which is before any target in this package is built — so what
# is needed here is visibility of the file, not a rule producing it.
#
# ⚑ py_library and py_test are DELIBERATELY ABSENT for now. Adding them raises the dev-group
# question this repo has not settled: the shipping lock excludes the dev group, so the hub cannot
# supply pytest, while MODULE.bazel's thesis is that "a pytest case and a paperkit witness are the
# same object". A witness action needs pytest staged; a consumer-facing lock should not ship a
# test runner. Wiring test targets before that is answered would bake one side in silently.
exports_files(["requirements.txt"])
