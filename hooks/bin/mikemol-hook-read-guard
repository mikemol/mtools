#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
# Copyright (c) 2026 Mike Mol
#
# W814: PreToolUse(Read) denies a whole-file read of an oversized file, naming the cheaper read. The
# logic is mikemol.hooks.read_guard; this launcher is the stable path the harness's settings name.
#
# ⚑ FAIL OPEN, AND THIS IS A DELIBERATE DEPARTURE from the other PreToolUse launchers. They deny when
# their venv is missing because a missing guard would silently ALLOW the act it guards (a gate
# bypass, a wrong edit). The act guarded here is a large read, whose worst case is a flooded
# context. Denying every Read until the venv is rebuilt would stop the one tool needed to diagnose a
# broken venv, a far worse failure than the one guarded against. So an unbuilt venv is a note on
# stderr and exit 0.
#
# ⚑ THE REAL PATH, NOT `bazel-bin`: CPython reached through the convenience symlink prints
# "Could not find platform dependent libraries" on every call; the same venv by its real path is
# silent (see mikemol-hook-no-verify).
set -uo pipefail

root="${CLAUDE_PROJECT_DIR:-}"
entry="$(basename "$0")"
if [ -z "$root" ]; then
    echo "$entry: CLAUDE_PROJECT_DIR is unset; not checked" >&2
    exit 0
fi

venv="$root/bazel-bin/hooks/.venv"
if [ ! -x "$venv/bin/python3" ] || [ ! -f "$venv/bin/$entry" ]; then
    echo "$entry: the hook venv is not built (bazel build //hooks:.venv); not checked" >&2
    exit 0
fi

real="$(realpath "$venv")"
exec "$real/bin/python3" "$real/bin/$entry" "$@"
