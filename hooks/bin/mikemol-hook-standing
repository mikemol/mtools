#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
# Copyright (c) 2026 Mike Mol
#
# W231: enforce the operator's standing rules (hooks/policy/standing.rego) at PreToolUse.
# W238: the payload on stdin first passes through mikemol.hooks.standing_facts, which adds
# `input.facts` (the index, the queue's human holds, the ratchet baseline's size) that the (b)
# rules read; the result is the OPA input, and `decision` is the harness's deny JSON or undefined.
#
# ⚑ FAIL CLOSED: if opa is absent, the facts step fails, or the eval errors, DENY with the reason.
# A hook that cannot run exits 0 with no decision, which the harness reads as ALLOW (see
# mikemol-hook-no-verify).
# STANDING_PYTHON and OPA_BIN name the interpreter and opa; they default to the dist venv's
# python and `opa` on PATH, and exist so the witnesses can run this launcher in a sandbox.
set -euo pipefail

root="${CLAUDE_PROJECT_DIR:?CLAUDE_PROJECT_DIR is unset — the harness did not supply a project}"
policy="$root/hooks/policy/standing.rego"
python="${STANDING_PYTHON:-$root/hooks/.venv/bin/python3}"
opa="${OPA_BIN:-opa}"

refuse() {
    printf '{"hookSpecificOutput": {"hookEventName": "PreToolUse", "permissionDecision": "deny", "permissionDecisionReason": "standing-rule hook could not run (%s); refusing rather than failing open"}}\n' "$1"
    exit 0
}

command -v "$opa" >/dev/null || refuse "opa not on PATH"
[ -f "$policy" ] || refuse "no policy at hooks/policy/standing.rego"
[ -x "$python" ] || refuse "no interpreter for the facts step at $python"

if ! input="$("$python" -m mikemol.hooks.standing_facts 2>/dev/null)"; then
    refuse "the facts step failed"
fi

if ! out="$(printf '%s' "$input" | "$opa" eval --stdin-input --format raw --data "$policy" 'data.mtools.hook.decision')"; then
    refuse "opa eval failed"
fi
printf '%s' "$out"
