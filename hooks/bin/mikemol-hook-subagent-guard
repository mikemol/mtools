#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
# Copyright (c) 2026 Mike Mol
#
# W1275: PreToolUse(Agent) refuses a second concurrent subagent of the same session unless the
# operator's latest words authorise it (the no-swarming rule, operator 2026-10-15). The logic is
# mikemol.hooks.subagent_guard; this launcher is the stable path the harness's settings name.
#
# ⚑ FAIL OPEN: a missing venv is a note on stderr and exit 0, because a guard that cannot start
# must not stop the work, and the rule stays what it was before this hook, a rule in the prompt.
#
# ⚑ THE REAL PATH, NOT `bazel-bin` (see mikemol-hook-read-guard), and NOTHING RUN FROM bazel-bin
# REWRITES A .pyc IN IT (W1032).
set -uo pipefail
export PYTHONDONTWRITEBYTECODE=1

root="${CLAUDE_PROJECT_DIR:-}"
entry="$(basename "$0")"
if [ -z "$root" ]; then
    echo "$entry: CLAUDE_PROJECT_DIR is unset; the subagent guard did not run" >&2
    exit 0
fi

venv="$root/bazel-bin/hooks/.venv"
if [ ! -x "$venv/bin/python3" ] || [ ! -f "$venv/bin/$entry" ]; then
    echo "$entry: the hook venv is not built (bazel build //hooks:.venv); the guard did not run" >&2
    exit 0
fi

real="$(realpath "$venv")"
exec "$real/bin/python3" "$real/bin/$entry" "$@"
