#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
# Copyright (c) 2026 Mike Mol
#
# ⚑ A TRACKED LAUNCHER AT A STABLE PATH FOR `mikemol-commit` (mtools:W796), the way the hook
# launchers beside it are. The console script exists only inside the built venv under `bazel-bin`,
# a convenience symlink into an output base that `bazel clean` deletes; a caller that names the
# artifact directly (the host katas) would break on a routine command. The dev venv `hooks/.venv`
# carries a stale set of scripts and has no `mikemol-commit`, so it is not an answer either.
#
# ⚑ IT RESOLVES THE REAL PATH, for the reason the hook launchers do: CPython reached through the
# convenience symlink prints a platform-libraries warning on every run.
#
# ⚑ ABSENCE IS A REFUSAL WITH THE REPAIR NAMED, never silence: a commit that did not happen must not
# read as one that did (the kata's whole point is one line saying what happened).
#
# ⚑⚑ THE LAUNCHER NAMES THE FENCE; THE COMMIT TAKES THE CLAIM (W886, W910). A blocking per-repository
# mutex serialises two committers instead of letting them collide on git's index.lock, and it is
# fence's own claim. It used to be taken HERE, keyed on this checkout, so a paperkit gate held every
# mtools commit behind it. The repository being committed is only known once the command line is
# read, so the claim is taken in `commit_kata.main`, which finds the repository and re-execs itself
# under `mikemol-membudget hold 0 claim:path:<that git dir>/mtools/commit`. All this launcher does is
# export where the fence is (an unbuilt fence is a stderr note from the commit, and the commit runs
# unlocked, as before the lock existed).
set -euo pipefail
# ⚑ W1032: NOTHING RUN FROM bazel-bin REWRITES A .pyc IN IT (a hook per tool call raced bazel test).
export PYTHONDONTWRITEBYTECODE=1

root="${MIKEMOL_ROOT:-$(cd "$(dirname "$0")/../.." && pwd)}"
venv="$root/bazel-bin/hooks/.venv"

if [ ! -x "$venv/bin/python3" ] || [ ! -f "$venv/bin/mikemol-commit" ]; then
    echo "NOT COMMITTED: the hooks venv is not built; run 'bazel build //hooks:.venv' in $root" >&2
    exit 1
fi

fence="$root/bazel-bin/fence/.venv/bin/mikemol-membudget"
if [ -x "$fence" ]; then
    export MIKEMOL_FENCE_BIN="$fence"
fi

real="$(realpath "$venv")"

# ⚑⚑ A STALE VENV FAILS AT IMPORT, AND A BARE TRACEBACK DOES NOT SAY WHAT TO DO (W1183). The venv's
# `commit_kata.py` is the working tree's file while its module list is whatever the last
# `bazel build //hooks:.venv` staged, so an edit that imports a NEW module kills the next commit
# before any gate runs (W1164 and W1168, twice). Importing the entry module here turns that into
# the same refusal as an absent venv: one NOT COMMITTED line, the last line of the failure, and the
# repair. It costs one import and changes nothing when the venv is whole.
if ! _probe="$("$real/bin/python3" -c 'import mikemol.hooks.commit_kata' 2>&1)"; then
    echo "NOT COMMITTED: the hooks venv cannot start mikemol-commit; run 'bazel build //hooks:.venv' in $root" >&2
    printf '%s\n' "$_probe" | tail -n 1 >&2
    exit 1
fi

exec "$real/bin/python3" "$real/bin/mikemol-commit" "$@"
