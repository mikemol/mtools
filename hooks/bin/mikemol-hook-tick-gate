#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
# Copyright (c) 2026 Mike Mol
#
# W812: the UserPromptSubmit tick gate. The logic is mikemol.hooks.tick_gate; this launcher is the
# stable path the harness's settings name.
#
# ⚑ FAIL OPEN, AND THAT IS THE RIGHT DIRECTION HERE. The PreToolUse launchers deny when their venv is
# missing because a missing guard would silently allow the act it guards. This hook guards nothing
# the user typed: it refuses only the loop's own tick prompt, and only when the machine cannot do
# the work. If it cannot run, blocking would refuse EVERY prompt the user sends, which is a far worse
# failure than letting one tick prompt through to say the same thing at the cost of a turn. So an
# unbuilt venv is a note on stderr and exit 0.
#
# ⚑ THE REAL PATH, NOT `bazel-bin`: CPython reached through the convenience symlink prints
# "Could not find platform dependent libraries" on every call; the same venv by its real path is
# silent (see mikemol-hook-no-verify).
set -uo pipefail

root="${CLAUDE_PROJECT_DIR:-}"
entry="$(basename "$0")"
if [ -z "$root" ]; then
    echo "tick-gate: CLAUDE_PROJECT_DIR is unset; not checked" >&2
    exit 0
fi

venv="$root/bazel-bin/hooks/.venv"
if [ ! -x "$venv/bin/python3" ] || [ ! -f "$venv/bin/$entry" ]; then
    echo "tick-gate: the hook venv is not built (bazel build //hooks:.venv); not checked" >&2
    exit 0
fi

real="$(realpath "$venv")"
exec "$real/bin/python3" "$real/bin/$entry" "$@"
