#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
# Copyright (c) 2026 Mike Mol
#
# W815: SessionEnd releases the host tick lock, through the one writer, if this session still holds
# it. The logic is mikemol.hooks.tick_release; this launcher is the stable path the harness's
# settings name.
#
# ⚑ FAIL OPEN, ALWAYS. A SessionEnd hook runs as the session closes, inside a shared 1.5 s budget,
# and has nothing to refuse. An unbuilt venv is a note on stderr and exit 0: the lock is then left
# held, which is the state before this hook existed and which the next `tick begin` handles (it
# takes over a lock older than thirty minutes).
#
# ⚑ THE REAL PATH, NOT `bazel-bin`: CPython reached through the convenience symlink prints
# "Could not find platform dependent libraries" on every call; the same venv by its real path is
# silent (see mikemol-hook-no-verify).
set -uo pipefail

root="${CLAUDE_PROJECT_DIR:-}"
entry="$(basename "$0")"
if [ -z "$root" ]; then
    echo "$entry: CLAUDE_PROJECT_DIR is unset; nothing released" >&2
    exit 0
fi

venv="$root/bazel-bin/hooks/.venv"
if [ ! -x "$venv/bin/python3" ] || [ ! -f "$venv/bin/$entry" ]; then
    echo "$entry: the hook venv is not built (bazel build //hooks:.venv); nothing released" >&2
    exit 0
fi

real="$(realpath "$venv")"
exec "$real/bin/python3" "$real/bin/$entry" "$@"
