#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
# Copyright (c) 2026 Mike Mol
#
# W1475: PostToolUse and PostToolUseFailure leave the session heartbeat the idle watchdog reads, so
# every tool call is a beat (the operator's rule: using the tooling is the heartbeat). The logic is
# mikemol.hooks.beat_hook; this launcher is the stable path the harness's settings name.
#
# ⚑ FAIL OPEN AND SILENT-ISH: a missing venv is a note on stderr and exit 0, because a heartbeat
# hook that blocked or failed a tool call would stop the work it exists to witness. The cost is a
# watchdog that sees fewer beats, which W1508 already reads as silence rather than as health.
#
# ⚑ THE REAL PATH, NOT `bazel-bin` (see mikemol-hook-read-guard), and NOTHING RUN FROM bazel-bin
# REWRITES A .pyc IN IT (W1032): a hook on every tool call would otherwise race `bazel test`.
set -uo pipefail
export PYTHONDONTWRITEBYTECODE=1

root="${CLAUDE_PROJECT_DIR:-}"
entry="$(basename "$0")"
if [ -z "$root" ]; then
    echo "$entry: CLAUDE_PROJECT_DIR is unset; no beat left" >&2
    exit 0
fi

venv="$root/bazel-bin/hooks/.venv"
if [ ! -x "$venv/bin/python3" ] || [ ! -f "$venv/bin/$entry" ]; then
    echo "$entry: the hook venv is not built (bazel build //hooks:.venv); no beat left" >&2
    exit 0
fi

real="$(realpath "$venv")"
exec "$real/bin/python3" "$real/bin/$entry" "$@"
