#!/usr/bin/env bash
# SPDX-License-Identifier: Apache-2.0
# Copyright (c) 2026 Mike Mol
#
# W829: PostToolUseFailure(Bash) puts a failed build's reason, read from BuildBuddy, into context. The
# logic is mikemol.hooks.build_failure; this launcher is the stable path the harness's settings name.
#
# ⚑ FAIL OPEN: the hook only ADDS context after a command has already failed, so an unbuilt venv is a
# note on stderr and exit 0. Exit 2 is this hook's REPORT channel (the harness feeds stderr back to
# the model), so a launcher that exited 2 for a missing venv would pass off its own breakage as a
# build failure's cause.
#
# ⚑ THE REAL PATH, NOT `bazel-bin`: CPython reached through the convenience symlink prints
# "Could not find platform dependent libraries" on every call; the same venv by its real path is
# silent (see mikemol-hook-no-verify).
set -uo pipefail

root="${CLAUDE_PROJECT_DIR:-}"
entry="$(basename "$0")"
if [ -z "$root" ]; then
    echo "$entry: CLAUDE_PROJECT_DIR is unset; not checked" >&2
    exit 0
fi

venv="$root/bazel-bin/hooks/.venv"
if [ ! -x "$venv/bin/python3" ] || [ ! -f "$venv/bin/$entry" ]; then
    echo "$entry: the hook venv is not built (bazel build //hooks:.venv); not checked" >&2
    exit 0
fi

# ⚑ W830: THE HOOK APPENDS ITS REPORT TO AN OPEN GATE CARD THROUGH `mikemol-paths-forward`, which in
# this checkout lives in pathsforward/.venv, not a root .venv, so its bin directory is put on PATH,
# as the inbound-asks launcher does for the same reader. An absent reader is a silent skip.
export PATH="$root/pathsforward/.venv/bin:$PATH"

real="$(realpath "$venv")"
exec "$real/bin/python3" "$real/bin/$entry" "$@"
