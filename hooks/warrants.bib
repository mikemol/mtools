% warrants.bib — one claim PER TEST CASE in the hooks suite.
%
% The claim text is TRANSCRIBED from each test function's own docstring, whose flagged
% paragraphs already argue the defect the case prevents.  Where a docstring is a bare
% one-liner the claim is correspondingly plain; that thinness is a fact about the case
% rather than something invented over.
%
% Keying convention: hooks-<module>-<test name minus its `test_` prefix, hyphenated,
% with leading articles dropped>.  Each check runs that one test function.
%
% Section keys are the source module: one section per tests/test_*.py.

% ---------------------------------------------------------------- payload

@misc{hooks-payload-mapping-rebuilt-with-string-keys,
  section = {payload},
  claim   = {A record's keys become strings and its values survive},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_payload.py -k test_a_mapping_is_rebuilt_with_string_keys}
}

@misc{hooks-payload-non-mapping-is-empty-record,
  section = {payload},
  claim   = {EVERY non-mapping shape reads as an empty record --- not just null, but text, integers, lists and tuples --- because the payload is UNTRUSTED JSON},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_payload.py -k test_a_non_mapping_is_an_empty_record}
}

@misc{hooks-payload-string-reads-as-itself,
  section = {payload},
  claim   = {Text passes through unchanged},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_payload.py -k test_a_string_reads_as_itself}
}

@misc{hooks-payload-non-string-reads-as-empty,
  section = {payload},
  claim   = {A non-string field yields EMPTY TEXT rather than a repr of the value},
  note    = {The assertion compares against a named empty-string constant rather than testing the
            result for falsiness, and that is load-bearing rather than stylistic. A preview rule
            reports the equality as simplifiable to a falsiness test, which is satisfied by None,
            by zero and by an empty list — so the rewrite would keep this case passing if the
            function began returning any of them, and the case exists to pin the empty STRING.
            Four forms were measured against two properties before one was chosen, because the
            form eventually used had been proposed while explicitly marked unmeasured. The
            falsiness test silences the rule and does not preserve the predicate. An isinstance
            conjunction preserves the predicate and does NOT silence the rule, which was the
            unmeasured guess and was wrong: the rule reads the equality half regardless of what is
            conjoined to it. Comparing the length to zero silences the rule and rejects None and
            zero with a type error, but accepts an empty list and an empty dict, which the
            equality rejects — a different set of false accepts rather than a smaller one, and
            calling it strictly stronger would have been a claim worth one probe. Comparing
            against a named constant silences the rule and preserves the predicate exactly,
            because it is the same predicate with the literal named. Verified against the live
            function rather than a fixture: weakening the return to None makes all four
            parametrised cases fail, where under the rule's own fix all four would have passed.},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_payload.py -k test_a_non_string_reads_as_empty}
}

@misc{hooks-payload-own-switch-arms,
  section = {payload},
  claim   = {The hook's own switch set to the exact arming value arms it},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_payload.py -k test_the_own_switch_arms}
}

@misc{hooks-payload-own-switch-wins-over-shared,
