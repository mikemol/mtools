@misc{hooks-bar-mypy-path-pair-is-present,
  section = {bar-fires},
  claim   = {Both `mypy_path` and `explicit_package_bases` are set, or neither is. EITHER ONE ALONE LEAVES A WORKING-LOOKING CONFIG THAT CHECKS THE WRONG THING --- `mypy_path` alone makes the source reachable under two names so a module can be checked twice under different identities, and `explicit_package_bases` alone does not make it reachable at all. The sibling distribution once had the wrong half and reported 14 errors, 13 of them Any, while its 90 tests passed. ⟡mtools-drop-mypypath asserted the pair was TEMPORARY, awaiting bazel runfiles; measured against a fresh NON-EDITABLE install with both lines deleted, mypy passes cleanly on hooks and ratchet and needs only the `stubs` half on mdstruct --- so the variable is the EDITABLE INSTALL rather than the build system, and retiring the pair would mean a reinstall before any checker saw an edit. The ticket is closed won't-fix, and this arm is what stops a future reader deleting the pair on the strength of its premise},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_bar_fires.py -k test_the_mypy_path_pair_is_present_and_both_halves_are_set}
}

@misc{hooks-bar-bazel-runs-pytest-not-the-module,
  section = {bar-fires},
  claim   = {Every py_test names the pytest entry point as `main`, not the test module. `main = <the test module>` RUNS THAT MODULE AS A SCRIPT --- import-time code executes, pytest never collects, and the process exits 0, so every target reported GREEN OVER ZERO ASSERTIONS. Measured: a module whose only statement was `raise AssertionError` PASSED under bazel, across all 23 targets, for the life of the rule. It is asserted by READING THE BUILD FILES rather than from inside the suite, because the suite cannot see it: a broken runner reports success, so no witness inside it can fail --- the defect is invisible from exactly the place one would look for it, and only a probe designed to fail could reveal it},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_bar_fires.py -k test_the_bazel_test_rule_runs_pytest_rather_than_the_module}
}

@misc{hooks-bar-gates-own-shell-is-checked,
  section = {bar-fires},
  claim   = {`.githooks/pre-commit` and the checker script are BOTH in a shellcheck target. THE SHELL THAT RUNS EVERY OTHER CHECK WAS ITSELF CHECKED BY NOTHING --- it was clean only because its author ran shellcheck by hand after each edit, a convention held in one person's memory, guarding the file that guards everything else. AND THE CHECKER'S OWN SCRIPT IS IN THE SAME LIST, because a gate that checks every shell file except itself leaves exactly the one nobody would think to look at, for the same reason nobody checked the hook. Both are asserted rather than assumed from the BUILD file being present, because a `data` entry that is not also an `args` entry stages a file the checker never opens. The binary is a hash-pinned http_archive at the host's own version, and the script REFUSES when either the binary or a target is unstaged rather than skipping --- a skip there would report green over a check that never ran},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_bar_fires.py -k test_the_gates_own_shell_is_checked}
}
