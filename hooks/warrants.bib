  claim   = {An explicit zero on the hook's OWN switch DISARMS it even while the shared switch is on --- set-to-zero is a DECISION, not an absence. Otherwise a repo cannot opt one hook out of a fleet-wide arming, and the only way to quiet one is to disarm all of them},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_payload.py -k test_the_own_switch_wins_over_the_shared_one}
}

@misc{hooks-payload-shared-switch-arms-when-own-unset,
  section = {payload},
  claim   = {With no own switch set, the SHARED switch decides},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_payload.py -k test_the_shared_switch_arms_when_the_own_one_is_unset}
}

@misc{hooks-payload-neither-switch-is-disarmed,
  section = {payload},
  claim   = {With neither switch set the default is ADVISORY, asserted rather than assumed --- the positive control for the whole arming surface. Without this case every other arming case would pass against a function that returned armed UNCONDITIONALLY. That is the load-bearing shape of this whole module: a hook that reports itself armed while exiting zero detects every violation and refuses none, reading as armed in review and off in fact, which is strictly worse than being visibly disabled},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_payload.py -k test_neither_switch_is_disarmed}
}

@misc{hooks-payload-only-exact-value-arms,
  section = {payload},
  claim   = {ONLY the one exact spelling arms the hook: empty, zero, true, yes and two all leave it advisory. This is worth PINNING rather than discovering --- an operator who writes the block switch as true gets an ADVISORY hook. The behaviour is deliberate, one spelling and no truthiness table, and a test is the only place a reader learns it before an unrefused violation does},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_payload.py -k test_only_the_exact_value_arms}
}

@misc{hooks-payload-named-own-switch-is-read,
  section = {payload},
  claim   = {armed(own=...) reads the CALLER's switch, not the default hook's. The default OWN_SWITCH is one hook's (PYCHECK_HOOK_BLOCK); a second hook calling bare armed() would be armed and stood down by that variable with no error. Found by substrate's shellcheck letter (2026-09-22) before the shellcheck port could re-key its switch. Positive control in the same function: the default reader still sees its own 0},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_payload.py -k test_a_named_own_switch_is_read_instead_of_the_default}
}

@misc{hooks-payload-named-own-switch-zero-wins-over-shared,
  section = {payload},
  claim   = {Standing one hook down does not depend on another hook's switch: with the shared switch on, a named own switch set to 0 disarms that hook while the default hook, whose own switch is unset, stays armed through the shared one},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_payload.py -k test_a_named_own_switch_set_to_zero_wins_over_the_shared_one}
}

