@misc{hooks-bar-fires-the-sweep-states-the-share-of-arms-it-covers,
  title  = {The sweep covers a predicate shape, not arms, and said so nowhere},
  author = {Mike Mol},
  year   = {2026},
  section = {bar-fires},
  note   = {The sweep's floor counts assertions and its docstring says every assertion has a live
            positive by construction, both true --- but a green run had been read as covering the
            module, and measured it does not: of ninety-odd arms, roughly a fifth read no file at
            all because they run subprocess probes and have no haystack to be absent from,
            eighteen read a file the resolver cannot reach, and eight resolve but assert by regex
            or count. That is not a defect in the sweep, since a string-membership check cannot
            check a regex without becoming a different tool; what was missing is the scope
            statement, and a coverage figure read as covering the whole is the mis-named
            population this repository has measured eight times in its own checkers. The share is
            derived by the sweep rather than recorded, and floored below the measurement so reach
            may grow and cannot silently shrink; dropping a single resolver target takes it from
            fifty-two percent to thirty-six, which is exactly how a target once went missing. The
            previous tick's gain was also smaller than recorded: three of the five newly resolved
            arms carry no string-membership assertion at all.},
  check  = {pytest hooks/tests/test_bar_fires.py -k test_the_sweep_states_the_share_of_arms_it_covers},
}

@misc{hooks-bar-fires-the-brief-states-what-homing-grants-and-what-it-does-not,
  title  = {Four censuses were homed here by precedent, and precedent is what a peer must guess at},
  author = {Mike Mol},
  year   = {2026},
  section = {bar-fires},
  note   = {A fifth dispatcher asked to home a run file here and split the ask into hosting and
            ownership rather than assuming a standing grant covered it. They were right on both
            counts, and right that no grant covered it --- there was no written grant to read, and
            four censuses had landed by precedent alone. Hosting is this tree's to give and is now
            granted in writing, so a peer need not wait on a session that may not be running.
            Ownership of a census, meaning the status accounting and the freeze, belongs to
            whoever the operator put in that seat; a homing tree that assumed it because the file
            sits in its directory would be settling an ownership question by writing code, and a
            dispatcher who hands ownership away with the file gives away something that was not
            theirs either. The brief now states both the grant and its boundary, because a grant
            whose limit is unwritten reads as unlimited to whoever needs it to be.},
  check  = {pytest hooks/tests/test_bar_fires.py -k test_the_brief_states_what_homing_grants_and_what_it_does_not},
}

@misc{hooks-bar-fires-the-poll-does-not-carry-a-self-raised-decision-as-blocked,
  title  = {I carried a decision to the operator that I had raised myself and answered already},
  author = {Mike Mol},
  year   = {2026},
  section = {bar-fires},
  note   = {The operator asked why we were concerned about gate cost and there was no answer.
            The only commit raising it is mine, and its own finding is that no stable quantity
            exists: four runs on an unchanged tree read a decreasing series converging as the
            action cache warmed, while three checkers were added. The measurement dissolved the
            question it was then listed under, and nothing in the corpus records a consequence
            --- no refused commit, no bypass, no complaint that the gate is unaffordable. A
            decision with no consequence and no petitioner is not blocked on anyone; it is a
            measurement promoted to a standing ask and re-derived every tick as though the
            promotion were a fact. The defect is the promotion rather than the figure, so the
            poll now carries a petitioner column: a self-raised measurement and a request someone
            made are otherwise byte-identical in the symbol set, and one of them is not blocked
            at all. The property is held in the poll rather than in the filed leg, because a
            filed leg is not amended.},
