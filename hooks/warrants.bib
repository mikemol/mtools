@misc{hooks-bar-fires-the-citation-gate-checks-the-rules-file-against-itself,
  title  = {It checked every message against the rules file and never the file against itself},
  author = {Mike Mol},
  year   = {2026},
  section = {bar-fires},
  note   = {The citation gate exists because a pointer to nothing reads like a pointer, and the
            densest population of such pointers is the document doing the pointing. Measured: 31
            rules defined, 31 rule numbers named within the file, every intra-file reference
            resolving --- which is why arming it now costs no migration. Two defects surfaced
            while measuring the arm: exit 0 on the cites-no-rule path discarded the self-check's
            verdict, and 19 of the last 20 commits take that path, so the arm firing on nearly
            every commit threw its own result away; and the control matched a space-separated
            pattern against comm's newline-separated output, reporting itself broken on a corpus
            where it worked. The control runs on every invocation because a blinded comparison
            and a clean corpus both print nothing.},
  check  = {pytest hooks/tests/test_bar_fires.py -k test_the_citation_gate_checks_the_rules_file_against_itself},
}

@misc{hooks-bar-fires-the-structural-gate-discloses-an-empty-routing-table,
  title  = {An empty routing table allows every command, silently},
  author = {Mike Mol},
  year   = {2026},
  section = {bar-fires},
  note   = {The routing table resolves relative to the working directory, so the hook invoked
            without a .claude/skills tree reads zero claims and every textual read of every
            claimed artifact passes while the gate still reads as armed. Measured: from the
            hooks directory the table holds 0 entries and a plain grep of a claimed artifact
            returns a clean verdict; from the repo root it holds 1 and the same command refuses.
            That is the shape this hook exists to refuse and the shape this repository declined
            from a peer gate that printed SKIPPED and exited 0. It discloses rather than
            refusing, because blocking every command over the hook's own configuration is a
            worse failure than the one being repaired. Both arms measured through the console
            script; the module has no main guard, so running it as -m prints nothing.},
  check  = {pytest hooks/tests/test_bar_fires.py -k test_the_structural_gate_discloses_an_empty_routing_table},
}

@misc{hooks-bar-fires-every-shipped-hook-is-actually-invoked,
  title  = {Shipped, warranted 52:52, and invoked by nothing},
  author = {Mike Mol},
  year   = {2026},
  section = {bar-fires},
  note   = {no_chaining carried a rubric section, 52 test functions and 52 warrants --- an exact
            1:1 --- and settings.json wired only its sibling. Its own module docstring says so in
            the first paragraph and names three measurement errors the absent hook cost in a
            single session. A component with full coverage and no entry point is this
            repository's named defect, the packager not being a user of its own package, with
            every test passing: coverage measures whether the code is right and cannot measure
            whether anything runs it. The arm is over the population rather than this one hook,
            because a single-hook assertion would be the same defect one module later, and it
            carries a positive control since a regex that stopped matching would pass by finding
            nothing. It also asserts inline arming, which both peer repos measured independently:
            a session already running when the env block changes never picks it up.},
  check  = {pytest hooks/tests/test_bar_fires.py -k test_every_shipped_hook_is_actually_invoked},
}

@misc{hooks-bar-fires-a-module-with-no-local-caller-declares-who-consumes-it,
  title  = {An import count of zero is not evidence of disuse},
  author = {Mike Mol},
  year   = {2026},
  section = {bar-fires},
  note   = {Asking which modules have a caller found checker_context and project_root imported by
            no production source and no test in this repository. Two independent readers, regex
            and AST, agreed --- and both were right. A fleet sweep inverted the reading: each has
            eight importers across substrate, paperkit and summit, making them the most
            cross-repo-reused code in the distribution and the most clearly earned under the
            operator's membership criterion. The first fleet reader failed its own control and
            reported zero, because it required the module name inside a dotted path while the
            real shape puts it after import; that negative was a statement about the reader.
            Measured by hash, the peers import their own byte-different copies while this
            repository's are strictly ahead and unread, so the interning mtools exists to perform
            has not happened for its two most-reused modules. The divergence is not repaired
            here, because those trees belong to their owners; the arm holds only that a module
            with no local caller must say who consumes it, so the next reader does not read
            unused off an import count and delete it.},
  check  = {pytest hooks/tests/test_bar_fires.py -k test_a_module_with_no_local_caller_declares_who_consumes_it},
}

@misc{hooks-adoption-both-distributions-co-install-under-one-namespace,
  title  = {An assertion that passes when a distribution ships nothing is measuring the cwd},
  author = {Mike Mol},
  year   = {2026},
  section = {adoption},
  note   = {Both distributions omit an __init__ under src/mikemol so they can share the prefix,
            and nothing in this repository exercised that claim: every case installs one
            distribution. substrate carries an editable install of mikemol-mdstruct and resolves
            the namespace, so a peer already consumes this repo by package with exactly one
            sibling present --- the half that cannot fail. Four F-arms failed before the
            assertion was earned. A planted src/mikemol/__init__.py does not shadow, because the
            namespace-packages declaration excludes it from the built distribution; an explicit
            regular-package declaration does not shadow either, because the second install writes
            into the same site-packages directory. The fourth failure was the instrument: scoping
            the subpackage out entirely still imported, because the probe ran with the source
            tree reachable on sys.path and never consulted the installed distributions. With cwd
            set to the probe venv both editable and wheel installs go red, so that condition is
            passed explicitly rather than inherited from wherever pytest runs.},
  check  = {pytest hooks/tests/test_adoption.py -k test_both_distributions_co_install_under_one_namespace},
}

@misc{hooks-bar-fires-the-preflight-runs-the-ruff-the-gate-runs,
