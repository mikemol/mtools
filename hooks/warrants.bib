@misc{hooks-no-verify-the-post-commit-verifies-the-gate-ran-before-pushing,
  section = {no_verify},
  title  = {Two mechanisms, and they fail differently},
  claim  = {The pre tool use hook reads a command string and can be evaded by a spelling nobody
            enumerated. The post commit hook reads the result: a commit whose tree the gate never
            verified carries no witness, however it was produced. Neither mechanism subsumes the
            other, which is why both were ruled. The witness keys on the staged tree because it must,
            since the gate runs before the commit object exists and there is no revision to name
            yet, while the commit that follows carries the same tree the gate verified. The absence
            of the witness file and a tree missing from a present witness are different facts: the
            first says the gate has never run in this clone, which is a statement about the
            environment, and the second says it ran for other commits and not this one, which is the
            bypass. Collapsing them would be this repository's standing defect one layer out, so the
            hook reports them separately and refuses to push in either case.},
  check  = {cmd:.venv/bin/python3 -m pytest tests/test_no_verify.py -k test_the_post_commit_verifies_the_gate_ran_before_pushing},
}

@misc{hooks-bar-fires-partition-terms-and-total-from-different-measurements,
  section = {bar-fires},
  title  = {A partition's terms and its total must come from different measurements},
  claim  = {The rule that an asserted expression must print its components stops a hidden operand.
            It does not stop a partition whose terms all read zero because one failed match
            produced every one of them, and in that case the printed terms prove only that they
            agree with each other. Agreement among four readings of a single failure is not
            evidence. The bound was supplied by a peer against a rule they had just adopted from
            this tree, and they found it in their own instrument first: a figure line reading zero
            of at-least-zero, which is true of every population, a claim that cannot be wrong
            wearing the shape of a clean result, and whose floor notation made it look deliberate.
            Measuring the same shape here found a second defect underneath. On the build-hermeticity
            census all four state terms read zero while a prefix query for the shortest state
            returns fourteen rows at exit zero, so the reader parses that file perfectly. Every
            status row there carries a terminal state the four probes never enumerated, because the
            probes were written from the two censuses their author happened to be reading: a
            hand-written vocabulary inside the arm written to repair a hand-written population. The
            repair reads the total from the status table itself rather than summing the probes, and
            prints the remainder, so that the rows the probes could not classify are visible rather
            than absorbed into a zero. The all-zero case is reported as its own verdict ahead of the
            others because it explains them, in the same three-state discipline the unadjudicated
            branch already applies one axis over.},
  check  = {cmd:.venv/bin/python3 -m pytest tests/test_bar_fires.py -k test_a_partitions_terms_and_total_come_from_different_measurements},
}

@misc{hooks-bar-fires-unmatched-state-says-whether-the-census-declared-it,
  section = {bar-fires},
  title  = {A residue against a published list is a different fact from a residue against none},
  claim  = {Five of the eight censuses in this tree publish their own state vocabulary in a
            state-and-meaning table, and the poll's roster arm read none of them: its four state
            prefixes were written by hand from the two files their author happened to be reading.
            The declared union across the corpus is far wider, and two of the states it misses are
            load-bearing. One census annotates not-surveyed in its own table as reading like a zero
            when nobody was asked, so an arm blind to that state reports the absence of a survey as
            the absence of a finding, which is the single confusion the whole poll exists to
            refuse. The obvious repair was refused after measurement: adding the shortest state to
            the probe list would turn seven unnamed rows green on one census, but a prefix query for
            it returns eight of eight there because it also matches a longer declared state, so the
            declared states are not a partition and summing per-state probes double-counts in
            exactly the arithmetic that had already read fourteen against a twelve-row table. The
            row count measured from the table therefore remains the independent total, and what the
            repair adds is the diagnosis a residue needs in order to be actionable. The
            discriminator is whether the census published anything at all: an unmatched row in a
            census that declares its states is this reader failing to read a published list, while
            an unmatched row in one that declares nothing is a state nobody wrote down, and the two
            call for different repairs.},
  check  = {cmd:.venv/bin/python3 -m pytest tests/test_bar_fires.py -k test_an_unmatched_state_says_whether_the_census_declared_it},
}

@misc{hooks-bar-fires-poll-reads-each-census-against-its-own-vocabulary,
  section = {bar-fires},
  title  = {A shipped mode with no caller is the packager not using its own package},
  claim  = {The previous tick measured that five censuses publish their state vocabulary in a
            declared table, reported that the poll read none of them, and shipped a classify mode
            to close it, and then did not consume it. One tick later the poll's output was
            byte-identical: the same four hand-written prefixes and the same residue. This
            repository carries the named instance of that defect already, a hook with fifty-two
            tests and fifty-two warrants that the settings file invoked nowhere while its own
            docstring said so and the suite stayed green. The hand-written probes are kept rather
            than replaced, because three censuses publish no vocabulary at all and a classifier
            refuses those while the prefixes still report something, so deleting the fallback would
            trade a blind spot for a hole. The two readings answer different questions and are
            printed side by side rather than reconciled in the script, because reconciling them
            there would be judgement in the turn rather than a measurement a reader can check.
            Where they disagree is the finding, and they do: on one frozen census the prefixes
            report twelve rows carrying a state they do not name while the document's own
            vocabulary names eleven of those twelve, leaving one row that uses a state the census
            never declared. Only the document-relative reading can reveal that row, and the
            reader-relative line correctly reports its own blindness rather than the document's.},
  check  = {cmd:.venv/bin/python3 -m pytest tests/test_bar_fires.py -k test_the_poll_reads_each_census_against_its_own_declared_vocabulary},
}

@misc{hooks-bar-fires-vocabulary-reading-not-gated-on-divergence,
