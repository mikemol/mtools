@misc{hooks-bar-header-gate-fires-per-proposition,
  section = {bar-fires},
  claim   = {ONE ARM PER PROPOSITION, NOT PER RULE. `notice-rgx` asserts presence of both lines, their ORDER, their ADJACENCY and the HOLDER --- four claims in one regex --- so six arms exercise them separately. A CONFIGURED-BUT-INERT GATE IS THE EASY CASE: it fires on nothing and someone eventually notices. AN ACTIVE GATE AIMED AT THE WRONG PREDICATE IS THE HARD CASE, because it produces findings, passes review, and its greens are indistinguishable from correct ones. This repo and a peer were MIRROR IMAGES of exactly that --- one regex matched the SPDX line only, the other's default matched Copyright only, so neither gated both and each party ran the arm its own config would pass. VERIFIED BY MUTATION: reverting the regex to its SPDX-only form fails five of these arms},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_bar_fires.py -k test_the_header_gate_fires_when_a_proposition_fails}
}

