  author = {Mike Mol},
  year   = {2026},
  section = {bar-fires},
  note   = {The gate already argues that a reader who greps for a failing check's name must find
            its arms beside it, and applies that to the transcript --- the ephemeral half ---
            while failed_detail reaches stderr only. Measured on the gate's own last refusal:
