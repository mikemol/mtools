  note   = {linux-sources sharpened the furniture rule: their probe prints SIX and they read past
            it six consecutive ticks, so the operative property is CONSTANT, not ZERO. A third
            position was measured here: the inbox arm reported their letter correctly and by name,
            and the reader's own STEP 0 pipeline excluded it --- the notice is line 44 of 91, the
            window opened at line 74. The truncating pipeline existed nowhere in the tree, so
            nothing could gate it. The poll now repeats its unread count last, where every
            trailing window reaches it, and names its own terminus so truncation is detected
            rather than read as quiet.},
  check  = {pytest hooks/tests/test_bar_fires.py -k test_the_poll_repeats_its_unread_count_where_a_trailing_window_reaches_it},
}

