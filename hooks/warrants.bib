% warrants.bib — one claim PER TEST CASE in the hooks suite.
%
% The claim text is TRANSCRIBED from each test function's own docstring, whose flagged
% paragraphs already argue the defect the case prevents.  Where a docstring is a bare
% one-liner the claim is correspondingly plain; that thinness is a fact about the case
% rather than something invented over.
%
% Keying convention: hooks-<module>-<test name minus its `test_` prefix, hyphenated,
% with leading articles dropped>.  Each check runs that one test function.
%
% Section keys are the source module: one section per tests/test_*.py.

% ---------------------------------------------------------------- payload

@misc{hooks-payload-mapping-rebuilt-with-string-keys,
  section = {payload},
  claim   = {A record's keys become strings and its values survive},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_payload.py -k test_a_mapping_is_rebuilt_with_string_keys}
}

@misc{hooks-payload-non-mapping-is-empty-record,
  section = {payload},
  claim   = {EVERY non-mapping shape reads as an empty record --- not just null, but text, integers, lists and tuples --- because the payload is UNTRUSTED JSON},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_payload.py -k test_a_non_mapping_is_an_empty_record}
}

@misc{hooks-payload-string-reads-as-itself,
  section = {payload},
  claim   = {Text passes through unchanged},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_payload.py -k test_a_string_reads_as_itself}
}

@misc{hooks-payload-non-string-reads-as-empty,
  section = {payload},
  claim   = {A non-string field yields EMPTY TEXT rather than a repr of the value},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_payload.py -k test_a_non_string_reads_as_empty}
}

@misc{hooks-payload-own-switch-arms,
  section = {payload},
  claim   = {The hook's own switch set to the exact arming value arms it},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_payload.py -k test_the_own_switch_arms}
}

@misc{hooks-payload-own-switch-wins-over-shared,
  section = {payload},
  claim   = {An explicit zero on the hook's OWN switch DISARMS it even while the shared switch is on --- set-to-zero is a DECISION, not an absence. Otherwise a repo cannot opt one hook out of a fleet-wide arming, and the only way to quiet one is to disarm all of them},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_payload.py -k test_the_own_switch_wins_over_the_shared_one}
}

@misc{hooks-payload-shared-switch-arms-when-own-unset,
  section = {payload},
  claim   = {With no own switch set, the SHARED switch decides},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_payload.py -k test_the_shared_switch_arms_when_the_own_one_is_unset}
}

@misc{hooks-payload-neither-switch-is-disarmed,
  section = {payload},
  claim   = {With neither switch set the default is ADVISORY, asserted rather than assumed --- the positive control for the whole arming surface. Without this case every other arming case would pass against a function that returned armed UNCONDITIONALLY. That is the load-bearing shape of this whole module: a hook that reports itself armed while exiting zero detects every violation and refuses none, reading as armed in review and off in fact, which is strictly worse than being visibly disabled},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_payload.py -k test_neither_switch_is_disarmed}
}

@misc{hooks-payload-only-exact-value-arms,
  section = {payload},
  claim   = {ONLY the one exact spelling arms the hook: empty, zero, true, yes and two all leave it advisory. This is worth PINNING rather than discovering --- an operator who writes the block switch as true gets an ADVISORY hook. The behaviour is deliberate, one spelling and no truthiness table, and a test is the only place a reader learns it before an unrefused violation does},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_payload.py -k test_only_the_exact_value_arms}
}

% ---------------------------------------------------------------- checkers

@misc{hooks-checkers-both-are-registered,
  section = {checkers},
  claim   = {The checker roster is EXACTLY ruff then mypy, asserted so a checker cannot silently drop out of the gate. A hook that ran one of two would report clean on a file the missing one refuses --- the same armed-and-checking-nothing shape the arming switch guards against, one layer in},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_checkers.py -k test_both_checkers_are_registered}
}

@misc{hooks-checkers-ruff-told-authors-real-path,
  section = {checkers},
  claim   = {The stdin-filename flag and the author's REAL path travel together in ruff's argv. The defect this prevents is silent: the hook checks a TEMPFILE, so without the flag every path-keyed setting an adopting repo writes --- per-file-ignores, exclude --- resolves against a random temp name and matches nothing. The gate and a direct ruff run then disagree about the same file ALWAYS, silently, in the direction that manufactures findings the author cannot act on. Nothing about that is visible in a passing run},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_checkers.py -k test_ruff_is_told_the_authors_real_path}
}

@misc{hooks-checkers-ruff-falls-back-to-tempfile,
  section = {checkers},
  claim   = {An unknown subject names the TEMPFILE rather than an empty string. An empty stdin-filename is not the same as no subject: ruff would resolve config against the empty pattern, which matches nothing and reads exactly like the path-keyed defect above},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_checkers.py -k test_ruff_falls_back_to_the_tempfile_when_no_path_is_known}
}

@misc{hooks-checkers-ruff-reads-stdin-mypy-does-not,
  section = {checkers},
  claim   = {Each checker DECLARES how it takes the staged content, and the declaration is what keeps the caller from having to know which is which. Getting it backwards hands ruff an unread path, or hands mypy content it never receives},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_checkers.py -k test_ruff_reads_stdin_and_mypy_does_not}
}

@misc{hooks-checkers-mypy-given-tempfile-as-subject,
  section = {checkers},
  claim   = {The staged copy is NAMED in mypy's argv, since mypy takes a real path rather than stdin},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_checkers.py -k test_mypy_is_given_the_tempfile_as_its_subject}
}

@misc{hooks-checkers-mypy-renders-the-source-line,
  section = {checkers},
  claim   = {Mypy is asked to render the SOURCE LINE, and that is pinned for a measured reason rather than for taste. Without it mypy cites a line number in a file deleted microseconds later that never existed on disk --- a citation with no readable referent, guessed at six times on one file and wrong every time. It is the whole difference between an actionable finding and a bare number pointing into a file that no longer exists},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_checkers.py -k test_mypy_renders_the_source_line}
}

@misc{hooks-checkers-both-pointed-at-projects-config,
  section = {checkers},
  claim   = {Each checker resolves rules from the EDITED FILE'S project, and each spells the config flag differently. The config follows the edited file: a hook naming its OWN project would apply one repo's bar to another's code --- invisible while a session edits one tree, wrong in BOTH DIRECTIONS the moment it edits two},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_checkers.py -k test_both_checkers_are_pointed_at_the_projects_config}
}

@misc{hooks-checkers-both-run-under-projects-interpreter,
  section = {checkers},
  claim   = {Each argv invokes the PROJECT VENV'S python as a module, not whatever interpreter happens to be on PATH},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_checkers.py -k test_both_checkers_run_under_the_projects_interpreter}
}

@misc{hooks-checkers-ruff-does-not-cache,
  section = {checkers},
  claim   = {Caching is OFF. A cache keyed on a tempfile path never hits and never expires: each staged edit gets a fresh random name, so entries accumulate without ever serving a read --- cost with no benefit, on a hook that runs at EVERY edit},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_checkers.py -k test_ruff_does_not_cache}
}

% ---------------------------------------------------------------- cmdparse

@misc{hooks-cmdparse-bare-command-names-its-program,
  section = {cmdparse},
  claim   = {The base case, without which every wrapper case is unanchored},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_cmdparse.py -k test_a_bare_command_names_its_program}
}

@misc{hooks-cmdparse-wrapper-does-not-hide-the-program,
  section = {cmdparse},
  claim   = {A wrapper DELEGATES, so finding one means keep looking. EVERY ENTRY IN THIS FAMILY WAS A LIVE BYPASS SHAPE, not a hypothetical, and each is labelled so a failure reports which wrapper stopped being transparent rather than an opaque index},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_cmdparse.py -k test_a_wrapper_does_not_hide_the_program}
}

@misc{hooks-cmdparse-arguments-belong-to-the-real-program,
  section = {cmdparse},
  claim   = {The arguments reported belong to the real program rather than to the wrapper. A FIRST DRAFT SKIPPED THE WRAPPER AND REPORTED 180 AS THE PROGRAM --- naming the right program is only half of it, because a verdict is rendered over the ARGUMENTS, so a caller handed the wrapper's operands examines the wrong words},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_cmdparse.py -k test_the_arguments_belong_to_the_real_program}
}

@misc{hooks-cmdparse-every-command-in-a-chain-is-seen,
  section = {cmdparse},
  claim   = {Every command in a chain is seen, not just the first --- the question is whether a tool appears ANYWHERE in command position},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_cmdparse.py -k test_every_command_in_a_chain_is_seen}
}

@misc{hooks-cmdparse-pipe-and-stderr-operator-is-one-token,
  section = {cmdparse},
  claim   = {The |& operator reads as ONE token rather than as a pipe followed by a background ampersand},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_cmdparse.py -k test_the_pipe_and_stderr_operator_is_one_token}
}

@misc{hooks-cmdparse-pipe-and-stderr-does-not-hide-the-program,
  section = {cmdparse},
  claim   = {A command after a |& operator is still seen in command position},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_cmdparse.py -k test_the_pipe_and_stderr_operator_does_not_hide_the_program}
}

@misc{hooks-cmdparse-pipe-and-stderr-delimits-exactly-once,
  section = {cmdparse},
  claim   = {The |& operator delimits exactly once, so neither an empty command nor a doubled split is produced},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_cmdparse.py -k test_the_pipe_and_stderr_operator_delimits_exactly_once}
}

@misc{hooks-cmdparse-quoted-operator-is-data,
  section = {cmdparse},
  claim   = {A quoted operator is DATA and not a delimiter --- a shell metacharacter inside quotes does not split a command, and treating it as one would invent commands the user never wrote},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_cmdparse.py -k test_a_quoted_operator_is_data_and_not_a_delimiter}
}

@misc{hooks-cmdparse-unparseable-yields-nothing,
  section = {cmdparse},
  claim   = {An unparseable command yields nothing rather than raising. A PreToolUse hook that raises on malformed shell fails the user's turn over a command they merely mistyped},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_cmdparse.py -k test_an_unparseable_command_yields_nothing_rather_than_raising}
}

@misc{hooks-cmdparse-empty-command-yields-no-programs,
  section = {cmdparse},
  claim   = {An empty command yields no programs},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_cmdparse.py -k test_an_empty_command_yields_no_programs}
}

@misc{hooks-cmdparse-only-a-wrapper-names-no-program,
  section = {cmdparse},
  claim   = {A command that is ONLY a wrapper names no program, rather than naming the wrapper itself},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_cmdparse.py -k test_a_command_that_is_only_a_wrapper_names_no_program}
}

@misc{hooks-cmdparse-flag-argument-does-not-become-the-program,
  section = {cmdparse},
  claim   = {A wrapper flag's SEPARATE ARGUMENT is not read as the program. This was a LIVE BYPASS of the same class this module exists to close, one flag-shape deeper --- measured at four of eight shapes, where `env -u LD_PRELOAD grep` reported LD_PRELOAD, `sudo -u nobody grep` reported nobody, `timeout -s KILL 5 grep` reported KILL and `env -C /tmp grep` reported tmp, so a hook gating on programs() was OPEN for every one and the real command was never seen. `_is_operand` is deliberately NOT widened to cover them: a flag's argument can be ANY string, which is value-shaped and would defeat its conservative cannot-name-a-program test, reopening the wrapper bypass to buy this one. The arg-taking flags are ENUMERABLE per wrapper; the strings they carry are not. The non-numeric argument shapes in this family are deliberate --- with `nice -n 10` and `xargs -n 1` the parser passes ACCIDENTALLY because _is_operand eats a numeric token, so those cases would go green against a parser modelling no flag arguments at all, and a test encoding an accident as an assertion is worse than no test},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_cmdparse.py -k test_a_wrapper_flag_argument_does_not_become_the_program}
}

@misc{hooks-cmdparse-attached-flag-value-not-consumed-twice,
  section = {cmdparse},
  claim   = {An ATTACHED flag value is not consumed twice. `-C/tmp` and `--chdir=/tmp` carry their value in the SAME token, so a parser consuming a following word for these too would swallow the real program --- turning a bypass into a blindness, which is the failure the separated-form fix could otherwise have introduced},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_cmdparse.py -k test_an_attached_flag_value_is_not_consumed_twice}
}

@misc{hooks-cmdparse-flag-argument-at-the-end-does-not-overrun,
  section = {cmdparse},
  claim   = {A trailing arg-taking flag with nothing after it does not index past the words. `env -u` with no argument is malformed shell, but a parser assuming a following word exists raises IndexError inside a PreToolUse hook --- failing the turn on a command the user merely mistyped},
  check   = {cmd:.venv/bin/python3 -m pytest tests/test_cmdparse.py -k test_a_flag_argument_at_the_end_does_not_overrun}
}
