@misc{hooks-bar-fires-the-vacuity-sweep-resolves-an-inline-path-read,
  title  = {A ceiling of four over a population of twenty-three},
  author = {Mike Mol},
  year   = {2026},
  section = {bar-fires},
  note   = {The vacuity sweep skips any test whose file-read receiver is not a mapped name, and
            said so nowhere --- a quiet continue, the same mechanism by which it once skipped
            every multi-file test. The poll counted the skipped population with a regex matching
            one syntactic form and reported four; the sweep's own predicate measures twenty-three.
            A correct-looking figure over a mis-named population, produced by the instrument built
            to refuse exactly that, and caught only because the new assertion fired on the real
            count rather than on the regex's. The population is clean: resolving every skipped
            test's path against the module's own constants and running the sweep's predicate by
            hand finds zero vacuous, so this is a coverage ceiling rather than tolerated debt. The
            poll now reads the ceiling from the sweep rather than deriving it a second, weaker
            way, because two instruments computing one figure two ways is how they disagree
            without either noticing. The arm itself first passed before its subject existed,
            reading its own docstring; it now reads the parsed function body with the docstring
            node dropped.},
  check  = {pytest hooks/tests/test_bar_fires.py -k test_the_vacuity_sweep_resolves_an_inline_path_read},
}

@misc{hooks-bar-fires-every-warrant-count-in-the-harness-is-anchored,
