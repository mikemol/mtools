@misc{hooks-bar-fires-a-module-with-no-local-caller-declares-who-consumes-it,
  title  = {An import count of zero is not evidence of disuse},
  author = {Mike Mol},
  year   = {2026},
  section = {bar-fires},
  note   = {Asking which modules have a caller found checker_context and project_root imported by
            no production source and no test in this repository. Two independent readers, regex
            and AST, agreed --- and both were right. A fleet sweep inverted the reading: each has
            eight importers across substrate, paperkit and summit, making them the most
            cross-repo-reused code in the distribution and the most clearly earned under the
            operator's membership criterion. The first fleet reader failed its own control and
            reported zero, because it required the module name inside a dotted path while the
            real shape puts it after import; that negative was a statement about the reader.
            Measured by hash, the peers import their own byte-different copies while this
            repository's are strictly ahead and unread, so the interning mtools exists to perform
            has not happened for its two most-reused modules. The divergence is not repaired
            here, because those trees belong to their owners; the arm holds only that a module
            with no local caller must say who consumes it, so the next reader does not read
            unused off an import count and delete it.},
  check  = {pytest hooks/tests/test_bar_fires.py -k test_a_module_with_no_local_caller_declares_who_consumes_it},
}

@misc{hooks-adoption-both-distributions-co-install-under-one-namespace,
  title  = {An assertion that passes when a distribution ships nothing is measuring the cwd},
  author = {Mike Mol},
  year   = {2026},
  section = {adoption},
  note   = {Both distributions omit an __init__ under src/mikemol so they can share the prefix,
            and nothing in this repository exercised that claim: every case installs one
            distribution. substrate carries an editable install of mikemol-mdstruct and resolves
            the namespace, so a peer already consumes this repo by package with exactly one
            sibling present --- the half that cannot fail. Four F-arms failed before the
            assertion was earned. A planted src/mikemol/__init__.py does not shadow, because the
            namespace-packages declaration excludes it from the built distribution; an explicit
            regular-package declaration does not shadow either, because the second install writes
            into the same site-packages directory. The fourth failure was the instrument: scoping
            the subpackage out entirely still imported, because the probe ran with the source
            tree reachable on sys.path and never consulted the installed distributions. With cwd
            set to the probe venv both editable and wheel installs go red, so that condition is
            passed explicitly rather than inherited from wherever pytest runs.},
  check  = {pytest hooks/tests/test_adoption.py -k test_both_distributions_co_install_under_one_namespace},
}

