@misc{hooks-bar-fires-asserted-comparisons-print-both-operands,
  section = {bar-fires},
  title  = {A gate that asserts an expression must print that expression's components},
  claim  = {The poll's roster arm asserted that the count of accounted surveyors was at least the
            gap between the roster and the legs in HEAD, and printed only the first of those two
            numbers. A reader therefore received a verdict with one operand invisible and no way
            to check the comparison that produced it. That is how the arm's population error
            survived: the count was of lines carrying a substring over a text range that included
            every paragraph explaining the mark, so it read thirteen against a roster of eight and
            then eleven after unrelated prose edits, and both figures passed the comparison. A
            count that moves when prose is edited is not counting surveyors, and one printed
            operand could not reveal that while the other stayed hidden. Printing every component
            of an asserted expression makes the line a proof-carrying artifact, or a
            disproof-carrying one, which is the half that earns it: a reader can falsify the claim
            from the line alone without re-deriving anything or trusting the deriver, where an
            asserted verdict with hidden operands can only be believed or doubted. The arm asserts
            the shape rather than the single call site, so a future branch added with a hidden
            operand fails at the point of writing rather than three ticks later when its figure
            happens to be absurd on its face. Twice since, the arm has gone red on changes that
            strengthened its subject, and each time the arm was the thing at fault. First it named
            the left operand as a literal, so a correct rename broke it — an arm that names a
            variable cannot outlive the variable, and it was asserting an identifier where the rule
            is about a relation; it now derives both operand names from the comparison itself.
            Second, it took the first comparison and checked it against the first verdict line,
            which was correct while the poll held exactly one of each. A second verdict then landed
            — a census whose reader-side prefixes match nothing can still be adjudicated by its own
            declared states — and the arm compared the new branch's operands against the old
            branch's line, reporting a hidden operand where both lines were complete. That is this
            arm committing the defect it measures, one level up: taking the first of something names
            a population of one and says so nowhere, so a poll with two comparisons is read as a
            poll with one, and the resulting count is arithmetically fine and about the wrong thing.
            Each comparison is now paired with the verdict it guards by scanning forward from the
            condition rather than by index, and the number of comparisons read is required to equal
            the number present, so a regex that stopped matching cannot report zero failures
            vacuously.},
  check  = {cmd:.venv/bin/python3 -m pytest tests/test_bar_fires.py -k test_asserted_comparisons_print_both_operands},
}

@misc{hooks-bar-fires-roster-mark-is-read-from-a-cell-not-a-substring,
  section = {bar-fires},
  title  = {Count the mark in a table cell, never the string in a section},
  claim  = {The roster arm counted the filed-elsewhere mark with a case-insensitive line count over
            a stream-edited range and reported the result as a number of surveyors. It counted
            neither surveyors nor rows but lines carrying a substring, over a range that included
            the prose explaining the mark, so the vfs census read eleven against a roster of eight
            while that file's own filing-status section documented walking into the same trap twice
            in the course of writing the paragraph about it. A table used as an instrument accretes
            mentions of its own trigger, which the markdown table reader records at its own site and
            carries in the row filter's docstring: a substring filter asks whether any cell mentions
            a term, a prefix filter asks whether one column declares it. The right instrument
            existed and its documentation was written about this exact failure. Four parties reached
            the same repair independently from different corpora, one of them a conduit census that
            scored ten of nineteen rows on prose in comments and string literals and repaired it by
            reaching the read through a call node rather than a text match. The prefix predicate
            also discovered what the substring could not: the mark's wording is not uniform across
            censuses, one phrasing placing it inside a parenthetical, and a substring search cannot
            discover that its term has dialects because every dialect satisfies it. The poll now
            reports that case as unadjudicated rather than absorbing it, because a reader that
            cannot settle a question must say so rather than report a finding about itself.},
  check  = {cmd:.venv/bin/python3 -m pytest tests/test_bar_fires.py -k test_roster_mark_is_read_from_a_cell_not_a_substring},
}

@misc{hooks-bar-fires-roster-gap-compared-against-every-state,
  section = {bar-fires},
  title  = {A gap is not made of one state},
  claim  = {The poll's roster arm computed the gap as every rostered party lacking a leg in the
            census's own directory, then compared that gap against the count of parties marked as
            having filed elsewhere. Those are different populations. The gap includes parties that
            have not filed anywhere: a surveyor who accepted and has not yet written is pending, and
            one who declined with a measured reason is terminal, and neither is a dropped row.
            Measured on the paperkit-use census: roster eight, legs in the directory zero, gap
            eight, and the states present were four filed elsewhere, two accepted, one scoped
            decline and one not yet filed, summing to exactly eight. Every rostered party carried a
            state explaining its absence and the arm reported the one shape it exists to catch. The
            precedent for the repair is the same arm's own unadjudicated branch one axis over:
            calling a census this reader cannot parse a dropped row reports the reader, and calling
            a party that has not filed anywhere a dropped row reports the calendar. The states
            cannot be probed naively because the mark's own spelling is a prefix of another state's,
            so a summed probe double-counts; measured, a prefix query for the shorter spelling
            returns fourteen against a twelve-row table. Reported by a peer who cross-tabulated
            every census in this tree that rosters them against what their own repository holds,
            found one disagreeing row out of seven adjudicable, and handed over the row rather than
            a claim about the table, without touching the instrument.},
  check  = {cmd:.venv/bin/python3 -m pytest tests/test_bar_fires.py -k test_the_roster_gap_is_compared_against_every_state_not_only_the_mark},
}

@misc{hooks-no-verify-every-gate-bypass-shape-is-refused,
  section = {no_verify},
  title  = {Each refused shape is a route around the gate, not a variant of one string},
  claim  = {The operator's policy is never to bypass the pre-commit gate, and the shapes that bypass it
            are not spellings of a single flag. The long flag names it; its short form reaches the
            same code path; git accepts any unambiguous prefix of a long option, so shorter
            abbreviations reach it too; and pointing the hooks path at an empty or absent directory
            disarms every hook at once without naming the flag at all. A guard enumerating only the
            flag would leave the configuration route open, which is the same defect as a checker
            whose population is a hand-written list rather than a predicate. The abbreviation case
            is handled as a property, is this token a prefix of the long option long enough to be
            unambiguous, rather than as membership in a set of three spellings that would pass the
            fourth.},
  check  = {cmd:.venv/bin/python3 -m pytest tests/test_no_verify.py -k test_every_gate_bypass_shape_is_refused},
}

@misc{hooks-no-verify-ordinary-commands-are-not-refused,
  section = {no_verify},
  title  = {The arm that makes the deny arm mean something},
  claim  = {A hook that refused every command would satisfy every deny arm in its own suite and be
