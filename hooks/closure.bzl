"""Dependency labels for hooks' per-module libraries, read from the generated import graph (W1988).

A BUILD file cannot define functions, so the two small ones the test comprehension needs live here.
`dag.bzl` is generated by `importdag.graph` and kept equal to the sources by `//hooks:graph_fresh`;
this file only turns one of its entries into labels.
"""

def lib(path):
    """Name the per-module library for a module path of the graph.

    Args:
      path: a dist-relative module path such as `src/mikemol/hooks/round_wire.py`.

    Returns:
      the label `:mod_<module>`, a nested package's slashes written `__`.
    """
    return ":mod_" + path.removeprefix("src/mikemol/hooks/").removesuffix(".py").replace("/", "__")

def deps_of(entry):
    """List the libraries an entry of the graph needs at run time.

    Args:
      entry: a module, test or support entry of `GRAPH`.

    Returns:
      the labels of its imports, the typing-only ones left out: they are needed to check types and
      never to run, and two modules naming each other that way would be a cycle bazel refuses.
    """
    return [lib(dep) for dep in entry["imports"] if dep not in entry["typing_only"]]

def test_deps(graph, entry):
    """List the libraries one test needs: its own imports and its conftest's, each once.

    Args:
      graph: the `GRAPH` document.
      entry: the test's entry of `GRAPH["tests"]`.

    Returns:
      the sorted labels, with no duplicate: a test that imports what its conftest imports (hosttied
      tests its own module) names it once, since bazel refuses a duplicated dep.
    """
    seen = {}
    for label in deps_of(entry) + support_deps(graph):
        seen[label] = True
    return sorted(seen)

def support_deps(graph):
    """List the libraries every test needs because its conftest imports them.

    Args:
      graph: the `GRAPH` document.

    Returns:
      the labels `deps_of` gives for each entry of the `support` section.
    """
    return [dep for entry in graph["support"].values() for dep in deps_of(entry)]
