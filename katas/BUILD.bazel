# ⚑ MIRRORS //procrun and //atomicwrite TARGET FOR TARGET: this is a LIBRARY, standard library only
# for now. The rationale for each shape lives in //pkgbuild. `@katas_dev` is declared in
# MODULE.bazel beside this distribution's birth (mtools:W872).
load("@katas_dev//:requirements.bzl", dev_all_requirements = "all_requirements", dev_requirement = "requirement")
load("@mikemol_rules_py//:dist.bzl", "dist_checks")
load("@mikemol_rules_py//:venv.bzl", "venv_from_hub")
load("@rules_python//python:defs.bzl", "py_binary", "py_library", "py_test")

exports_files([
    # ⚑ EXPORTED FOR `//hooks:test_bar_fires`, which globs `*/pyproject.toml` for the population.
    "pyproject.toml",
    "requirements.txt",
    "requirements-dev.txt",
    "uv.lock",
])

# ⚑ SIBLINGS = the distributions this one imports (mtools:W874: `mikemol-procrun`, the process seam).
# Bazel carries the edge as a py_library dep, the pip hubs stay independent of it, and the pyproject
# declares it for uv; kept in step by hand (mtools:W562, the treeio and ratchet precedent).
SIBLINGS = [
    "//procrun:procrun",
]

# ⚑ THE TEST MODULES THAT BUILD REAL GIT REPOSITORIES: each needs the `git` binary from the sandbox
# PATH, an undeclared host tool made visible and filterable by the tag below (ratchet's precedent).
_NEEDS_GIT = ["tests/test_fleet.py", "tests/test_survey.py", "tests/test_pulse.py"]

py_library(
    name = "katas",
    srcs = glob(["src/mikemol/katas/**/*.py"]),
    data = glob(["src/mikemol/katas/py.typed"], allow_empty = True),
    imports = ["src"],
    visibility = ["//visibility:public"],
    deps = SIBLINGS,
)

# ⚑⚑⚑ ONE TARGET PER TEST MODULE, AND EACH IS A WITNESS.
[
    py_test(
        name = src.removeprefix("tests/").removesuffix(".py"),
        srcs = [src, "@mikemol_rules_py//:pytest_main.py"] + glob(["tests/conftest.py"], allow_empty = True),
        main = "@mikemol_rules_py//:pytest_main.py",
        args = [
            "$(location " + src + ")",
            "-q",
            "--strict-markers",
            "--strict-config",
            "-o",
            "faulthandler_timeout=60",
            "-c",
            "$(location pyproject.toml)",
        ],
        data = ["pyproject.toml"],
        size = "small",
        deps = [
            ":katas",
            dev_requirement("pytest"),
            dev_requirement("mypy"),
        ] + SIBLINGS,
        imports = ["src"],
        # ⚑ Two source roots plus legacy implicit `__init__.py` files would turn `mikemol` into a
        # regular package from the first root and shadow the namespace (W566).
        legacy_create_init = 0,
        # ⚑ `test_fleet` NEEDS AN UNDECLARED HOST TOOL: `git`, from the sandbox PATH. It builds its
        # own repositories in tmp_path, so the workspace `.git` is NOT needed, only the binary. The
        # tag makes that dependency visible and filterable rather than ambient (ratchet's precedent).
        tags = ["requires-git"] if src in _NEEDS_GIT else [],
    )
    for src in glob(["tests/test_*.py"])
]

exports_files(["BUILD.bazel"])

sh_test(
    name = "ruff",
    srcs = ["@mikemol_check_ruff//:ruff_check.sh"],
    args = [
        "$(location @mikemol_check_ruff//:bin)",
        "$(location :pyproject.toml)",
    ] + ["$(location " + f + ")" for f in glob(["src/**/*.py", "tests/**/*.py"])],
    data = [
        "pyproject.toml",
        "@mikemol_check_ruff//:bin",
    ] + glob(["src/**/*.py", "tests/**/*.py"]),
    size = "small",
)

# ⚑ THE BASELINE IS MINTED EMPTY: the distribution enters clean under preview, so the ratchet
# can only hold it there.
sh_test(
    name = "ratchet",
    srcs = ["@mikemol_check_ratchet//:ratchet_check.sh"],
    args = [
        "$(location //ratchet:ratchet_cli)",
        "$(location @mikemol_check_ruff//:bin)",
        "$(location :pyproject.toml)",
    ],
    data = [
        "pyproject.toml",
        "ratchet-preview.txt",
        "//ratchet:ratchet_cli",
        "@mikemol_check_ruff//:bin",
    ] + glob(["src/**/*.py", "tests/**/*.py"]),
    size = "small",
)

sh_test(
    name = "mutants",
    srcs = ["@mikemol_check_mutants//:mutate_check.sh"],
    args = [
        "$(location :pyproject.toml)",
        "$(location @mikemol_check_mutants//:mutate_runner.py)",
    ],
    data = [
        "pyproject.toml",
        # W629: the defect classes this distribution declares, planted one at a time by the runner.
        "mutants.regex",
        ":.venv",
        "//fence:fence",
        "//mutation:mutation",
        "@mikemol_check_mutants//:mutate_runner.py",
    ] + glob(["src/**/*.py", "tests/**/*.py"]),
    size = "medium",
)

py_binary(
    name = "mypy_runner",
    srcs = ["@mikemol_check_mypy//:mypy_runner.py"],
    main = "@mikemol_check_mypy//:mypy_runner.py",
    deps = [
        dev_requirement("mypy"),
        dev_requirement("pytest"),
    ] + SIBLINGS,
)

sh_test(
    name = "mypy",
    srcs = ["@mikemol_check_mypy//:mypy_check.sh"],
    args = [
        "$(location :mypy_runner)",
        "$(location :pyproject.toml)",
    ],
    data = [
        "pyproject.toml",
        ":mypy_runner",
    ] + glob(["src/**/*.py", "tests/**/*.py"], allow_empty = True),
    size = "small",
    # ⚑ A GENEROUS TIMEOUT, NOT A TIGHT ONE (operator, 2026-09-24: "I hate wallclock-sensitive
    # things"). See //transcriptstruct:mypy for the measurement.
    timeout = "long",
)

venv_from_hub(
    name = ".venv",
    # ⚑ A LIBRARY: no console scripts, matching pyproject's absent [project.scripts].
    console_scripts = {},
    hub_requirements = dev_all_requirements,
    python_version = "3.13.13",
    python_version_short = "3.13",
    # ⚑ The dev venv carries the siblings, so the mutation gate imports them.
    srcs = glob(["src/mikemol/katas/**"]) + SIBLINGS,
)

# W376: this distribution's :venv (W342) and :suite (W362), declared together.
dist_checks()
