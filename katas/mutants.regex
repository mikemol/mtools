# The defect classes this distribution DECLARES (mtools:W629), planted one at a time by the
# `:mutants` runner: <module>|<name>|<pattern>|<replacement>|<scope>. A line that stops matching is a
# STALE declaration and fails the grid as UNAPPLIED.

# A dot-named directory is never a workstream: dropping the filter lists scratch checkouts.
src/mikemol/katas/workstreams.py|dot-directories-listed|if not name\.startswith\("\."\)|if True|def=repos

# The names are returned sorted: dropping the sort leaves them in filesystem order.
src/mikemol/katas/workstreams.py|names-not-sorted|return sorted\(name for|return list(name for|def=repos

# An empty body adds no `--body`: dropping the guard passes an empty argument to mikemol-commit.
src/mikemol/katas/commits.py|empty-body-passed|if request\.body:|if True:|def=commit_argv

# A log with no `rc=` line is RUNNING: reading it as done would call an in-flight commit finished.
src/mikemol/katas/commits.py|running-read-as-done|return RUNNING|return DONE|def=commit_state

# A non-zero rc is a failure naming the status: reading every rc as done hides a refused commit.
src/mikemol/katas/commits.py|failure-read-as-done|int\(match\[1\]\) == 0|int(match[1]) >= 0|def=commit_state

# A missing log is no commit at all: dropping the guard raises on a repo that never committed.
src/mikemol/katas/commits.py|missing-log-not-guarded|if not log\.exists\(\):|if False:|def=commit_state

# W874: the detached commit's body. A timeout is recorded with 124, the status mikemol-commit uses.
src/mikemol/katas/waiter.py|timeout-not-recorded-as-124|status, body = TIMED_OUT, |status, body = 1, |def=run

# The cleanup removes its paths whatever the result: skipping it leaves a stale index.lock behind.
src/mikemol/katas/waiter.py|removals-not-removed|path\.unlink\(missing_ok=True\)|pass|def=run

# The log ends with the child's own status: a constant rc hides a failed commit.
src/mikemol/katas/waiter.py|rc-line-constant|rc=\{status\}|rc=0|def=run

# A `--rm` with no path after it is the command's own word, not a pair.
src/mikemol/katas/waiter.py|lone-rm-taken-as-a-pair|len\(rest\) >= _PAIR|len(rest) >= 1|def=split_removals

# A started run empties its log first, so a stale rc line cannot read as this run's outcome.
src/mikemol/katas/detach.py|stale-log-kept|log\.write_text\("", encoding="utf-8"\)|pass|def=start

# W875: the fleet. A queue pending is the queue files only; an inbox letter must not make a flush.
src/mikemol/katas/fleet.py|queue-pending-includes-inbox|\*QUEUE_PATHS\)\.strip\(\)\)|*QUEUE_PATHS, "inbox").strip())|def=queue_pending

# A commit in flight (an index lock) is never a flush target.
src/mikemol/katas/fleet.py|flush-ignores-the-index-lock|and not in_flight\(fleet, repo\)|and True|def=flush_targets

# Our own running detached commit is never started twice.
src/mikemol/katas/fleet.py|flush-ignores-a-running-commit|!= commits\.RUNNING|!= "never"|def=flush_targets

# The host's skip list is honoured.
src/mikemol/katas/fleet.py|flush-ignores-the-skip-list|if repo not in fleet\.skip_flush|if True|def=flush_targets

# The probe holds the real index locked while the hook runs, as a real commit does.
src/mikemol/katas/fleet.py|probe-does-not-hold-the-lock|held\.touch\(\)|pass|def=probe

# The probe cleans up its temp index and the lock it held, whatever the hook did.
src/mikemol/katas/fleet.py|probe-leaves-its-cleanup|, \[temp, held\]\)|, [])|def=probe

# Flush asks mikemol-commit for the `none` waypoint and the sync subject.
src/mikemol/katas/fleet.py|flush-wrong-waypoint|commits\.Request\(repo, "none", SYNC_SUBJECT\)|commits.Request(repo, "W0", SYNC_SUBJECT)|def=flush

# W876: archive never overwrites, cuts a name to its leaf, and reports what was not there.
src/mikemol/katas/inbox.py|archive-overwrites|elif target\.exists\(\):|elif False:|def=archive
src/mikemol/katas/inbox.py|archive-follows-a-path|leaf = Path\(name\)\.name|leaf = name|def=archive
src/mikemol/katas/inbox.py|archive-hides-the-missing|missing\.append\(leaf\)|pass|def=archive

# W876: the hook survey ignores comments and honours core.hooksPath.
src/mikemol/katas/survey.py|survey-counts-comments|and not line\.lstrip\(\)\.startswith\("#"\)||def=bazel_lines
src/mikemol/katas/survey.py|survey-ignores-hooks-path|configured or _DEFAULT_HOOKS|_DEFAULT_HOOKS|def=hook_row

# W876: scaffold never overwrites, fills the repo name, and swaps the hook only on a pass.
src/mikemol/katas/scaffold.py|scaffold-overwrites|if path\.exists\(\):|if False:|def=scaffold
src/mikemol/katas/scaffold.py|template-keeps-its-placeholder|\.replace\(PLACEHOLDER, repo\)||def=render
src/mikemol/katas/scaffold.py|hook-swapped-without-a-pass|if not target_passed:|if False:|def=install_hook
