% warrants.bib — one claim PER TEST CASE in the transcriptstruct suite.
%
% The claim text is TRANSCRIBED from each test function's own docstring, whose flagged
% paragraphs already argue the defect the case prevents.  Where a docstring is a bare
% one-liner the claim is correspondingly plain; that thinness is a fact about the case
% rather than something invented over.
%
% Keying convention: transcriptstruct-<section>-<test name minus its `test_` prefix, hyphenated,
% with leading articles dropped>.  Each check runs that one test function.


@misc{transcriptstruct-records-shape1-a-queued-command-with-null-message-is-an-attachment-record,
  section = {records},
  title  = {Shape 1: an attachment with `message: null` decodes, and its prompt text is kept},
  claim  = {Shape 1: an attachment with `message: null` decodes, and its prompt text is kept.},
  check  = {cmd:.venv/bin/python3 -m pytest tests/test_records.py -k test_shape1_a_queued_command_with_null_message_is_an_attachment_record},
}

