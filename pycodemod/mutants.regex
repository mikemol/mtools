#
# The defect classes this distribution DECLARES (mtools:W629), planted one at a time by the
# `:mutants` runner: <module>|<name>|<pattern>|<replacement>|<scope>. Each is a mistake a plausible
# edit could make that `body -> raise` cannot express (the def is still called, only its verdict
# moves), and each was FOUND as a hand-planted F-arm when the code beside it landed, so the
# declaration keeps a one-off measurement running. A line that stops matching is a STALE
# declaration and fails the grid as UNAPPLIED.

# W648: an empty census must be able to FAIL under --require-hits; the exit never reading the flag
# reads as a clean empty result.
src/mikemol/pycodemod/cli.py|require-hits-never-fails|return 1 if _flag\(ns, "require_hits"\) else 0|return 0|def=_run_mode

# W658: the caller's --exclude must reach the walk; an empty list passed instead prunes nothing.
src/mikemol/pycodemod/cli.py|exclude-dropped-at-the-walk|exclude=_opt_str_list\(ns, "exclude"\)|exclude=[]|def=_expand_operands

# W656: a registration excuses the def it names by POSITION; excusing every def whenever any
# registration exists hides the dead ones the prefix must not hide.
src/mikemol/pycodemod/dead.py|registered-excuses-every-def|registered=\(site\.path, site\.line\) in registered|registered=bool(registered)|def=dead

# W653: `import pkg.lib` binds the dotted spelling; without it a caller writing `pkg.lib._x` is never
# listed as owed an edit and its import breaks silently after a split.
src/mikemol/pycodemod/split.py|dotted-import-not-bound|if not al\.asname and|if False and|def=_aliases

# W653: an alias rebound to another name (`M = L`) is followed to a fixpoint; a loop that never runs
# misses `M._hidden`, and the first import form still reads fine.
src/mikemol/pycodemod/split.py|alias-rebinding-not-followed|while grew:|while False:|def=_aliases

# W656: only a def a string literal INVOKES is registered; reporting every prefixed def as registered
# hides the orphan the prefix must not hide.
src/mikemol/pycodemod/cli_modes.py|every-prefixed-def-registered|if row\.registered|if True|def=registered_sites

# W667: the two vocabularies are different questions; swapped, FAILURE and SUCCESS read each other's.
src/mikemol/pycodemod/cli.py|artifact-vocabularies-swapped|_opt_str\(ns, "failure"\), _opt_str\(ns, "success"\)|_opt_str(ns, "success"), _opt_str(ns, "failure")|def=_handle_artifacts

# W668: a function is looked up in one file; the rule never firing reads the first path and ignores
# the rest without a word.
src/mikemol/pycodemod/cli_modes.py|touches-one-file-rule-never-fires|len\(paths\) != 1|len(paths) > 99|def=print_touches

# W668: the root names are what make `os.path.join(ROOT, "a.py")` resolve; dropped, every join with a
# root part reads unresolved.
src/mikemol/pycodemod/cli_modes.py|touches-root-names-dropped|roots = sorted\(csv\(root_names or ""\)\)|roots: list[str] = []|def=print_touches

# W596: the caller's guard forms must reach the census; dropped, the default (substrate's) tables are
# asked and a repo's own guards read as no guard at all.
src/mikemol/pycodemod/cli.py|placement-overrides-dropped|run_placement\(paths, entry, first_write\)|run_placement(paths)|def=_handle_placement

# W607: the shared structure of two fingerprints is their GCD; the LCM is a larger number that still
# looks like a fingerprint and shares nothing.
src/mikemol/pycodemod/fingerprint.py|shared-is-lcm-not-gcd|math\.gcd\(a, b\)|math.lcm(a, b)|def=fp_shared

# W612: a literal that matched a failure token is excluded from the success pass; inverted, the
# success pass reads only the failure literals and every failure reader also reads as a success one.
src/mikemol/pycodemod/artifacts.py|failure-not-subtracted-from-success|s not in matched|s in matched|def=_classify

# W846: an import inside a function stays inside it, and the function imports what it reads. A
# docstring counts as the first statement only when it is one; a function that imports the package
# itself must import every module it reads (not only the redirected ones); a redirect read in a
# function is imported by the function, not hoisted to the module.
src/mikemol/pycodemod/atomize.py|local-imports-before-the-docstring|return 1 if quoted else 0|return 0|def=_after_docstring
src/mikemol/pycodemod/atomize.py|local-import-reads-ignored|frame\.reads \S frame\.needs if frame\.imports else frame\.needs|frame.needs|def=_Rewriter.leave_FunctionDef
src/mikemol/pycodemod/atomize.py|redirect-in-a-function-hoisted|if self\.frames:|if False:|def=_Rewriter._need
src/mikemol/pycodemod/atomize.py|read-noted-outside-a-function|if self\.frames and head in self\.modules:|if head in self.modules:|def=_Rewriter._read

# W614: a bib is foreign by OWNERSHIP (the nearest enclosing project), never by containment. Owning
# by equality alone makes a child own nothing; ordering owners shallowest-first hands a child's bib
# to its parent; testing for 'no owner' is the containment answer that reports the root's one real
# foreign import as zero; a missing list must default, and a list holding a non-string is malformed.
src/mikemol/pycodemod/projects.py|owner-by-equality-only|resolved == o or resolved\.is_relative_to\(o\)|resolved == o|def=_owner
src/mikemol/pycodemod/projects.py|owners-shallowest-first|return len\(directory\.parts\)|return 0|def=_depth
src/mikemol/pycodemod/projects.py|containment-not-ownership|if owner != directory:|if owner is None:|def=_project
src/mikemol/pycodemod/projects.py|no-list-reads-as-none|return DEFAULT_WARRANTS|return ()|def=_warrants
src/mikemol/pycodemod/projects.py|non-string-token-accepted|len\(tokens\) != len\(listed\)|False|def=_warrants

# W976: judged-fix. A fix run unisolated reads the project's ruff configuration instead of the rules asked
# for; unsafe fixes applied when not asked would corrupt files the judge only catches by luck; a ruff
# that cannot run read as "no change" is a clean bill from a tool that never ran; a selection that is
# not a plain rule list could smuggle an option into ruff.
src/mikemol/pycodemod/cli_judgedfix.py|fix-not-isolated|"--fix", "--isolated", "--quiet"|"--fix", "--quiet"|def=fix_planner
src/mikemol/pycodemod/cli_judgedfix.py|unsafe-always-on|if flags\.unsafe:|if True:|def=fix_planner
src/mikemol/pycodemod/cli_judgedfix.py|unsafe-never-on|if flags\.unsafe:|if False:|def=fix_planner
src/mikemol/pycodemod/cli_judgedfix.py|ruff-failure-reads-as-clean|if code not in JUDGED:|if False:|def=ruff_fix
src/mikemol/pycodemod/cli_judgedfix.py|any-selection-passes|if _RULES\.fullmatch\(select\) is None:|if False:|def=check_select
