% warrants.bib — one claim PER TEST CASE in the pycodemod suite.
%
% The claim text is TRANSCRIBED from each test function's own docstring, whose flagged
% paragraphs already argue the defect the case prevents.  Where a docstring is a bare
% one-liner the claim is correspondingly plain; that thinness is a fact about the case
% rather than something invented over.
%
% Keying convention: pycodemod-<section>-<test name minus its `test_` prefix, hyphenated,
% with leading articles dropped>.  Each check runs that one test function.

@misc{pycodemod-core-double-dash-ends-flag-recognition,
  section = {core},
  title  = {⚑⚑ `--literal -- --selftest` must NOT see `--selftest` as a flag: THE ORIGIN'S DEFECT},
  claim  = { `--literal -- --selftest` must NOT see `--selftest` as a flag: THE ORIGIN'S DEFECT.},
  check  = {cmd:.venv/bin/python3 -m pytest tests/test_core.py -k test_double_dash_ends_flag_recognition},
}

